<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
  <active>true</active>
  <allowRecall>true</allowRecall>
  <allowedSubmitters><type>owner</type></allowedSubmitters>
  <approvalPageFields><field>Name</field><field>Owner</field></approvalPageFields>
  <approvalStep>
    <allowDelegate>false</allowDelegate>
    <assignedApprover><approver><type>adhoc</type></approver><whenMultipleApprovers>FirstResponse</whenMultipleApprovers></assignedApprover>
    <label>Approve</label>
    <name>Approve</name>
  </approvalStep>
  <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
  <entryCriteria><criteriaItems><field>Account.Name</field><operation>startsWith</operation><value>Submilli test</value></criteriaItems></entryCriteria>
  <finalApprovalRecordLock>false</finalApprovalRecordLock>
  <finalRejectionRecordLock>false</finalRejectionRecordLock>
  <label>Submilli Test Approval</label>
  <recordEditability>AdminOnly</recordEditability>
  <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
