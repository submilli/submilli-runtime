>           : ^^^^^^^^^^^^^^^^^
>'x' : "x"
>    : ^^^

globalThis['y'] // should error, no property 'y'
>globalThis['y'] : any
>                : ^^^
>globalThis : typeof globalThis
>           : ^^^^^^^^^^^^^^^^^
>'y' : "y"
>    : ^^^

globalThis['z'] // should error, no property 'z'
>globalThis['z'] : any
>                : ^^^
