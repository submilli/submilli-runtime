>  : ^^^

globalThis.z // should error, no property 'z'
>globalThis.z : any
>             : ^^^
>globalThis : typeof globalThis
>           : ^^^^^^^^^^^^^^^^^
>z : any
>  : ^^^

globalThis['x'] // ok
