=== iterableArrayPattern22.ts ===
let [...a] = { 0: "", 1: true };
>a : any[]
>  : ^^^^^
>{ 0: "", 1: true } : { 0: string; 1: boolean; }
>                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>0 : string
>  : ^^^^^^
>"" : ""
>   : ^^
>1 : boolean
>  : ^^^^^^^
>true : true
>     : ^^^^


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


