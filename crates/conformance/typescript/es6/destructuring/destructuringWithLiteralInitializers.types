=== destructuringWithLiteralInitializers.ts ===
// (arg: { x: any, y: any }) => void
/*pruned*/;
/*pruned*/;

// (arg: { x: any, y?: number }) => void
/*pruned*/;
/*pruned*/;
/*pruned*/;

// (arg: { x?: number, y?: number }) => void
/*pruned*/;
/**/;
/*pruned*/;
/*pruned*/;
/*pruned*/;

// (arg?: { x: number, y: number }) => void
function f4({ x, y } = { x: 0, y: 0 }): void { }
>f4 : ({ x, y }?: { x: number; y: number; }) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>y : number
>  : ^^^^^^
>{ x: 0, y: 0 } : { x: number; y: number; }
>               : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>0 : 0
>  : ^
>y : number
>  : ^^^^^^
>0 : 0
>  : ^

f4();
>f4() : void
>     : ^^^^
>f4 : ({ x, y }?: { x: number; y: number; }) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

f4({ x: 1, y: 1 });
>f4({ x: 1, y: 1 }) : void
>                   : ^^^^
>f4 : ({ x, y }?: { x: number; y: number; }) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ x: 1, y: 1 } : { x: number; y: number; }
>               : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
>y : number
>  : ^^^^^^
>1 : 1
>  : ^


// (arg?: { x: number, y?: number }) => void
function f5({ x, y = 0 } = { x: 0 }): void { }
>f5 : ({ x, y }?: { x: number; y?: number | undefined; }) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>y : number
>  : ^^^^^^
>0 : 0
>  : ^
>{ x: 0 } : { x: number; }
>         : ^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>0 : 0
>  : ^

f5();
>f5() : void
>     : ^^^^
>f5 : ({ x, y }?: { x: number; y?: number | undefined; }) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

f5({ x: 1 });
>f5({ x: 1 }) : void
>             : ^^^^
>f5 : ({ x, y }?: { x: number; y?: number | undefined; }) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ x: 1 } : { x: number; }
>         : ^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^

f5({ x: 1, y: 1 });
>f5({ x: 1, y: 1 }) : void
>                   : ^^^^
>f5 : ({ x, y }?: { x: number; y?: number | undefined; }) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ x: 1, y: 1 } : { x: number; y: number; }
>               : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
>y : number
>  : ^^^^^^
>1 : 1
>  : ^


// (arg?: { x?: number, y?: number }) => void
function f6({ x = 0, y = 0 } = {}): void { }
>f6 : ({ x, y }?: { x?: number | undefined; y?: number | undefined; }) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
