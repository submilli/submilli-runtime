=== iterableArrayPattern21.ts ===
let [a, b] = { 0: "", 1: true };
>a : any
>  : ^^^
>b : any
>  : ^^^
>{ 0: "", 1: true } : { 0: string; 1: boolean; }
>                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>0 : string
>  : ^^^^^^
>"" : ""
>   : ^^
>1 : boolean
>  : ^^^^^^^
>true : true
>     : ^^^^


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


