=== destructuringArrayBindingPatternAndAssignment5SiblingInitializer.ts ===

// To be inferred as `number`
function f1(): void {
>f1 : () => void
>   : ^^^^^^^^^^

    const [a1, b1 = a1] = [1];
>a1 : number
>   : ^^^^^^
>b1 : number
>   : ^^^^^^
>a1 : number
>   : ^^^^^^
>[1] : [number]
>    : ^^^^^^^^
>1 : 1
>  : ^

    const [a2, b2 = 1 + a2] = [1];
>a2 : number
>   : ^^^^^^
>b2 : number
>   : ^^^^^^
>1 + a2 : number
>       : ^^^^^^
>1 : 1
>  : ^
>a2 : number
>   : ^^^^^^
>[1] : [number]
>    : ^^^^^^^^
>1 : 1
>  : ^

}

// To be inferred as `string`
function f2(): void {
>f2 : () => void
>   : ^^^^^^^^^^

    const [a1, b1 = a1] = ['hi'];
>a1 : string
>   : ^^^^^^
>b1 : string
>   : ^^^^^^
>a1 : string
>   : ^^^^^^
>['hi'] : [string]
>       : ^^^^^^^^
>'hi' : "hi"
>     : ^^^^

    const [a2, b2 = a2 + '!'] = ['hi'];
>a2 : string
>   : ^^^^^^
>b2 : string
>   : ^^^^^^
>a2 + '!' : string
>         : ^^^^^^
>a2 : string
>   : ^^^^^^
>'!' : "!"
>    : ^^^
>['hi'] : [string]
>       : ^^^^^^^^
>'hi' : "hi"
>     : ^^^^

}

// To be inferred as `string | number`
function f3(): void {
>f3 : () => void
>   : ^^^^^^^^^^

    const [a1, b1 = a1] = ['hi', 1];
>a1 : string
>   : ^^^^^^
>b1 : string | number
>   : ^^^^^^^^^^^^^^^
>a1 : string
>   : ^^^^^^
>['hi', 1] : [string, number]
>          : ^^^^^^^^^^^^^^^^
>'hi' : "hi"
>     : ^^^^
>1 : 1
>  : ^

    const [a2, b2 = a2 + '!'] = ['hi', 1];
>a2 : string
>   : ^^^^^^
>b2 : string | number
>   : ^^^^^^^^^^^^^^^
>a2 + '!' : string
>         : ^^^^^^
>a2 : string
>   : ^^^^^^
>'!' : "!"
>    : ^^^
>['hi', 1] : [string, number]
>          : ^^^^^^^^^^^^^^^^
>'hi' : "hi"
>     : ^^^^
>1 : 1
>  : ^

}

// Based on comment:
//   - https://github.com/microsoft/TypeScript/issues/49989#issuecomment-1852694486
const yadda: [number, number] | undefined = null as unknown as ([number, number] | undefined);
>yadda : [number, number] | undefined
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown as ([number, number] | undefined) : [number, number] | undefined
>                                                  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

function f4(): void {
