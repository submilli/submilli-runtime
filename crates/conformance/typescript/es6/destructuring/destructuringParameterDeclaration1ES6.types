/*pruned*/;


// If the declaration includes an initializer expression (which is permitted only
// when the parameter list occurs in conjunction with a function body),
// the parameter type is the widened form (section 3.11) of the type of the initializer expression.

function b1(z: (null | undefined)[] = [undefined, null]): void { };
>b1 : (z?: (null | undefined)[]) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>z : (null | undefined)[]
>  : ^^^^^^^^^^^^^^^^^^^^
>[undefined, null] : (null | undefined)[]
>                  : ^^^^^^^^^^^^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^

function b2(z: null = null, o: { x: number; y: undefined; } = { x: 0, y: undefined }): void { }
>b2 : (z?: null, o?: { x: number; y: undefined; }) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>z : null
>  : ^^^^
>o : { x: number; y: undefined; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>y : undefined
>  : ^^^^^^^^^
>{ x: 0, y: undefined } : { x: number; y: undefined; }
>                       : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>0 : 0
>  : ^
>y : undefined
>  : ^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^

