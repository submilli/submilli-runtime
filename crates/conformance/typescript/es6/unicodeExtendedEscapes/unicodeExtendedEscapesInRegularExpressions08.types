=== unicodeExtendedEscapesInRegularExpressions08.ts ===

// ES6 Spec - 10.1.1 Static Semantics: UTF16Encoding (cp)
//  2. If cp ≤ 65535, return cp.
// (FFFF == 65535)
let x = /\u{FFFF}/gu;
>x : RegExp
>  : ^^^^^^
>/\u{FFFF}/gu : RegExp
>             : ^^^^^^



function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


