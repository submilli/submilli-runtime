=== unicodeExtendedEscapesInRegularExpressions06.ts ===

// ES6 Spec - 10.1.1 Static Semantics: UTF16Encoding (cp)
//  1. Assert: 0 ≤ cp ≤ 0x10FFFF.
let x = /\u{10FFFF}/gu;
