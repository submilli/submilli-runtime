=== controlFlowDestructuringDeclaration.ts ===

function f1(): void {
>f1 : () => void
>   : ^^^^^^^^^^

    let x: string | number = 1;
>x : string | number
>  : ^^^^^^^^^^^^^^^
>1 : 1
>  : ^

    x;
>x : number
>  : ^^^^^^

    let y: string | null = "";
>y : string | null
>  : ^^^^^^^^^^^^^
>"" : ""
>   : ^^

    y;
>y : string
>  : ^^^^^^

}

function f2(): void {
>f2 : () => void
>   : ^^^^^^^^^^

    let [x]: [string | number] = [1];
>x : string | number
>  : ^^^^^^^^^^^^^^^
>[1] : [number]
>    : ^^^^^^^^
>1 : 1
>  : ^

    x;
>x : number
>  : ^^^^^^

    let [y]: [string | null] = [""];
>y : string | null
>  : ^^^^^^^^^^^^^
>[""] : [string]
>     : ^^^^^^^^
>"" : ""
>   : ^^

    y;
>y : string
>  : ^^^^^^

    /*pruned*/;                            
    ; 
}

function f3(): void {
>f3 : () => void
>   : ^^^^^^^^^^

    let [x]: (string | number)[] = [1];
