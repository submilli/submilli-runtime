>x : string | number | boolean
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>"number" : "number"
>         : ^^^^^^^^

    if (isString || isNumber) {
>isString || isNumber : boolean
>                     : ^^^^^^^
