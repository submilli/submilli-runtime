function f14(x: number | null | null): number | null {
>f14 : (x: number | null | null) => number | null
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number | null
>  : ^^^^^^^^^^^^^

    const notUndefined = x !== null;
>notUndefined : boolean
>             : ^^^^^^^
>x !== null : boolean
>           : ^^^^^^^
>x : number | null
>  : ^^^^^^^^^^^^^

    return notUndefined ? x : 0;
>notUndefined ? x : 0 : number
>                     : ^^^^^^
>notUndefined : boolean
>             : ^^^^^^^
>x : number
>  : ^^^^^^
>0 : 0
>  : ^

}

