=== callSignatureWithoutReturnTypeAnnotationInference.ts ===

// Call signatures without a return type should infer one from the function body (if present)

// Simple types
/*pruned*/;


/*pruned*/;

/*pruned*/;


/*pruned*/;

function foo3(): never {
>foo3 : () => never
>     : ^^^^^^^^^^^

    return foo3();
>foo3() : never
>       : ^^^^^
>foo3 : () => never
>     : ^^^^^^^^^^^

}
let r3 = foo3();
>r3 : never
>   : ^^^^^
>foo3() : never
>       : ^^^^^
>foo3 : () => never
>     : ^^^^^^^^^^^


function foo4<T>(x: T): T {
>foo4 : <T>(x: T) => T
>     : ^^^^^^^^^^^^^^
>T : T
>  : ^
>x : T
>  : ^

    return x;
>x : T
>  : ^

}
let r4 = foo4(1);
>r4 : number
>   : ^^^^^^
>foo4(1) : 1
>        : ^
>foo4 : <T>(x: T) => T
>     : ^^^^^^^^^^^^^^
>1 : 1
>  : ^


