// merged declarations
interface I2 {
>I2 : I2
>   : ^^

    x: number;
>x : number
>  : ^^^^^^

}
/*pruned*/;


function foo12(): I2 {
>foo12 : () => I2
>      : ^^^^^^^^

    let i2: I2 = null as unknown as (I2);
>i2 : I2
>   : ^^
>null as unknown as (I2) : I2
>                        : ^^
>null as unknown : unknown
>                : ^^^^^^^

    return i2;
>i2 : I2
>   : ^^

}
let r12 = foo12();
>r12 : I2
>    : ^^
>foo12() : I2
>        : ^^
>foo12 : () => I2
>      : ^^^^^^^^


function m1(): number { return 1; }
>m1 : () => number
>   : ^^^^^^^^^^^^
>1 : 1
>  : ^

/*pruned*/;
function foo13(): typeof m1 {
>foo13 : () => typeof m1
>      : ^^^^^^^^^^^^^^^
>m1 : () => number
>   : ^^^^^^^^^^^^

    return m1;
>m1 : () => number
>   : ^^^^^^^^^^^^

}
let r13 = foo13();
>r13 : () => number
>    : ^^^^^^^^^^^^
>foo13() : () => number
>        : ^^^^^^^^^^^^
>foo13 : () => typeof m1
>      : ^^^^^^^^^^^^^^^


