// object types
function foo8(x: number): { x: number; } {
>foo8 : (x: number) => { x: number; }
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>x : number
>  : ^^^^^^

    return { x: x };
>{ x: x } : { x: number; }
>         : ^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>x : number
>  : ^^^^^^

}
let r8 = foo8(1);
>r8 : { x: number; }
>   : ^^^^^^^^^^^^^^
>foo8(1) : { x: number; }
>        : ^^^^^^^^^^^^^^
>foo8 : (x: number) => { x: number; }
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^


interface I {
>I : I
>  : ^

    foo: string;
>foo : string
>    : ^^^^^^

}
function foo9(x: number): I {
>foo9 : (x: number) => I
>     : ^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^

    let i: I = null as unknown as (I);
>i : I
>  : ^
>null as unknown as (I) : I
>                       : ^
>null as unknown : unknown
>                : ^^^^^^^

    return i;
>i : I
>  : ^

}
let r9 = foo9(1);
>r9 : I
>   : ^
>foo9(1) : I
>        : ^
>foo9 : (x: number) => I
>     : ^^^^^^^^^^^^^^^^
>1 : 1
>  : ^


class C {
>C : C
>  : ^

    foo: string;
>foo : string
>    : ^^^^^^

}
