=== callSignaturesWithParameterInitializers.ts ===
// Optional parameters allow initializers only in implementation signatures

function foo(x: number = 1): void { }
>foo : (x?: number) => void
>    : ^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^

let f = function foo(x: number = 1) { }
>f : (x?: number) => void
>  : ^^^^^^^^^^^^^^^^^^^^
>function foo(x: number = 1) { } : (x?: number) => void
>                                : ^^^^^^^^^^^^^^^^^^^^
>foo : (x?: number) => void
>    : ^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^

let f2 = (x: number, y: number = 1) => { }
>f2 : (x: number, y?: number) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>(x: number, y: number = 1) => { } : (x: number, y?: number) => void
>                                  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>y : number
>  : ^^^^^^
>1 : 1
>  : ^


foo(1);
>foo(1) : void
>       : ^^^^
>foo : (x?: number) => void
>    : ^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^

foo();
>foo() : void
>      : ^^^^
>foo : (x?: number) => void
>    : ^^^^^^^^^^^^^^^^^^^^

f(1);
>f(1) : void
>     : ^^^^
>f : (x?: number) => void
>  : ^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^

f();
>f() : void
>    : ^^^^
>f : (x?: number) => void
>  : ^^^^^^^^^^^^^^^^^^^^

f2(1);
>f2(1) : void
>      : ^^^^
>f2 : (x: number, y?: number) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^

f2(1, 2);
>f2(1, 2) : void
>         : ^^^^
>f2 : (x: number, y?: number) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^
>2 : 2
>  : ^


class C {
>C : C
>  : ^

    foo(x: number = 1): void { }
>foo : (x?: number) => void
>    : ^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^

}

