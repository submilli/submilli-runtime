>foo : (x: number, y?: number) => void
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>y : number
>  : ^^^^^^
>1 : 1
>  : ^

    b: (x: number = 1) => { }
>b : (x?: number) => void
>  : ^^^^^^^^^^^^^^^^^^^^
>(x: number = 1) => { } : (x?: number) => void
>                       : ^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^

}

