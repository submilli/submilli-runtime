>  : ^^^^^^
>1 : 1
>  : ^

    a: function foo(x: number, y: number = 1) { },
>a : (x: number, y?: number) => void
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>function foo(x: number, y: number = 1) { } : (x: number, y?: number) => void
