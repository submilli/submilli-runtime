>{     foo(x: number = 1) { },     a: function foo(x: number, y: number = 1) { },     b: (x: number = 1) => { } } : { foo(x?: number): void; a: (x: number, y?: number) => void; b: (x?: number) => void; }
>                                                                                                                 : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

    foo(x: number = 1) { },
>foo : (x?: number) => void
>    : ^^^^^^^^^^^^^^^^^^^^
