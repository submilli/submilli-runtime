>{     foo(x?: number) { },     a: function foo(x: number, y?: number) { },     b: (x?: number) => { } } : { foo(x?: number): void; a: (x: number, y?: number) => void; b: (x?: number) => void; }
>                                                                                                        : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

    foo(x?: number) { },
>foo : (x?: number) => void
>    : ^^^^^^^^^^^^^^^^^^^^
>x : number | undefined
>  : ^^^^^^^^^^^^^^^^^^

    a: function foo(x: number, y?: number) { },
>a : (x: number, y?: number) => void
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
