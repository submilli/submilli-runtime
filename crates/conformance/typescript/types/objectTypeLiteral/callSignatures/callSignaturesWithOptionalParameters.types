>x : number
>  : ^^^^^^
>y : number | undefined
>  : ^^^^^^^^^^^^^^^^^^

    b: (x?: number) => { }
>b : (x?: number) => void
>  : ^^^^^^^^^^^^^^^^^^^^
>(x?: number) => { } : (x?: number) => void
>                    : ^^^^^^^^^^^^^^^^^^^^
>x : number | undefined
>  : ^^^^^^^^^^^^^^^^^^

}

