=== stringLiteralTypesInImplementationSignatures.ts ===
// String literal types are only valid in overload signatures

function foo(x: 'hi'): void { }
>foo : (x: "hi") => void
>    : ^^^^^^^^^^^^^^^^^
>x : "hi"
>  : ^^^^

let f = function foo(x: 'hi') { }
>f : (x: "hi") => void
>  : ^^^^^^^^^^^^^^^^^
>function foo(x: 'hi') { } : (x: "hi") => void
>                          : ^^^^^^^^^^^^^^^^^
>foo : (x: "hi") => void
>    : ^^^^^^^^^^^^^^^^^
>x : "hi"
>  : ^^^^

let f2 = (x: 'hi', y: 'hi') => { }
>f2 : (x: "hi", y: "hi") => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>(x: 'hi', y: 'hi') => { } : (x: "hi", y: "hi") => void
>                          : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : "hi"
>  : ^^^^
>y : "hi"
>  : ^^^^


class C {
>C : C
>  : ^

    foo(x: 'hi'): void { }
>foo : (x: "hi") => void
>    : ^^^^^^^^^^^^^^^^^
>x : "hi"
>  : ^^^^

}

/*pruned*/;




/**/;







let b = {
>b : { foo(x: "hi"): void; a: (x: "hi", y: "hi") => void; b: (x: "hi") => void; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{     foo(x: 'hi') { },     a: function foo(x: 'hi', y: 'hi') { },     b: (x: 'hi') => { } } : { foo(x: "hi"): void; a: (x: "hi", y: "hi") => void; b: (x: "hi") => void; }
>                                                                                             : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

    foo(x: 'hi') { },
>foo : (x: "hi") => void
>    : ^^^^^^^^^^^^^^^^^
>x : "hi"
>  : ^^^^

    a: function foo(x: 'hi', y: 'hi') { },
>a : (x: "hi", y: "hi") => void
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>function foo(x: 'hi', y: 'hi') { } : (x: "hi", y: "hi") => void
>                                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : (x: "hi", y: "hi") => void
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : "hi"
>  : ^^^^
>y : "hi"
>  : ^^^^

    b: (x: 'hi') => { }
>b : (x: "hi") => void
>  : ^^^^^^^^^^^^^^^^^
>(x: 'hi') => { } : (x: "hi") => void
>                 : ^^^^^^^^^^^^^^^^^
>x : "hi"
>  : ^^^^

}


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


