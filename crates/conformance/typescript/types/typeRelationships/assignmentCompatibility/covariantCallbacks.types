// Repro from #51620

type Bivar<T> = { set(value: T): void }
>Bivar : Bivar<T>
>      : ^^^^^^^^
>T : T
>  : ^
>set : (value: T) => void
>    : ^^^^^^^^^^^^^^^^^^
>value : T
>      : ^


let bu: Bivar<unknown> = null as unknown as (Bivar<unknown>);
>bu : Bivar<unknown>
>   : ^^^^^^^^^^^^^^
>null as unknown as (Bivar<unknown>) : Bivar<unknown>
>                                    : ^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let bs: Bivar<string> = null as unknown as (Bivar<string>);
>bs : Bivar<string>
>   : ^^^^^^^^^^^^^
>null as unknown as (Bivar<string>) : Bivar<string>
>                                   : ^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

bu = bs;
>bu = bs : Bivar<string>
>        : ^^^^^^^^^^^^^
>bu : Bivar<unknown>
>   : ^^^^^^^^^^^^^^
>bs : Bivar<string>
>   : ^^^^^^^^^^^^^

bs = bu;
>bs = bu : Bivar<unknown>
>        : ^^^^^^^^^^^^^^
>bs : Bivar<string>
>   : ^^^^^^^^^^^^^
>bu : Bivar<unknown>
>   : ^^^^^^^^^^^^^^


let bfu: Bivar<(x: unknown) => void> = null as unknown as (Bivar<(x: unknown) => void>);
>bfu : Bivar<(x: unknown) => void>
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : unknown
>  : ^^^^^^^
>null as unknown as (Bivar<(x: unknown) => void>) : Bivar<(x: unknown) => void>
>                                                 : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>x : unknown
>  : ^^^^^^^

let bfs: Bivar<(x: string) => void> = null as unknown as (Bivar<(x: string) => void>);
>bfs : Bivar<(x: string) => void>
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string
>  : ^^^^^^
>null as unknown as (Bivar<(x: string) => void>) : Bivar<(x: string) => void>
>                                                : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>x : string
>  : ^^^^^^

bfu = bfs;
>bfu = bfs : Bivar<(x: string) => void>
>          : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>bfu : Bivar<(x: unknown) => void>
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>bfs : Bivar<(x: string) => void>
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^

bfs = bfu;
>bfs = bfu : Bivar<(x: unknown) => void>
>          : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>bfs : Bivar<(x: string) => void>
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>bfu : Bivar<(x: unknown) => void>
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^


