=== assignmentCompatWithObjectMembers3.ts ===
// members N and M of types S and T have the same name, same accessibility, same optionality, and N is assignable M
// additional optional properties do not cause errors

class S implements S2 { foo: string; }
>S : S
>  : ^
>foo : string
>    : ^^^^^^

class T implements T2 { foo: string; }
>T : T
>  : ^
>foo : string
>    : ^^^^^^

/*pruned*/;
/*pruned*/;

interface S2 { foo: string; bar?: string }
>S2 : S2
>   : ^^
>foo : string
>    : ^^^^^^
>bar : string | undefined
>    : ^^^^^^^^^^^^^^^^^^

interface T2 { foo: string; baz?: string }
>T2 : T2
>   : ^^
>foo : string
>    : ^^^^^^
>baz : string | undefined
>    : ^^^^^^^^^^^^^^^^^^

let s2: S2 = null as unknown as (S2);
>s2 : S2
>   : ^^
>null as unknown as (S2) : S2
>                        : ^^
>null as unknown : unknown
>                : ^^^^^^^

let t2: T2 = null as unknown as (T2);
>t2 : T2
>   : ^^
>null as unknown as (T2) : T2
>                        : ^^
>null as unknown : unknown
>                : ^^^^^^^


let a: { foo: string; bar?: string } = null as unknown as ({ foo: string; bar?: string });
>a : { foo: string; bar?: string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : string
>    : ^^^^^^
>bar : string | undefined
>    : ^^^^^^^^^^^^^^^^^^
>null as unknown as ({ foo: string; bar?: string }) : { foo: string; bar?: string; }
>                                                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>foo : string
>    : ^^^^^^
>bar : string | undefined
>    : ^^^^^^^^^^^^^^^^^^

let b: { foo: string; baz?: string } = null as unknown as ({ foo: string; baz?: string });
>b : { foo: string; baz?: string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : string
>    : ^^^^^^
>baz : string | undefined
>    : ^^^^^^^^^^^^^^^^^^
>null as unknown as ({ foo: string; baz?: string }) : { foo: string; baz?: string; }
>                                                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>foo : string
>    : ^^^^^^
>baz : string | undefined
>    : ^^^^^^^^^^^^^^^^^^


let a2: S2 = { foo: '' };
>a2 : S2
>   : ^^
>{ foo: '' } : { foo: string; }
>            : ^^^^^^^^^^^^^^^^
>foo : string
>    : ^^^^^^
>'' : ""
>   : ^^

let b2: T2 = { foo: '' };
>b2 : T2
>   : ^^
>{ foo: '' } : { foo: string; }
>            : ^^^^^^^^^^^^^^^^
>foo : string
>    : ^^^^^^
>'' : ""
>   : ^^


