=== assignmentCompatWithCallSignatures2.ts ===
// void returning call signatures can be assigned a non-void returning call signature that otherwise matches

interface T {
>T : T
>  : ^

    f(x: number): void;
>f : (x: number) => void
>  : ^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^

}
/*pruned*/;
let a: { f(x: number): void } = null as unknown as ({ f(x: number): void });
>a : { f(x: number): void; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^
>f : (x: number) => void
>  : ^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>null as unknown as ({ f(x: number): void }) : { f(x: number): void; }
>                                            : ^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>f : (x: number) => void
>  : ^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^


