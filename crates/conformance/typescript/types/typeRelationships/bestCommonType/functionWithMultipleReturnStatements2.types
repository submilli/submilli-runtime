=== functionWithMultipleReturnStatements2.ts ===

// return type of a function with multiple returns is the BCT of each return statement
// no errors expected here

function f1(): 1 | null {
>f1 : () => 1 | null
>   : ^^^^^^^^^^^^^^

    if (true) {
>true : true
>     : ^^^^

        return 1;
>1 : 1
>  : ^

    } else {
        return null;
    }
}

function f2(): 1 | 2 | null {
>f2 : () => 1 | 2 | null
>   : ^^^^^^^^^^^^^^^^^^

    if (true) {
>true : true
>     : ^^^^

        return 1;
>1 : 1
>  : ^

    } else if (false) {
>false : false
>      : ^^^^^

        return null;
    } else {
        return 2;
>2 : 2
>  : ^

    }
}

function f4(): 1 | undefined {
>f4 : () => 1 | undefined
>   : ^^^^^^^^^^^^^^^^^^^

    try {
        return 1;
>1 : 1
>  : ^

    }
    catch (e) {
>e : unknown
>  : ^^^^^^^

        return undefined;
>undefined : undefined
>          : ^^^^^^^^^

    }
    finally {
        return 1;
>1 : 1
>  : ^

    }
}

/*pruned*/;




