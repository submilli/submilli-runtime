// returns number => void
function f11(): ((x: number) => void) | ((x: Object) => void) {
>f11 : () => ((x: number) => void) | ((x: Object) => void)
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
