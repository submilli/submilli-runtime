=== heterogeneousArrayLiterals.ts ===
// type of an array is the best common type of its elements (plus its contextual type if it exists)

let a = [1, '']; // {}[]
>a : (string | number)[]
>  : ^^^^^^^^^^^^^^^^^^^
>[1, ''] : (string | number)[]
>        : ^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^
>'' : ""
>   : ^^

let b = [1, null]; // number[]
>b : (number | null)[]
>  : ^^^^^^^^^^^^^^^^^
>[1, null] : (number | null)[]
>          : ^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^

let c = [1, '', null]; // {}[]
>c : (string | number | null)[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>[1, '', null] : (string | number | null)[]
>              : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^
>'' : ""
>   : ^^

let d = [{}, 1]; // {}[]
>d : {}[]
>  : ^^^^
>[{}, 1] : (number | {})[]
>        : ^^^^^^^^^^^^^^^
>{} : {}
>   : ^^
>1 : 1
>  : ^

let e = [{}, Object]; // {}[]
>e : {}[]
>  : ^^^^
>[{}, Object] : (ObjectConstructor | {})[]
>             : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>{} : {}
>   : ^^
>Object : ObjectConstructor
>       : ^^^^^^^^^^^^^^^^^


let f = [[], [1]]; // number[][]
>f : number[][]
>  : ^^^^^^^^^^
>[[], [1]] : number[][]
>          : ^^^^^^^^^^
>[] : never[]
>   : ^^^^^^^
>[1] : number[]
>    : ^^^^^^^^
>1 : 1
>  : ^

let g = [[1], ['']]; // {}[]
>g : (number[] | string[])[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^
>[[1], ['']] : (number[] | string[])[]
>            : ^^^^^^^^^^^^^^^^^^^^^^^
>[1] : number[]
>    : ^^^^^^^^
>1 : 1
>  : ^
>[''] : string[]
>     : ^^^^^^^^
>'' : ""
>   : ^^


let h = [{ foo: 1, bar: '' }, { foo: 2 }]; // {foo: number}[]
>h : ({ foo: number; bar: string; } | { foo: number; bar?: undefined; })[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[{ foo: 1, bar: '' }, { foo: 2 }] : ({ foo: number; bar: string; } | { foo: number; })[]
>                                  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ foo: 1, bar: '' } : { foo: number; bar: string; }
>                    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : number
>    : ^^^^^^
>1 : 1
>  : ^
>bar : string
>    : ^^^^^^
>'' : ""
>   : ^^
>{ foo: 2 } : { foo: number; }
>           : ^^^^^^^^^^^^^^^^
>foo : number
>    : ^^^^^^
>2 : 2
>  : ^

let i = [{ foo: 1, bar: '' }, { foo: '' }]; // {}[]
>i : ({ foo: number; bar: string; } | { foo: string; bar?: undefined; })[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[{ foo: 1, bar: '' }, { foo: '' }] : ({ foo: number; bar: string; } | { foo: string; })[]
>                                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ foo: 1, bar: '' } : { foo: number; bar: string; }
>                    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : number
>    : ^^^^^^
>1 : 1
>  : ^
>bar : string
>    : ^^^^^^
>'' : ""
>   : ^^
>{ foo: '' } : { foo: string; }
>            : ^^^^^^^^^^^^^^^^
>foo : string
>    : ^^^^^^
>'' : ""
>   : ^^


let j = [() => 1, () => '']; // {}[]
>j : ((() => number) | (() => string))[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[() => 1, () => ''] : ((() => number) | (() => string))[]
>                    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>() => 1 : () => number
>        : ^^^^^^^^^^^^
>1 : 1
>  : ^
>() => '' : () => string
>         : ^^^^^^^^^^^^
>'' : ""
>   : ^^

let k = [() => 1, () => 1]; // { (): number }[]
>k : (() => number)[]
>  : ^^^^^^^^^^^^^^^^
>[() => 1, () => 1] : (() => number)[]
>                   : ^^^^^^^^^^^^^^^^
>() => 1 : () => number
>        : ^^^^^^^^^^^^
>1 : 1
>  : ^
>() => 1 : () => number
>        : ^^^^^^^^^^^^
>1 : 1
>  : ^

let l = [() => 1, () => null]; // { (): any }[]
>l : ((() => number) | (() => null))[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[() => 1, () => null] : ((() => number) | (() => null))[]
>                      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>() => 1 : () => number
>        : ^^^^^^^^^^^^
>1 : 1
>  : ^
>() => null : () => null
>           : ^^^^^^^^^^

let m = [() => 1, () => '', () => null]; // { (): any }[]
>m : ((() => number) | (() => string) | (() => null))[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[() => 1, () => '', () => null] : ((() => number) | (() => string) | (() => null))[]
>                                : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>() => 1 : () => number
>        : ^^^^^^^^^^^^
>1 : 1
>  : ^
>() => '' : () => string
>         : ^^^^^^^^^^^^
>'' : ""
>   : ^^
>() => null : () => null
>           : ^^^^^^^^^^

let n = [[() => 1], [() => '']]; // {}[]
>n : ((() => number)[] | (() => string)[])[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[[() => 1], [() => '']] : ((() => number)[] | (() => string)[])[]
>                        : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[() => 1] : (() => number)[]
>          : ^^^^^^^^^^^^^^^^
>() => 1 : () => number
>        : ^^^^^^^^^^^^
>1 : 1
>  : ^
>[() => ''] : (() => string)[]
>           : ^^^^^^^^^^^^^^^^
>() => '' : () => string
>         : ^^^^^^^^^^^^
>'' : ""
>   : ^^


class Base { foo: string; }
>Base : Base
>     : ^^^^
>foo : string
>    : ^^^^^^

class Derived extends Base { bar: string; }
>Derived : Derived
>        : ^^^^^^^
>Base : Base
>     : ^^^^
>bar : string
>    : ^^^^^^

class Derived2 extends Base { baz: string; }
>Derived2 : Derived2
>         : ^^^^^^^^
>Base : Base
>     : ^^^^
>baz : string
>    : ^^^^^^

