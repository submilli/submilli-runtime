function foo<T, U>(t: T, u: U): void {
>foo : <T, U>(t: T, u: U) => void
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>U : U
>  : ^
>t : T
>  : ^
>u : U
>  : ^

    let a = [t, t]; // T[]
>a : T[]
>  : ^^^
>[t, t] : T[]
>       : ^^^
>t : T
>  : ^
>t : T
>  : ^

    let b = [t, null]; // T[]
>b : (T | null)[]
>  : ^^^^^^^^^^^^
>[t, null] : (T | null)[]
>          : ^^^^^^^^^^^^
>t : T
>  : ^

    let c = [t, u]; // {}[]
>c : (T | U)[]
>  : ^^^^^^^^^
>[t, u] : (T | U)[]
>       : ^^^^^^^^^
>t : T
>  : ^
>u : U
>  : ^

    let d = [t, 1]; // {}[]
>d : (number | T)[]
>  : ^^^^^^^^^^^^^^
>[t, 1] : (number | T)[]
>       : ^^^^^^^^^^^^^^
>t : T
>  : ^
>1 : 1
>  : ^

    let e = [() => t, () => u]; // {}[]
>e : ((() => T) | (() => U))[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>[() => t, () => u] : ((() => T) | (() => U))[]
>                   : ^^^^^^^^^^^^^^^^^^^^^^^^^
>() => t : () => T
>        : ^^^^^^^
>t : T
>  : ^
>() => u : () => U
>        : ^^^^^^^
>u : U
>  : ^

    let f = [() => t, () => u, () => null]; // { (): any }[]
>f : ((() => T) | (() => U) | (() => null))[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[() => t, () => u, () => null] : ((() => T) | (() => U) | (() => null))[]
>                               : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>() => t : () => T
>        : ^^^^^^^
>t : T
>  : ^
>() => u : () => U
>        : ^^^^^^^
>u : U
>  : ^
>() => null : () => null
>           : ^^^^^^^^^^

}

