=== bestCommonTypeOfTuple.ts ===
function f1(x: number): string { return "foo"; }
>f1 : (x: number) => string
>   : ^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>"foo" : "foo"
>      : ^^^^^


function f2(x: number): number { return 10; }
>f2 : (x: number) => number
>   : ^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>10 : 10
>   : ^^


function f3(x: number): boolean { return true; }
>f3 : (x: number) => boolean
>   : ^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>true : true
>     : ^^^^


enum E1 { one }
>E1 : E1
>   : ^^
>one : E1.one
>    : ^^^^^^


enum E2 { two }
>E2 : E2
>   : ^^
>two : E2.two
>    : ^^^^^^



let t1: [(x: number) => string, (x: number) => number] = null as unknown as ([(x: number) => string, (x: number) => number]);
>t1 : [(x: number) => string, (x: number) => number]
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>x : number
>  : ^^^^^^
>null as unknown as ([(x: number) => string, (x: number) => number]) : [(x: number) => string, (x: number) => number]
>                                                                    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>x : number
>  : ^^^^^^
>x : number
>  : ^^^^^^

let t2: [E1, E2] = null as unknown as ([E1, E2]);
>t2 : [E1, E2]
>   : ^^^^^^^^
>null as unknown as ([E1, E2]) : [E1, E2]
>                              : ^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

/*pruned*/;
let t4: [E1, E2, number] = null as unknown as ([E1, E2, number]);
>t4 : [E1, E2, number]
>   : ^^^^^^^^^^^^^^^^
>null as unknown as ([E1, E2, number]) : [E1, E2, number]
>                                      : ^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


// no error
t1 = [f1, f2];
>t1 = [f1, f2] : [(x: number) => string, (x: number) => number]
>              : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>t1 : [(x: number) => string, (x: number) => number]
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[f1, f2] : [(x: number) => string, (x: number) => number]
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>f1 : (x: number) => string
>   : ^^^^^^^^^^^^^^^^^^^^^
>f2 : (x: number) => number
>   : ^^^^^^^^^^^^^^^^^^^^^

t2 = [E1.one, E2.two];
>t2 = [E1.one, E2.two] : [E1, E2]
>                      : ^^^^^^^^
>t2 : [E1, E2]
>   : ^^^^^^^^
>[E1.one, E2.two] : [E1, E2]
>                 : ^^^^^^^^
>E1.one : E1
>       : ^^
>E1 : typeof E1
>   : ^^^^^^^^^
>one : E1
>    : ^^
>E2.two : E2
>       : ^^
>E2 : typeof E2
>   : ^^^^^^^^^
>two : E2
>    : ^^

/*pruned*/;
t4 = [E1.one, E2.two, 20];
>t4 = [E1.one, E2.two, 20] : [E1, E2, number]
>                          : ^^^^^^^^^^^^^^^^
>t4 : [E1, E2, number]
>   : ^^^^^^^^^^^^^^^^
>[E1.one, E2.two, 20] : [E1, E2, number]
>                     : ^^^^^^^^^^^^^^^^
>E1.one : E1
>       : ^^
>E1 : typeof E1
>   : ^^^^^^^^^
>one : E1
>    : ^^
>E2.two : E2
>       : ^^
>E2 : typeof E2
>   : ^^^^^^^^^
>two : E2
>    : ^^
>20 : 20
>   : ^^

let e1 = t1[2];  // {}
>e1 : undefined
>   : ^^^^^^^^^
>t1[2] : undefined
>      : ^^^^^^^^^
>t1 : [(x: number) => string, (x: number) => number]
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>2 : 2
>  : ^

let e2 = t2[2];  // {}
>e2 : undefined
>   : ^^^^^^^^^
>t2[2] : undefined
>      : ^^^^^^^^^
>t2 : [E1, E2]
>   : ^^^^^^^^
>2 : 2
>  : ^

/*pruned*/;      // any
let e4 = t4[3];  // number
>e4 : undefined
>   : ^^^^^^^^^
>t4[3] : undefined
>      : ^^^^^^^^^
>t4 : [E1, E2, number]
>   : ^^^^^^^^^^^^^^^^
>3 : 3
>  : ^


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


