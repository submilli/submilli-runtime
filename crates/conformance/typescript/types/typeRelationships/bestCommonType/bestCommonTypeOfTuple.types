=== bestCommonTypeOfTuple.ts ===
function f1(x: number): string { return "foo"; }
>f1 : (x: number) => string
>   : ^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>"foo" : "foo"
>      : ^^^^^


function f2(x: number): number { return 10; }
>f2 : (x: number) => number
>   : ^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>10 : 10
>   : ^^


function f3(x: number): boolean { return true; }
>f3 : (x: number) => boolean
>   : ^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>true : true
>     : ^^^^


enum E1 { one }
>E1 : E1
>   : ^^
>one : E1.one
>    : ^^^^^^


enum E2 { two }
>E2 : E2
>   : ^^
>two : E2.two
>    : ^^^^^^



let t1: [(x: number) => string, (x: number) => number] = null as unknown as ([(x: number) => string, (x: number) => number]);
>t1 : [(x: number) => string, (x: number) => number]
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>x : number
>  : ^^^^^^
>null as unknown as ([(x: number) => string, (x: number) => number]) : [(x: number) => string, (x: number) => number]
>                                                                    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>x : number
>  : ^^^^^^
>x : number
>  : ^^^^^^

/*pruned*/;                                      
/*pruned*/;                                                
/*pruned*/;                                                      

// no error
t1 = [f1, f2];
>t1 = [f1, f2] : [(x: number) => string, (x: number) => number]
>              : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>t1 : [(x: number) => string, (x: number) => number]
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[f1, f2] : [(x: number) => string, (x: number) => number]
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>f1 : (x: number) => string
>   : ^^^^^^^^^^^^^^^^^^^^^
>f2 : (x: number) => number
>   : ^^^^^^^^^^^^^^^^^^^^^

/*pruned*/;           
/*pruned*/;    
/*pruned*/;               
let e1 = t1[2];  // {}
>e1 : undefined
>   : ^^^^^^^^^
>t1[2] : undefined
>      : ^^^^^^^^^
>t1 : [(x: number) => string, (x: number) => number]
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>2 : 2
>  : ^

/*pruned*/;      // {}
/*pruned*/;      // any
/*pruned*/;      // number

function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


