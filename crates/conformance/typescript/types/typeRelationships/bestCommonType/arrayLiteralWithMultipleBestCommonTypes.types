>a : { x: number; y?: number; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>b : { x: number; z?: number; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>c : { x: number; a?: number; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^


