=== genericCallWithGenericSignatureArguments.ts ===
// When a function expression is inferentially typed (section 4.9.3) and a type assigned to a parameter in that expression references type parameters for which inferences are being made,
// the corresponding inferred type arguments to become fixed and no further candidate inferences are made for them.

function foo<T>(a: (x: T) => T, b: (x: T) => T): (x: T) => T {
>foo : <T>(a: (x: T) => T, b: (x: T) => T) => (x: T) => T
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>a : (x: T) => T
>  : ^^^^^^^^^^^
>x : T
>  : ^
>b : (x: T) => T
>  : ^^^^^^^^^^^
>x : T
>  : ^
>x : T
>  : ^

    let r: (x: T) => T = null as unknown as ((x: T) => T);
>r : (x: T) => T
>  : ^^^^^^^^^^^
>x : T
>  : ^
>null as unknown as ((x: T) => T) : (x: T) => T
>                                 : ^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>x : T
>  : ^

    return r;
>r : (x: T) => T
>  : ^^^^^^^^^^^

}

//var r1 = foo((x: number) => 1, (x: string) => ''); // error
let r1b = foo((x) => 1, (x) => ''); // {} => {}
>r1b : (x: unknown) => unknown
>    : ^^^^^^^^^^^^^^^^^^^^^^^
>foo((x) => 1, (x) => '') : (x: unknown) => unknown
>                         : ^^^^^^^^^^^^^^^^^^^^^^^
>foo : <T>(a: (x: T) => T, b: (x: T) => T) => (x: T) => T
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>(x) => 1 : (x: unknown) => number
>         : ^^^^^^^^^^^^^^^^^^^^^^
>x : unknown
>  : ^^^^^^^
>1 : 1
>  : ^
>(x) => '' : (x: unknown) => string
>          : ^^^^^^^^^^^^^^^^^^^^^^
>x : unknown
>  : ^^^^^^^
>'' : ""
>   : ^^

/*pruned*/;                                           // Object => Object
