=== genericCallWithObjectTypeArgsAndConstraints5.ts ===
// Generic call with constraints infering type parameter from object member properties

class C {
>C : C
>  : ^

    x: string;
>x : string
>  : ^^^^^^

}

class D {
>D : D
>  : ^

    x: string;
>x : string
>  : ^^^^^^

    y: string;
>y : string
>  : ^^^^^^

}

function foo<T, U extends T>(t: T, t2: U): (x: T) => U {
>foo : <T, U extends T>(t: T, t2: U) => (x: T) => U
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>U : U
>  : ^
>t : T
>  : ^
>t2 : U
>   : ^
>x : T
>  : ^

    return (x: T) => t2;
>(x: T) => t2 : (x: T) => U
>             : ^^^^^^^^^^^
>x : T
>  : ^
>t2 : U
>   : ^

}

/*pruned*/;
/*pruned*/;
/*pruned*/;         // the constraints are self-referencing, no downstream error
let r9 = foo(() => 1, () => { }); // the constraints are self-referencing, no downstream error
>r9 : (x: () => number) => () => number
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo(() => 1, () => { }) : (x: () => number) => () => number
>                        : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : <T, U extends T>(t: T, t2: U) => (x: T) => U
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>() => 1 : () => number
>        : ^^^^^^^^^^^^
>1 : 1
>  : ^
>() => { } : () => void
>          : ^^^^^^^^^^


function other<T, U extends T>(): void {
>other : <T, U extends T>() => void
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>U : U
>  : ^

    /*pruned*/;               // error
}


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


