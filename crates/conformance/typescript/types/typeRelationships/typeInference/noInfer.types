type Component<Props> = { props: Props; };
>Component : Component<Props>
>          : ^^^^^^^^^^^^^^^^
>Props : Props
>      : ^^^^^
>props : Props
>      : ^^^^^

function doWork<Props>(Component: Component<Props>, props: NoInfer<Props>): void { }
>doWork : <Props>(Component: Component<Props>, props: NoInfer<Props>) => void
>       : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>Props : Props
>      : ^^^^^
>Component : Component<Props>
>          : ^^^^^^^^^^^^^^^^
>props : NoInfer<Props>
>      : ^^^^^^^^^^^^^^

const comp: Component<{ foo: number }> = null as unknown as (Component<{ foo: number }>);
>comp : Component<{ foo: number; }>
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : number
>    : ^^^^^^
>null as unknown as (Component<{ foo: number }>) : Component<{ foo: number; }>
>                                                : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>foo : number
>    : ^^^^^^


doWork(comp, { foo: 42 }); // ok
>doWork(comp, { foo: 42 }) : void
>                          : ^^^^
>doWork : <Props>(Component: Component<Props>, props: NoInfer<Props>) => void
>       : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>comp : Component<{ foo: number; }>
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ foo: 42 } : { foo: number; }
>            : ^^^^^^^^^^^^^^^^
>foo : number
>    : ^^^^^^
>42 : 42
>   : ^^

doWork(comp, {}); // error
>doWork(comp, {}) : void
>                 : ^^^^
