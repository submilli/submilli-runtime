=== genericCallWithObjectTypeArgsAndConstraints3.ts ===
// Generic call with constraints infering type parameter from object member properties

class Base {
>Base : Base
>     : ^^^^

    x: string;
>x : string
>  : ^^^^^^

}
class Derived extends Base {
>Derived : Derived
>        : ^^^^^^^
>Base : Base
>     : ^^^^

    y: string;
>y : string
>  : ^^^^^^

}
class Derived2 extends Base {
>Derived2 : Derived2
>         : ^^^^^^^^
>Base : Base
>     : ^^^^

    z: string;
>z : string
>  : ^^^^^^

}

/*pruned*/;




/*pruned*/;                                          // error because neither is supertype of the other

/*pruned*/;




/*pruned*/;                                           // ok
/*pruned*/;                                           // ok


function f3<T extends Base>(y: (a: T) => T, x: T): T {
>f3 : <T extends Base>(y: (a: T) => T, x: T) => T
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>y : (a: T) => T
>  : ^^^^^^^^^^^
>a : T
>  : ^
>x : T
>  : ^

    return y(null);
>y(null) : T
>        : ^
>y : (a: T) => T
>  : ^^^^^^^^^^^

}

// all ok - second argument is processed before x is fixed
let r4 = f3(x => x, new Base());
>r4 : Base
>   : ^^^^
>f3(x => x, new Base()) : Base
>                       : ^^^^
>f3 : <T extends Base>(y: (a: T) => T, x: T) => T
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x => x : (x: Base) => Base
>       : ^^^^^^^^^^^^^^^^^
>x : Base
>  : ^^^^
>x : Base
>  : ^^^^
>new Base() : Base
>           : ^^^^
>Base : typeof Base
>     : ^^^^^^^^^^^

let r5 = f3(x => x, new Derived());
>r5 : Derived
>   : ^^^^^^^
>f3(x => x, new Derived()) : Derived
>                          : ^^^^^^^
>f3 : <T extends Base>(y: (a: T) => T, x: T) => T
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x => x : (x: Derived) => Derived
>       : ^^^^^^^^^^^^^^^^^^^^^^^
>x : Derived
>  : ^^^^^^^
>x : Derived
>  : ^^^^^^^
>new Derived() : Derived
>              : ^^^^^^^
>Derived : typeof Derived
>        : ^^^^^^^^^^^^^^

let r6 = f3(x => x, null);
>r6 : Base
>   : ^^^^
>f3(x => x, null) : Base
>                 : ^^^^
>f3 : <T extends Base>(y: (a: T) => T, x: T) => T
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x => x : (x: Base) => Base
>       : ^^^^^^^^^^^^^^^^^
>x : Base
>  : ^^^^
>x : Base
>  : ^^^^



function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


