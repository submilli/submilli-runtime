>  : ^
>cb : (a: T) => U
>   : ^^^^^^^^^^^
>a : T
>  : ^

    return cb(x);
>cb(x) : U
>      : ^
>cb : (a: T) => U
>   : ^^^^^^^^^^^
>x : T
>  : ^

}

