>foo2 : <T, U>(x: T, cb: (a: T) => U) => U
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^
>(a) => '' : (a: number) => string
>          : ^^^^^^^^^^^^^^^^^^^^^
>a : number
>  : ^^^^^^
>'' : ""
>   : ^^

/*pruned*/;

function foo3<T, U>(x: T, cb: (a: T) => U, y: U): U {
>foo3 : <T, U>(x: T, cb: (a: T) => U, y: U) => U
