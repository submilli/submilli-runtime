class Base {
>Base : Base
>     : ^^^^

    x: string;
>x : string
>  : ^^^^^^

}
class Derived extends Base {
>Derived : Derived
>        : ^^^^^^^
>Base : Base
>     : ^^^^

    y: string;
>y : string
>  : ^^^^^^

}
class Derived2 extends Base {
>Derived2 : Derived2
>         : ^^^^^^^^
>Base : Base
>     : ^^^^

    z: string;
>z : string
>  : ^^^^^^

}

// returns {}[]
function f<T extends Base, U extends Base>(a: { x: T; y: U }): (T | U)[] {
>f : <T extends Base, U extends Base>(a: { x: T; y: U; }) => (T | U)[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>U : U
>  : ^
>a : { x: T; y: U; }
>  : ^^^^^^^^^^^^^^^
>x : T
>  : ^
>y : U
>  : ^

    return [a.x, a.y];
>[a.x, a.y] : (T | U)[]
>           : ^^^^^^^^^
>a.x : T
>    : ^
>a : { x: T; y: U; }
>  : ^^^^^^^^^^^^^^^
>x : T
>  : ^
>a.y : U
>    : ^
>a : { x: T; y: U; }
>  : ^^^^^^^^^^^^^^^
>y : U
>  : ^

}

let r = f({ x: new Derived(), y: new Derived2() }); // {}[]
>r : (Derived | Derived2)[]
>  : ^^^^^^^^^^^^^^^^^^^^^^
>f({ x: new Derived(), y: new Derived2() }) : (Derived | Derived2)[]
>                                           : ^^^^^^^^^^^^^^^^^^^^^^
>f : <T extends Base, U extends Base>(a: { x: T; y: U; }) => (T | U)[]
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ x: new Derived(), y: new Derived2() } : { x: Derived; y: Derived2; }
