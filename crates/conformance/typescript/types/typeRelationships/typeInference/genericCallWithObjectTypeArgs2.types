function f2<T extends Base, U extends Base>(a: { x: T; y: U }): (x: T) => U {
>f2 : <T extends Base, U extends Base>(a: { x: T; y: U; }) => (x: T) => U
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>U : U
>  : ^
>a : { x: T; y: U; }
>  : ^^^^^^^^^^^^^^^
>x : T
>  : ^
>y : U
>  : ^
>x : T
>  : ^

    return (x: T) => a.y;
>(x: T) => a.y : (x: T) => U
>              : ^^^^^^^^^^^
>x : T
>  : ^
>a.y : U
>    : ^
>a : { x: T; y: U; }
>  : ^^^^^^^^^^^^^^^
>y : U
>  : ^

}

