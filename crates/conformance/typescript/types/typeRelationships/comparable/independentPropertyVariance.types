=== independentPropertyVariance.ts ===

// Verify that properties can vary independently in comparable relationship

const x: { a: 1, b: string } = null as unknown as ({ a: 1, b: string });
>x : { a: 1; b: string; }
>  : ^^^^^^^^^^^^^^^^^^^^
>a : 1
>  : ^
>b : string
>  : ^^^^^^
>null as unknown as ({ a: 1, b: string }) : { a: 1; b: string; }
>                                         : ^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>a : 1
>  : ^
>b : string
>  : ^^^^^^

const y: { a: number, b: 'a' } = null as unknown as ({ a: number, b: 'a' });
>y : { a: number; b: "a"; }
>  : ^^^^^^^^^^^^^^^^^^^^^^
>a : number
>  : ^^^^^^
>b : "a"
>  : ^^^
>null as unknown as ({ a: number, b: 'a' }) : { a: number; b: "a"; }
>                                           : ^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>a : number
>  : ^^^^^^
>b : "a"
>  : ^^^


x === y;
>x === y : boolean
>        : ^^^^^^^
>x : { a: 1; b: string; }
>  : ^^^^^^^^^^^^^^^^^^^^
>y : { a: number; b: "a"; }
>  : ^^^^^^^^^^^^^^^^^^^^^^



function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


