=== typeAssertionsWithUnionTypes01.ts ===
interface I1 {
>I1 : I1
>   : ^^

    p1: number
>p1 : number
>   : ^^^^^^

}

interface I2 extends I1 {
>I2 : I2
>   : ^^

    p2: number;
>p2 : number
>   : ^^^^^^

}

let x = { p1: 10, p2: 20 };
>x : { p1: number; p2: number; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ p1: 10, p2: 20 } : { p1: number; p2: number; }
>                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>p1 : number
>   : ^^^^^^
>10 : 10
>   : ^^
>p2 : number
>   : ^^^^^^
>20 : 20
>   : ^^

let y: number | I2 = x;
>y : number | I2
>  : ^^^^^^^^^^^
>x : { p1: number; p2: number; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^

let z: I1 = x;
>z : I1
>  : ^^
>x : { p1: number; p2: number; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^


let a = <number | I2>z;
>a : number | I2
>  : ^^^^^^^^^^^
><number | I2>z : number | I2
>               : ^^^^^^^^^^^
>z : I1
>  : ^^

let b = <number>z;
>b : number
>  : ^^^^^^
><number>z : number
>          : ^^^^^^
>z : I1
>  : ^^

let c = <I2>z;
>c : I2
>  : ^^
><I2>z : I2
>      : ^^
>z : I1
>  : ^^

let d = <I1>y;
>d : I1
>  : ^^
><I1>y : I1
>      : ^^
>y : I2
>  : ^^



function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


