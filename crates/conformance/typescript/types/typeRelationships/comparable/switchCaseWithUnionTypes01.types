=== switchCaseWithUnionTypes01.ts ===

let strOrNum: string | number = null as unknown as (string | number);
>strOrNum : string | number
>         : ^^^^^^^^^^^^^^^
>null as unknown as (string | number) : string | number
>                                     : ^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let numOrBool: number | boolean = null as unknown as (number | boolean);
>numOrBool : number | boolean
>          : ^^^^^^^^^^^^^^^^
>null as unknown as (number | boolean) : number | boolean
>                                      : ^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let str: string = null as unknown as (string);
>str : string
>    : ^^^^^^
>null as unknown as (string) : string
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let num: number = null as unknown as (number);
>num : number
>    : ^^^^^^
>null as unknown as (number) : number
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let bool: boolean = null as unknown as (boolean);
>bool : boolean
>     : ^^^^^^^
>null as unknown as (boolean) : boolean
>                             : ^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


switch (strOrNum) {
>strOrNum : string | number
>         : ^^^^^^^^^^^^^^^

    // Identical
    case strOrNum:
>strOrNum : string | number
>         : ^^^^^^^^^^^^^^^

        break;

    // Constituents
    case str:
>str : string
>    : ^^^^^^

    case num:
>num : number
>    : ^^^^^^

        break;

    // Overlap in constituents
    case numOrBool:
>numOrBool : number | boolean
>          : ^^^^^^^^^^^^^^^^

        break;

    // No relation
    case bool:
>bool : boolean
>     : ^^^^^^^

        break;
}

function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


