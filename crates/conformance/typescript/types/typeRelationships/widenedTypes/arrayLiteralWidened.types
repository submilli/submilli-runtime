=== arrayLiteralWidened.ts ===
// array literals are widened upon assignment according to their element type

let a = []; // any[]
>a : any[]
>  : ^^^^^
>[] : never[]
>   : ^^^^^^^

/*pruned*/;

let a_3 = [null, null];
>a_3 : null[]
>    : ^^^^^^
>[null, null] : null[]
>             : ^^^^^^

let a_4 = [undefined, undefined];
>a_4 : undefined[]
>    : ^^^^^^^^^^^
>[undefined, undefined] : undefined[]
>                       : ^^^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^


let b = [[], [null, null]]; // any[][]
>b : null[][]
>  : ^^^^^^^^
>[[], [null, null]] : null[][]
>                   : ^^^^^^^^
>[] : never[]
>   : ^^^^^^^
>[null, null] : null[]
>             : ^^^^^^

let b_2 = [[], []];
>b_2 : never[][]
>    : ^^^^^^^^^
>[[], []] : never[][]
>         : ^^^^^^^^^
>[] : never[]
>   : ^^^^^^^
>[] : never[]
>   : ^^^^^^^

let b_3 = [[undefined, undefined]];
>b_3 : undefined[][]
>    : ^^^^^^^^^^^^^
>[[undefined, undefined]] : undefined[][]
>                         : ^^^^^^^^^^^^^
>[undefined, undefined] : undefined[]
>                       : ^^^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^


let c = [[[]]]; // any[][][]
>c : never[][][]
>  : ^^^^^^^^^^^
>[[[]]] : never[][][]
>       : ^^^^^^^^^^^
>[[]] : never[][]
>     : ^^^^^^^^^
>[] : never[]
>   : ^^^^^^^

let c_2 = [[[null]],[undefined]]
>c_2 : (undefined[] | null[][])[]
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>[[[null]],[undefined]] : (undefined[] | null[][])[]
>                       : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>[[null]] : null[][]
>         : ^^^^^^^^
>[null] : null[]
>       : ^^^^^^
>[undefined] : undefined[]
>            : ^^^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^


// no widening when one or more elements are non-widening

let x: undefined = undefined;
>x : undefined
>  : ^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^


let d = [x];
>d : undefined[]
>  : ^^^^^^^^^^^
>[x] : undefined[]
>    : ^^^^^^^^^^^
>x : undefined
>  : ^^^^^^^^^

/*pruned*/;
let d_3 = [undefined, x];
>d_3 : undefined[]
>    : ^^^^^^^^^^^
>[undefined, x] : undefined[]
>               : ^^^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>x : undefined
>  : ^^^^^^^^^



function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


