=== initializersWidened.ts ===

// these are widened to any at the point of assignment

let x1 = null;
>x1 : null
>   : ^^^^

let y1 = undefined;
>y1 : undefined
>   : ^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^

let z1 = void 0;
>z1 : undefined
>   : ^^^^^^^^^
>void 0 : undefined
>       : ^^^^^^^^^
>0 : 0
>  : ^


// these are not widened

let x2: null = null as unknown as (null);
>x2 : null
>   : ^^^^
>null as unknown as (null) : null
>                          : ^^^^
>null as unknown : unknown
>                : ^^^^^^^

let y2: undefined = null as unknown as (undefined);
>y2 : undefined
>   : ^^^^^^^^^
>null as unknown as (undefined) : undefined
>                               : ^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


let x3: null = null;
>x3 : null
>   : ^^^^

let y3: undefined = undefined;
>y3 : undefined
>   : ^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^

let z3: undefined = void 0;
>z3 : undefined
>   : ^^^^^^^^^
>void 0 : undefined
>       : ^^^^^^^^^
>0 : 0
>  : ^


// widen only when all constituents of union are widening

let x4 = null || null;
>x4 : null
>   : ^^^^
>null || null : null
>             : ^^^^

let y4 = undefined || undefined;
>y4 : undefined
>   : ^^^^^^^^^
>undefined || undefined : undefined
>                       : ^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^

let z4 = void 0 || void 0;
>z4 : undefined
>   : ^^^^^^^^^
>void 0 || void 0 : undefined
>                 : ^^^^^^^^^
>void 0 : undefined
>       : ^^^^^^^^^
>0 : 0
>  : ^
>void 0 : undefined
>       : ^^^^^^^^^
>0 : 0
>  : ^


let x5 = null || x2;
>x5 : null
>   : ^^^^
>null || x2 : null
>           : ^^^^
>x2 : null
>   : ^^^^

let y5 = undefined || y2;
>y5 : undefined
>   : ^^^^^^^^^
>undefined || y2 : undefined
>                : ^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>y2 : undefined
>   : ^^^^^^^^^

let z5 = void 0 || y2;
>z5 : undefined
>   : ^^^^^^^^^
>void 0 || y2 : undefined
>             : ^^^^^^^^^
>void 0 : undefined
>       : ^^^^^^^^^
>0 : 0
>  : ^
>y2 : undefined
>   : ^^^^^^^^^


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


