=== objectLiteralWidened.ts ===
// object literal properties are widened to any

let x1 = {
>x1 : { foo: null; bar: null; }
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^
>{     foo: null,     bar: null } : { foo: null; bar: null; }
>                                 : ^^^^^^^^^^^^^^^^^^^^^^^^^

    foo: null,
>foo : null
>    : ^^^^

    bar: null
>bar : null
>    : ^^^^

}

let y1 = {
>y1 : { foo: null; bar: { baz: null; boo: null; }; }
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{     foo: null,     bar: {         baz: null,         boo: null     } } : { foo: null; bar: { baz: null; boo: null; }; }
>                                                                         : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

    foo: null,
>foo : null
>    : ^^^^

    bar: {
>bar : { baz: null; boo: null; }
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^
>{         baz: null,         boo: null     } : { baz: null; boo: null; }
>                                             : ^^^^^^^^^^^^^^^^^^^^^^^^^

        baz: null,
>baz : null
>    : ^^^^

        boo: null
>boo : null
>    : ^^^^

    }
}

// these are not widened

let u: null = null;
>u : null
>  : ^^^^

let n: null = null;
>n : null
>  : ^^^^


let x2 = {
>x2 : { foo: null; bar: null; }
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^
>{     foo: n,     bar: u } : { foo: null; bar: null; }
>                           : ^^^^^^^^^^^^^^^^^^^^^^^^^

    foo: n,
>foo : null
>    : ^^^^
>n : null
>  : ^^^^

    bar: u
>bar : null
>    : ^^^^
>u : null
>  : ^^^^

}

let y2 = {
>y2 : { foo: null; bar: { baz: null; boo: null; }; }
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{     foo: n,     bar: {         baz: n,         boo: u     } } : { foo: null; bar: { baz: null; boo: null; }; }
>                                                                : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

    foo: n,
>foo : null
>    : ^^^^
>n : null
>  : ^^^^

    bar: {
>bar : { baz: null; boo: null; }
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^
>{         baz: n,         boo: u     } : { baz: null; boo: null; }
>                                       : ^^^^^^^^^^^^^^^^^^^^^^^^^

        baz: n,
>baz : null
>    : ^^^^
>n : null
>  : ^^^^

        boo: u
>boo : null
>    : ^^^^
>u : null
>  : ^^^^

    }
}

function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


