// checking whether other types are subtypes of type parameters with constraints

function f1<T extends U, U>(x: T, y: U): void {
>f1 : <T extends U, U>(x: T, y: U) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>U : U
>  : ^
>x : T
>  : ^
>y : U
>  : ^

    let r = true ? x : y;
>r : U
>  : ^
>true ? x : y : U
>             : ^
>true : true
>     : ^^^^
>x : T
>  : ^
>y : U
>  : ^

    let r_2 = true ? y : x;
>r_2 : U
>    : ^
>true ? y : x : U
>             : ^
>true : true
>     : ^^^^
>y : U
>  : ^
>x : T
>  : ^

}

