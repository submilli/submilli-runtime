function f4<T extends Number>(x: T): void {
>f4 : <T extends Number>(x: T) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>x : T
>  : ^

    let r0 = true ? x : null; // ok
>r0 : T | null
>   : ^^^^^^^^
>true ? x : null : T | null
>                : ^^^^^^^^
>true : true
>     : ^^^^
>x : T
>  : ^

    let r0_2 = true ? null : x; // ok
>r0_2 : T | null
>     : ^^^^^^^^
>true ? null : x : T | null
>                : ^^^^^^^^
>true : true
>     : ^^^^
>x : T
>  : ^


    let u: typeof undefined = null as unknown as (typeof undefined);
>u : undefined
>  : ^^^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>null as unknown as (typeof undefined) : undefined
>                                      : ^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^

    let r0b = true ? u : x; // ok
>r0b : T | undefined
>    : ^^^^^^^^^^^^^
>true ? u : x : T | undefined
>             : ^^^^^^^^^^^^^
>true : true
>     : ^^^^
>u : undefined
>  : ^^^^^^^^^
>x : T
>  : ^

    let r0b_2 = true ? x : u; // ok
>r0b_2 : T | undefined
>      : ^^^^^^^^^^^^^
>true ? x : u : T | undefined
>             : ^^^^^^^^^^^^^
>true : true
>     : ^^^^
>x : T
>  : ^
>u : undefined
>  : ^^^^^^^^^

}

