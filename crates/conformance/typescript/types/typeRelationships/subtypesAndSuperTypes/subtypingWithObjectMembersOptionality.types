=== subtypingWithObjectMembersOptionality.ts ===
// Derived member is not optional but base member is, should be ok

interface Base { foo: string; }
>Base : Base
>     : ^^^^
>foo : string
>    : ^^^^^^

interface Derived extends Base { bar: string; }
>Derived : Derived
>        : ^^^^^^^
>bar : string
>    : ^^^^^^

interface Derived2 extends Derived { baz: string; }
>Derived2 : Derived2
>         : ^^^^^^^^
>baz : string
>    : ^^^^^^


// S is a subtype of a type T, and T is a supertype of S, if one of the following is true, where S' denotes the apparent type (section 3.8.1) of S:
//   - S' and T are object types and, for each member M in T, one of the following is true:
//      - M is a property and S' contains a property N where
//          M and N have the same name,
//          the type of N is a subtype of that of M,
//          M and N are both public or both private, and
//          if M is a required property, N is also a required property.
//      - M is an optional property and S' contains no property of the same name as M.
interface T {
>T : T
>  : ^

    Foo?: Base;
>Foo : Base | undefined
>    : ^^^^^^^^^^^^^^^^

}

interface S extends T {
>S : S
>  : ^

    Foo: Derived
>Foo : Derived
>    : ^^^^^^^

}

/*pruned*/;



/*pruned*/;



interface T3 {
>T3 : T3
>   : ^^

    '1'?: Base;
>'1' : Base | undefined
>    : ^^^^^^^^^^^^^^^^

}

interface S3 extends T3 {
>S3 : S3
>   : ^^

    '1.': Derived;
>'1.' : Derived
>     : ^^^^^^^

}

// object literal case
let a: { Foo?: Base; } = null as unknown as ({ Foo?: Base; });
>a : { Foo?: Base; }
>  : ^^^^^^^^^^^^^^^
>Foo : Base | undefined
>    : ^^^^^^^^^^^^^^^^
>null as unknown as ({ Foo?: Base; }) : { Foo?: Base; }
>                                     : ^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>Foo : Base | undefined
>    : ^^^^^^^^^^^^^^^^

let b = { Foo: <Derived>null };
>b : { Foo: Derived; }
>  : ^^^^^^^^^^^^^^^^^
>{ Foo: <Derived>null } : { Foo: Derived; }
>                       : ^^^^^^^^^^^^^^^^^
>Foo : Derived
>    : ^^^^^^^
><Derived>null : Derived
>              : ^^^^^^^

let r = true ? a : b;
>r : { Foo?: Base; }
>  : ^^^^^^^^^^^^^^^
>true ? a : b : { Foo?: Base; }
>             : ^^^^^^^^^^^^^^^
>true : true
>     : ^^^^
>a : { Foo?: Base; }
>  : ^^^^^^^^^^^^^^^
>b : { Foo: Derived; }
>  : ^^^^^^^^^^^^^^^^^


/*pruned*/;






























function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


