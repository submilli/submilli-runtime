=== typeParameterAsTypeParameterConstraint.ts ===
// Adapted from TypeScript: distinct names for repeated var bindings, initialized
// interface values, explicit return types, and a main entry point.
function foo<T, U extends T>(x: T, y: U): U { return y; }
>foo : <T, U extends T>(x: T, y: U) => U
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>U : U
>  : ^
>x : T
>  : ^
>y : U
>  : ^
>y : U
>  : ^

const r = foo(1, 2);
>r : 2
>  : ^
>foo(1, 2) : 2
>          : ^
>foo : <T, U extends T>(x: T, y: U) => U
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^
>2 : 2
>  : ^

const r1 = foo({}, 1);
>r1 : 1
>   : ^
>foo({}, 1) : 1
>           : ^
>foo : <T, U extends T>(x: T, y: U) => U
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{} : {}
>   : ^^
>1 : 1
>  : ^

interface A { foo: string; }
>A : A
>  : ^
>foo : string
>    : ^^^^^^

interface B extends A { bar: number; }
>B : B
>  : ^
>bar : number
>    : ^^^^^^

const a: A = { foo: "a" };
>a : A
>  : ^
>{ foo: "a" } : { foo: string; }
>             : ^^^^^^^^^^^^^^^^
>foo : string
>    : ^^^^^^
>"a" : "a"
>    : ^^^

const b: B = { foo: "b", bar: 1 };
>b : B
>  : ^
>{ foo: "b", bar: 1 } : { foo: string; bar: number; }
>                     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : string
>    : ^^^^^^
>"b" : "b"
>    : ^^^
>bar : number
>    : ^^^^^^
>1 : 1
>  : ^

const r2 = foo(a, b);
>r2 : B
>   : ^
>foo(a, b) : B
>          : ^
>foo : <T, U extends T>(x: T, y: U) => U
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>a : A
>  : ^
>b : B
>  : ^

const r3 = foo({ x: 1 }, { x: 2, y: 3 });
>r3 : { x: number; y: number; }
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^
>foo({ x: 1 }, { x: 2, y: 3 }) : { x: number; y: number; }
>                              : ^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : <T, U extends T>(x: T, y: U) => U
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ x: 1 } : { x: number; }
>         : ^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
>{ x: 2, y: 3 } : { x: number; y: number; }
>               : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>2 : 2
>  : ^
>y : number
>  : ^^^^^^
>3 : 3
>  : ^

function foo2<T, U extends { length: T }>(x: T, y: U): U { return y; }
>foo2 : <T, U extends { length: T; }>(x: T, y: U) => U
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>U : U
>  : ^
>length : T
>       : ^
>x : T
>  : ^
>y : U
>  : ^
>y : U
>  : ^

foo2(1, "");
>foo2(1, "") : ""
>            : ^^
>foo2 : <T, U extends { length: T; }>(x: T, y: U) => U
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^
>"" : ""
>   : ^^

foo2({}, { length: 2 });
>foo2({}, { length: 2 }) : { length: number; }
>                        : ^^^^^^^^^^^^^^^^^^^
>foo2 : <T, U extends { length: T; }>(x: T, y: U) => U
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{} : {}
>   : ^^
>{ length: 2 } : { length: number; }
>              : ^^^^^^^^^^^^^^^^^^^
>length : number
>       : ^^^^^^
>2 : 2
>  : ^

foo2(1, { width: 3, length: 2 });
>foo2(1, { width: 3, length: 2 }) : { width: number; length: number; }
>                                 : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo2 : <T, U extends { length: T; }>(x: T, y: U) => U
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^
>{ width: 3, length: 2 } : { width: number; length: number; }
>                        : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>width : number
>      : ^^^^^^
>3 : 3
>  : ^
>length : number
>       : ^^^^^^
>2 : 2
>  : ^

foo2(1, []);
>foo2(1, []) : never[]
>            : ^^^^^^^
>foo2 : <T, U extends { length: T; }>(x: T, y: U) => U
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^
>[] : never[]
>   : ^^^^^^^

foo2(1, [""]);
>foo2(1, [""]) : string[]
>              : ^^^^^^^^
>foo2 : <T, U extends { length: T; }>(x: T, y: U) => U
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^
>[""] : string[]
>     : ^^^^^^^^
>"" : ""
>   : ^^

function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


