=== instantiateGenericClassWithZeroTypeArguments.ts ===
// no errors expected when instantiating a generic type with no type arguments provided

class C<T> {
>C : C<T>
>  : ^^^^
>T : T
>  : ^

    x: T;
>x : T
>  : ^

}

let c = new C();
>c : C<unknown>
>  : ^^^^^^^^^^
>new C() : C<unknown>
>        : ^^^^^^^^^^
>C : typeof C
>  : ^^^^^^^^


class D<T, U> {
>D : D<T, U>
>  : ^^^^^^^
>T : T
>  : ^
>U : U
>  : ^

    x: T
>x : T
>  : ^

    y: U
>y : U
>  : ^

}

let d = new D();
>d : D<unknown, unknown>
>  : ^^^^^^^^^^^^^^^^^^^
>new D() : D<unknown, unknown>
>        : ^^^^^^^^^^^^^^^^^^^
>D : typeof D
>  : ^^^^^^^^



function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


