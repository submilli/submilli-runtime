>               : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>'toFixed' : "toFixed"
>          : ^^^^^^^^^


let c = x['toExponential']();
>c : string
>  : ^^^^^^
>x['toExponential']() : string
>                     : ^^^^^^
>x['toExponential'] : (fractionDigits?: number) => string
>                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
