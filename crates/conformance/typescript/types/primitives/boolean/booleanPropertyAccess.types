>  : ^^^^
>toString : () => string
>         : ^^^^^^^^^^^^

let b = x['toString']();
>b : string
>  : ^^^^^^
>x['toString']() : string
>                : ^^^^^^
>x['toString'] : () => string
>              : ^^^^^^^^^^^^
>x : true
>  : ^^^^
>'toString' : "toString"
>           : ^^^^^^^^^^


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


