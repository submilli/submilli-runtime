=== typesWithOptionalProperty.ts ===
// basic uses of optional properties without errors

interface I {
>I : I
>  : ^

    foo: string;
>foo : string
>    : ^^^^^^

    bar?: number;
>bar : number | undefined
>    : ^^^^^^^^^^^^^^^^^^

    baz? (): string;
>baz : (() => string) | undefined
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^

}

let a: {
>a : { foo: string; bar?: number; baz?(): string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

    foo: string;
>foo : string
>    : ^^^^^^

    bar?: number;
>bar : number | undefined
>    : ^^^^^^^^^^^^^^^^^^

    baz? (): string;
>baz : (() => string) | undefined
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^

} = null as unknown as ({
>null as unknown as ({     foo: string;     bar?: number;     baz? (): string; }) : { foo: string; bar?: number; baz?(): string; }
>                                                                                 : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

    foo: string;
>foo : string
>    : ^^^^^^

    bar?: number;
>bar : number | undefined
>    : ^^^^^^^^^^^^^^^^^^

    baz? (): string;
>baz : (() => string) | undefined
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^

});

let b = { foo: '' };
>b : { foo: string; }
>  : ^^^^^^^^^^^^^^^^
>{ foo: '' } : { foo: string; }
>            : ^^^^^^^^^^^^^^^^
>foo : string
>    : ^^^^^^
>'' : ""
>   : ^^

let c = { foo: '', bar: 3 };
>c : { foo: string; bar: number; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ foo: '', bar: 3 } : { foo: string; bar: number; }
>                    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : string
>    : ^^^^^^
>'' : ""
>   : ^^
>bar : number
>    : ^^^^^^
>3 : 3
>  : ^

let d = { foo: '', bar: 3, baz: () => '' };
>d : { foo: string; bar: number; baz: () => string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ foo: '', bar: 3, baz: () => '' } : { foo: string; bar: number; baz: () => string; }
>                                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : string
>    : ^^^^^^
>'' : ""
>   : ^^
>bar : number
>    : ^^^^^^
>3 : 3
>  : ^
>baz : () => string
>    : ^^^^^^^^^^^^
>() => '' : () => string
>         : ^^^^^^^^^^^^
>'' : ""
>   : ^^


let i: I = null as unknown as (I);
>i : I
>  : ^
>null as unknown as (I) : I
>                       : ^
>null as unknown : unknown
>                : ^^^^^^^


i = b;
>i = b : { foo: string; }
>      : ^^^^^^^^^^^^^^^^
>i : I
>  : ^
>b : { foo: string; }
>  : ^^^^^^^^^^^^^^^^

i = c;
>i = c : { foo: string; bar: number; }
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>i : I
>  : ^
>c : { foo: string; bar: number; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

i = d;
>i = d : { foo: string; bar: number; baz: () => string; }
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>i : I
>  : ^
>d : { foo: string; bar: number; baz: () => string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^


a = b;
>a = b : { foo: string; }
>      : ^^^^^^^^^^^^^^^^
>a : { foo: string; bar?: number; baz?(): string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>b : { foo: string; }
>  : ^^^^^^^^^^^^^^^^

a = c;
>a = c : { foo: string; bar: number; }
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>a : { foo: string; bar?: number; baz?(): string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>c : { foo: string; bar: number; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

a = d;
>a = d : { foo: string; bar: number; baz: () => string; }
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>a : { foo: string; bar?: number; baz?(): string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>d : { foo: string; bar: number; baz: () => string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^


i = a;
>i = a : { foo: string; bar?: number; baz?(): string; }
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>i : I
>  : ^
>a : { foo: string; bar?: number; baz?(): string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

a = i;
>a = i : I
>      : ^
>a : { foo: string; bar?: number; baz?(): string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>i : I
>  : ^


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


