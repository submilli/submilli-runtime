    0: string;
>0 : string
>  : ^^^^^^

    1: number;
>1 : number
>  : ^^^^^^

    length: 2;
>length : 2
>       : ^

} = null as unknown as ({
>null as unknown as ({     0: string;     1: number;     length: 2; }) : { 0: string; 1: number; length: 2; }
>                                                                      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

    0: string;
>0 : string
>  : ^^^^^^

    1: number;
>1 : number
>  : ^^^^^^

    length: 2;
>length : 2
>       : ^

});

