interface StrNum extends Array<string|number> {
>StrNum : StrNum
>       : ^^^^^^

    0: string;
>0 : string
>  : ^^^^^^

    1: number;
>1 : number
>  : ^^^^^^

    length: 2;
>length : 2
>       : ^

}

let x: [string, number] = null as unknown as ([string, number]);
>x : [string, number]
>  : ^^^^^^^^^^^^^^^^
>null as unknown as ([string, number]) : [string, number]
>                                      : ^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let y: StrNum = null as unknown as (StrNum);
>y : StrNum
>  : ^^^^^^
>null as unknown as (StrNum) : StrNum
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let z: {
>z : { 0: string; 1: number; length: 2; }
