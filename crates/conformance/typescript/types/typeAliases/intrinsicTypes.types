type TX1<S extends string> = Uppercase<`aB${S}`>;
>TX1 : `AB${Uppercase<S>}`
>    : ^^^^^^^^^^^^^^^^^^^
>S : S
>  : ^

type TX2 = TX1<'xYz'>;  // "ABXYZ"
>TX2 : "ABXYZ"
>    : ^^^^^^^

type TX3<S extends string> = Lowercase<`aB${S}`>;
>TX3 : `ab${Lowercase<S>}`
>    : ^^^^^^^^^^^^^^^^^^^
>S : S
>  : ^

type TX4 = TX3<'xYz'>;  // "abxyz"
>TX4 : "abxyz"
>    : ^^^^^^^

type TX5 = `${Uppercase<'abc'>}${Lowercase<'XYZ'>}`;  // "ABCxyz"
>TX5 : "ABCxyz"
>    : ^^^^^^^^


