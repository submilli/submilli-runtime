function f3<T, U extends T>(x: T, y: U, k: keyof T): void {
>f3 : <T, U extends T>(x: T, y: U, k: keyof T) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>U : U
>  : ^
>x : T
>  : ^
>y : U
>  : ^
>k : keyof T
>  : ^^^^^^^

    x[k] = y[k];
>x[k] = y[k] : U[keyof T]
>            : ^^^^^^^^^^
>x[k] : T[keyof T]
>     : ^^^^^^^^^^
>x : T
>  : ^
>k : keyof T
>  : ^^^^^^^
>y[k] : U[keyof T]
>     : ^^^^^^^^^^
>y : U
>  : ^
>k : keyof T
>  : ^^^^^^^

    y[k] = x[k];  // Error
>y[k] = x[k] : T[keyof T]
>            : ^^^^^^^^^^
>y[k] : U[keyof T]
>     : ^^^^^^^^^^
>y : U
>  : ^
>k : keyof T
>  : ^^^^^^^
>x[k] : T[keyof T]
>     : ^^^^^^^^^^
>x : T
>  : ^
>k : keyof T
>  : ^^^^^^^

}

