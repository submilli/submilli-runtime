=== literalTypesAndDestructuring.ts ===

let x: { a: 0 | 1 | undefined } = null as unknown as ({ a: 0 | 1 | undefined });
>x : { a: 0 | 1 | undefined; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>a : 0 | 1 | undefined
>  : ^^^^^^^^^^^^^^^^^
>null as unknown as ({ a: 0 | 1 | undefined }) : { a: 0 | 1 | undefined; }
>                                              : ^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>a : 0 | 1 | undefined
>  : ^^^^^^^^^^^^^^^^^


let { a: a1 } = x;
>a : any
>  : ^^^
>a1 : 0 | 1 | undefined
>   : ^^^^^^^^^^^^^^^^^
>x : { a: 0 | 1 | undefined; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^

let { a: a2 = 0 } = x;
>a : any
>  : ^^^
>a2 : 0 | 1
>   : ^^^^^
>0 : 0
>  : ^
>x : { a: 0 | 1 | undefined; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^

let { a: a3 = 2 } = x;
>a : any
>  : ^^^
>a3 : number
>   : ^^^^^^
>2 : 2
>  : ^
>x : { a: 0 | 1 | undefined; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^

/*pruned*/;

let b1 = x.a;
>b1 : 0 | 1 | undefined
>   : ^^^^^^^^^^^^^^^^^
>x.a : 0 | 1 | undefined
>    : ^^^^^^^^^^^^^^^^^
>x : { a: 0 | 1 | undefined; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>a : 0 | 1 | undefined
>  : ^^^^^^^^^^^^^^^^^

let b2 = x.a ?? 0;
>b2 : 0 | 1
>   : ^^^^^
>x.a ?? 0 : 0 | 1
>         : ^^^^^
>x.a : 0 | 1 | undefined
>    : ^^^^^^^^^^^^^^^^^
>x : { a: 0 | 1 | undefined; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>a : 0 | 1 | undefined
>  : ^^^^^^^^^^^^^^^^^
>0 : 0
>  : ^

let b3 = x.a ?? 2;
>b3 : number
>   : ^^^^^^
>x.a ?? 2 : 0 | 1 | 2
>         : ^^^^^^^^^
>x.a : 0 | 1 | undefined
>    : ^^^^^^^^^^^^^^^^^
>x : { a: 0 | 1 | undefined; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>a : 0 | 1 | undefined
>  : ^^^^^^^^^^^^^^^^^
>2 : 2
>  : ^

