>                   : ^^^^^^^
>b : boolean
>  : ^^^^^^^
>"foo" == "bar" : boolean
>               : ^^^^^^^
>"foo" : "foo"
>      : ^^^^^
>"bar" : "bar"
>      : ^^^^^


