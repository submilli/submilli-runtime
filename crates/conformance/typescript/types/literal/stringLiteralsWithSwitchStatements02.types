=== stringLiteralsWithSwitchStatements02.ts ===
let x: "foo" = null as unknown as ("foo");
>x : "foo"
>  : ^^^^^
>null as unknown as ("foo") : "foo"
>                           : ^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let y: "foo" | "bar" = null as unknown as ("foo" | "bar");
>y : "foo" | "bar"
>  : ^^^^^^^^^^^^^
>null as unknown as ("foo" | "bar") : "foo" | "bar"
>                                   : ^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


let b: boolean = null as unknown as (boolean);
>b : boolean
>  : ^^^^^^^
>null as unknown as (boolean) : boolean
>                             : ^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

b = x == y;
>b = x == y : boolean
>           : ^^^^^^^
>b : boolean
>  : ^^^^^^^
>x == y : boolean
>       : ^^^^^^^
>x : "foo"
>  : ^^^^^
>y : "foo" | "bar"
>  : ^^^^^^^^^^^^^

