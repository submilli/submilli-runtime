=== stringLiteralsWithEqualityChecks04.ts ===
interface Runnable {
>Runnable : Runnable
>         : ^^^^^^^^

    isRunning: boolean;
>isRunning : boolean
>          : ^^^^^^^

}

interface Refrigerator extends Runnable {
>Refrigerator : Refrigerator
>             : ^^^^^^^^^^^^

    makesFoodGoBrrr: boolean;
>makesFoodGoBrrr : boolean
>                : ^^^^^^^

}

let x: string = null as unknown as (string);
>x : string
>  : ^^^^^^
>null as unknown as (string) : string
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let y: "foo" | Refrigerator = null as unknown as ("foo" | Refrigerator);
>y : Refrigerator | "foo"
>  : ^^^^^^^^^^^^^^^^^^^^
>null as unknown as ("foo" | Refrigerator) : Refrigerator | "foo"
>                                          : ^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


let b: boolean = null as unknown as (boolean);
>b : boolean
>  : ^^^^^^^
>null as unknown as (boolean) : boolean
>                             : ^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

b = x == y;
>b = x == y : boolean
>           : ^^^^^^^
>b : boolean
>  : ^^^^^^^
>x == y : boolean
>       : ^^^^^^^
>x : string
>  : ^^^^^^
