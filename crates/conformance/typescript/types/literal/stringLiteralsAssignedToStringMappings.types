let x: Uppercase<Lowercase<string>> = null as unknown as (Uppercase<Lowercase<string>>);
>x : Uppercase<Lowercase<string>>
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown as (Uppercase<Lowercase<string>>) : Uppercase<Lowercase<string>>
>                                                  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


// good
x = "A";
>x = "A" : "A"
>        : ^^^
>x : Uppercase<Lowercase<string>>
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>"A" : "A"
>    : ^^^


// bad
x = "a";
>x = "a" : "a"
>        : ^^^
>x : Uppercase<Lowercase<string>>
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>"a" : "a"
>    : ^^^


