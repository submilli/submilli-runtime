f(y => {
>f(y => {     const z = y = "foo";     return z; }) : void
>                                                   : ^^^^
>f : (x: (p: "foo" | "bar") => "foo") => void
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
