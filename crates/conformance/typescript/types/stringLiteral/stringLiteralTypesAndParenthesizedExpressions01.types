>"foo" : "foo"
>      : ^^^^^
>("foo") : "foo"
>        : ^^^^^
>"foo" : "foo"
>      : ^^^^^

let d: "foo" | "bar" = (myRandBool ? "foo" : ("bar"));
>d : "foo" | "bar"
>  : ^^^^^^^^^^^^^
>(myRandBool ? "foo" : ("bar")) : "foo" | "bar"
>                               : ^^^^^^^^^^^^^
>myRandBool ? "foo" : ("bar") : "foo" | "bar"
>                             : ^^^^^^^^^^^^^
>myRandBool : () => boolean
>           : ^^^^^^^^^^^^^
