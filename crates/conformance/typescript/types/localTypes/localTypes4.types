function f3(): void {
>f3 : () => void
>   : ^^^^^^^^^^

    // Type parameters and top-level local types are in same declaration space
    function f<T>(): undefined {
>f : <T>() => undefined
>  : ^^^^^^^^^^^^^^^^^^
>T : T
>  : ^

        interface T { }
>T : T
>  : ^

        return undefined;
>undefined : undefined
>          : ^^^^^^^^^

    }
}

function f4(): void {
>f4 : () => void
>   : ^^^^^^^^^^

    // Local types are block scoped
    interface T { x: number }
>T : T
>  : ^
>x : number
>  : ^^^^^^

    let v: T = null as unknown as (T);
>v : T
>  : ^
>null as unknown as (T) : T
>                       : ^
>null as unknown : unknown
>                : ^^^^^^^

    v.x = 10;
>v.x = 10 : 10
>         : ^^
>v.x : number
>    : ^^^^^^
>v : T
>  : ^
>x : number
>  : ^^^^^^
>10 : 10
>   : ^^

    if (true) {
>true : true
>     : ^^^^

        interface T { x: string }
>T : T
>  : ^
>x : string
>  : ^^^^^^

        let v: T = null as unknown as (T);
>v : T
>  : ^
>null as unknown as (T) : T
>                       : ^
>null as unknown : unknown
>                : ^^^^^^^

        v.x = "hello";
>v.x = "hello" : "hello"
>              : ^^^^^^^
>v.x : string
>    : ^^^^^^
>v : T
>  : ^
>x : string
>  : ^^^^^^
>"hello" : "hello"
>        : ^^^^^^^

    }
    else {
        v.x = 20;
>v.x = 20 : 20
>         : ^^
>v.x : number
>    : ^^^^^^
>v : T
>  : ^
>x : number
>  : ^^^^^^
>20 : 20
>   : ^^

    }
}


