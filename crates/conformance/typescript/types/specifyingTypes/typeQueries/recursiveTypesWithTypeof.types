>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>hy2 : { x: Array<typeof hy2>; }
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^

let hy2_2 = hy2.x[0];
>hy2_2 : { x: Array<typeof hy2>; }
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^
>hy2.x[0] : { x: Array<typeof hy2>; }
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^
>hy2.x : { x: Array<typeof hy2>; }[]
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>hy2 : { x: Array<typeof hy2>; }
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^
