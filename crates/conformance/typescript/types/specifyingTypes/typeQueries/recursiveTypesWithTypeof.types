// Hybrid - contains type literals as well as type arguments
// These two are recursive
let hy1: { x: typeof hy1 }[] = null as unknown as ({ x: typeof hy1 }[]);
>hy1 : { x: typeof hy1; }[]
>    : ^^^^^^^^^^^^^^^^^^^^
>x : { x: typeof hy1; }[]
>  : ^^^^^^^^^^^^^^^^^^^^
>hy1 : { x: typeof hy1; }[]
>    : ^^^^^^^^^^^^^^^^^^^^
>null as unknown as ({ x: typeof hy1 }[]) : { x: typeof hy1; }[]
>                                         : ^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>x : { x: typeof hy1; }[]
>  : ^^^^^^^^^^^^^^^^^^^^
>hy1 : { x: typeof hy1; }[]
>    : ^^^^^^^^^^^^^^^^^^^^

let hy1_2 = hy1[0].x;
>hy1_2 : { x: typeof hy1; }[]
>      : ^^^^^^^^^^^^^^^^^^^^
>hy1[0].x : { x: typeof hy1; }[]
>         : ^^^^^^^^^^^^^^^^^^^^
>hy1[0] : { x: typeof hy1; }
>       : ^^^^^^^^^^^^^^^^^^
>hy1 : { x: typeof hy1; }[]
>    : ^^^^^^^^^^^^^^^^^^^^
>0 : 0
>  : ^
>x : { x: typeof hy1; }[]
>  : ^^^^^^^^^^^^^^^^^^^^

let hy2: { x: Array<typeof hy2> } = null as unknown as ({ x: Array<typeof hy2> });
