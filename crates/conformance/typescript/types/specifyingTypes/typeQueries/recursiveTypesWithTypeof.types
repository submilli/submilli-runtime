=== recursiveTypesWithTypeof.ts ===
// The following are errors because of circular references
let c: typeof c = null as unknown as (typeof c);
>c : any
>  : ^^^
>c : any
>  : ^^^
>null as unknown as (typeof c) : any
>                              : ^^^
>null as unknown : unknown
>                : ^^^^^^^
>c : any
>  : ^^^

