// None of these declarations should have any errors!
// Truly recursive types
let g: { x: typeof g; } = null as unknown as ({ x: typeof g; });
>g : { x: typeof g; }
>  : ^^^^^^^^^^^^^^^^
>x : { x: typeof g; }
>  : ^^^^^^^^^^^^^^^^
>g : { x: typeof g; }
>  : ^^^^^^^^^^^^^^^^
>null as unknown as ({ x: typeof g; }) : { x: typeof g; }
>                                      : ^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>x : { x: typeof g; }
>  : ^^^^^^^^^^^^^^^^
>g : { x: typeof g; }
>  : ^^^^^^^^^^^^^^^^

let g_2: typeof g.x = null as unknown as (typeof g.x);
>g_2 : { x: typeof g; }
>    : ^^^^^^^^^^^^^^^^
>g.x : { x: typeof g; }
>    : ^^^^^^^^^^^^^^^^
>g : { x: typeof g; }
>  : ^^^^^^^^^^^^^^^^
>x : { x: typeof g; }
>  : ^^^^^^^^^^^^^^^^
>null as unknown as (typeof g.x) : { x: typeof g; }
>                                : ^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>g.x : { x: typeof g; }
>    : ^^^^^^^^^^^^^^^^
>g : { x: typeof g; }
>  : ^^^^^^^^^^^^^^^^
>x : { x: typeof g; }
>  : ^^^^^^^^^^^^^^^^

let h: () => typeof h = null as unknown as (() => typeof h);
>h : () => typeof h
>  : ^^^^^^^^^^^^^^
>h : () => typeof h
>  : ^^^^^^^^^^^^^^
>null as unknown as (() => typeof h) : () => typeof h
>                                    : ^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>h : () => typeof h
>  : ^^^^^^^^^^^^^^

let h_2 = h();
>h_2 : () => typeof h
>    : ^^^^^^^^^^^^^^
>h() : () => typeof h
>    : ^^^^^^^^^^^^^^
>h : () => typeof h
>  : ^^^^^^^^^^^^^^

let i: (x: typeof i) => typeof x = null as unknown as ((x: typeof i) => typeof x);
>i : (x: typeof i) => typeof x
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : (x: typeof i) => typeof x
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>i : (x: typeof i) => typeof x
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : (x: typeof i) => typeof x
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown as ((x: typeof i) => typeof x) : (x: typeof i) => typeof x
>                                               : ^^^^^^^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>x : (x: typeof i) => typeof x
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>i : (x: typeof i) => typeof x
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : (x: typeof i) => typeof x
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^

let i_2 = i(i);
