function f1(x: { f(): void }, y: { f(x?: string): void }): void {
>f1 : (x: { f(): void; }, y: { f(x?: string): void; }) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : { f(): void; }
>  : ^^^^^^^^^^^^^^
>f : () => void
>  : ^^^^^^^^^^
>y : { f(x?: string): void; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^
>f : (x?: string) => void
>  : ^^^^^^^^^^^^^^^^^^^^
>x : string | undefined
>  : ^^^^^^^^^^^^^^^^^^

    let z = !!true ? x : y;  // { f(x?: string): void }
>z : { f(x?: string): void; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^
>!!true ? x : y : { f(x?: string): void; }
>               : ^^^^^^^^^^^^^^^^^^^^^^^^
>!!true : true
>       : ^^^^
>!true : false
>      : ^^^^^
>true : true
>     : ^^^^
>x : { f(): void; }
>  : ^^^^^^^^^^^^^^
>y : { f(x?: string): void; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^

    z.f();
>z.f() : void
>      : ^^^^
>z.f : (x?: string) => void
>    : ^^^^^^^^^^^^^^^^^^^^
>z : { f(x?: string): void; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^
>f : (x?: string) => void
>  : ^^^^^^^^^^^^^^^^^^^^

    z.f('hello');
>z.f('hello') : void
>             : ^^^^
>z.f : (x?: string) => void
>    : ^^^^^^^^^^^^^^^^^^^^
>z : { f(x?: string): void; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^
>f : (x?: string) => void
>  : ^^^^^^^^^^^^^^^^^^^^
>'hello' : "hello"
>        : ^^^^^^^

}

