type F1 = (a: string, b?: string) => void;
>F1 : F1
>   : ^^
>a : string
>  : ^^^^^^
>b : string | undefined
>  : ^^^^^^^^^^^^^^^^^^

type F2 = (a: string, b?: string, c?: string) => void;
>F2 : F2
>   : ^^
>a : string
>  : ^^^^^^
>b : string | undefined
>  : ^^^^^^^^^^^^^^^^^^
>c : string | undefined
>  : ^^^^^^^^^^^^^^^^^^

type F3 = (a: string, ...rest: string[]) => void;
>F3 : F3
>   : ^^
>a : string
>  : ^^^^^^
>rest : string[]
>     : ^^^^^^^^

type F4 = (a: string, b?: string, ...rest: string[]) => void;
