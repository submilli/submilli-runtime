>  : ^^^^^^
>b : string | undefined
>  : ^^^^^^^^^^^^^^^^^^
>rest : string[]
>     : ^^^^^^^^

type F5 = (a: string, b: string) => void;
>F5 : F5
>   : ^^
>a : string
>  : ^^^^^^
>b : string
>  : ^^^^^^


let f12: F1 | F2 = null as unknown as (F1 | F2);
