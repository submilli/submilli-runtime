=== unionTypeReadonly.ts ===
interface Base {
>Base : Base
>     : ^^^^

    readonly value: number;
>value : number
>      : ^^^^^^

}
interface Identical {
>Identical : Identical
>          : ^^^^^^^^^

    readonly value: number;
>value : number
>      : ^^^^^^

}
interface Mutable {
>Mutable : Mutable
>        : ^^^^^^^

    value: number;
>value : number
>      : ^^^^^^

}
interface DifferentType {
>DifferentType : DifferentType
>              : ^^^^^^^^^^^^^

    readonly value: string;
>value : string
>      : ^^^^^^

}
interface DifferentName {
>DifferentName : DifferentName
>              : ^^^^^^^^^^^^^

    readonly other: number;
>other : number
>      : ^^^^^^

}
let base: Base = null as unknown as (Base);
>base : Base
>     : ^^^^
>null as unknown as (Base) : Base
>                          : ^^^^
>null as unknown : unknown
>                : ^^^^^^^

base.value = 12 // error, lhs can't be a readonly property
>base.value = 12 : 12
>                : ^^
>base.value : any
>           : ^^^
>base : Base
>     : ^^^^
>value : any
>      : ^^^
>12 : 12
>   : ^^

let identical: Base | Identical = null as unknown as (Base | Identical);
