>          : ^^^^^^^^^^^^^^^^
>null as unknown as (Base | Identical) : Base | Identical
>                                      : ^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

identical.value = 12; // error, lhs can't be a readonly property
>identical.value = 12 : 12
