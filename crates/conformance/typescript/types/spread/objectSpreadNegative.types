let spread = { ...{ b: true }, ...{s: "foo" } };
>spread : { s: string; b: boolean; }
>       : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ ...{ b: true }, ...{s: "foo" } } : { s: string; b: boolean; }
>                                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ b: true } : { b: boolean; }
>            : ^^^^^^^^^^^^^^^
>b : boolean
>  : ^^^^^^^
>true : true
>     : ^^^^
>{s: "foo" } : { s: string; }
>            : ^^^^^^^^^^^^^^
>s : string
>  : ^^^^^^
>"foo" : "foo"
>      : ^^^^^

