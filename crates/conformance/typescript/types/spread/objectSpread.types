function genericSpread<T, U>(t: T, u: U, v: T | U, w: T | { s: string }, obj: { x: number }): void {
>genericSpread : <T, U>(t: T, u: U, v: T | U, w: T | { s: string; }, obj: { x: number; }) => void
>              : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>U : U
>  : ^
>t : T
>  : ^
>u : U
>  : ^
>v : T | U
>  : ^^^^^
>w : T | { s: string; }
>  : ^^^^^^^^^^^^^^^^^^
>s : string
>  : ^^^^^^
>obj : { x: number; }
>    : ^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^

    let x01 = { ...t };
>x01 : T
>    : ^
>{ ...t } : T
>         : ^
>t : T
>  : ^

    let x02 = { ...t, ...t };
>x02 : T
>    : ^
>{ ...t, ...t } : T
>               : ^
>t : T
>  : ^
>t : T
>  : ^

    let x03 = { ...t, ...u };
>x03 : T & U
>    : ^^^^^
>{ ...t, ...u } : T & U
>               : ^^^^^
>t : T
>  : ^
>u : U
>  : ^

    let x04 = { ...u, ...t };
