=== objectSpread.ts ===
let o = { a: 1, b: 'no' }
>o : { a: number; b: string; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>{ a: 1, b: 'no' } : { a: number; b: string; }
>                  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>a : number
>  : ^^^^^^
>1 : 1
>  : ^
>b : string
>  : ^^^^^^
>'no' : "no"
>     : ^^^^

let o2 = { b: 'yes', c: true }
>o2 : { b: string; c: boolean; }
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ b: 'yes', c: true } : { b: string; c: boolean; }
>                      : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>b : string
>  : ^^^^^^
>'yes' : "yes"
>      : ^^^^^
>c : boolean
>  : ^^^^^^^
>true : true
>     : ^^^^

let swap = { a: 'yes', b: -1 };
>swap : { a: string; b: number; }
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^
>{ a: 'yes', b: -1 } : { a: string; b: number; }
>                    : ^^^^^^^^^^^^^^^^^^^^^^^^^
>a : string
>  : ^^^^^^
>'yes' : "yes"
>      : ^^^^^
>b : number
>  : ^^^^^^
>-1 : -1
>   : ^^
>1 : 1
>  : ^


