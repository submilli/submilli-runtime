=== spreadContextualTypedBindingPattern.ts ===
// #18308
interface Person {
>Person : Person
>       : ^^^^^^

  naam: string,
>naam : string
>     : ^^^^^^

  age: number
>age : number
>    : ^^^^^^

}

const bob: Person = null as unknown as (Person);
>bob : Person
>    : ^^^^^^
>null as unknown as (Person) : Person
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

const alice: Person = null as unknown as (Person);
>alice : Person
>      : ^^^^^^
>null as unknown as (Person) : Person
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


// [ts] Initializer provides no value for this binding element and the binding element has no default value.
const { naam, age } = {...bob, ...alice}
>naam : string
>     : ^^^^^^
>age : number
>    : ^^^^^^
>{...bob, ...alice} : { naam: string; age: number; }
>                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>bob : Person
>    : ^^^^^^
>alice : Person
>      : ^^^^^^



function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


