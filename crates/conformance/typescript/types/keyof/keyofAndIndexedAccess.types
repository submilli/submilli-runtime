>getProperty(shape, "name") : S["name"]
>                           : ^^^^^^^^^
>getProperty : <T, K extends keyof T>(obj: T, key: K) => T[K]
>            : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>shape : S
>      : ^
>"name" : "name"
>       : ^^^^^^

    let prop = getProperty(shape, key);
>prop : S[K]
>     : ^^^^
