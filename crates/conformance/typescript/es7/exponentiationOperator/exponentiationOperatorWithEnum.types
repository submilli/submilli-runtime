=== exponentiationOperatorWithEnum.ts ===
// operands of an enum type are treated as having the primitive type Number.

enum E {
>E : E
>  : ^

    a,
>a : E.a
>  : ^^^

    b
>b : E.b
>  : ^^^

}

/*pruned*/;
let b: number = null as unknown as (number);
>b : number
>  : ^^^^^^
>null as unknown as (number) : number
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let c: E = null as unknown as (E);
>c : E
>  : ^
>null as unknown as (E) : E
>                       : ^
>null as unknown : unknown
>                : ^^^^^^^


// operator **
/*pruned*/;
let r2 = c ** b;
>r2 : number
>   : ^^^^^^
>c ** b : number
>       : ^^^^^^
>c : E
>  : ^
>b : number
>  : ^^^^^^

let r3 = c ** c;
>r3 : number
>   : ^^^^^^
>c ** c : number
>       : ^^^^^^
>c : E
>  : ^
>c : E
>  : ^

/*pruned*/;
let r5 = b ** c;
>r5 : number
>   : ^^^^^^
>b ** c : number
>       : ^^^^^^
>b : number
>  : ^^^^^^
>c : E
>  : ^

/*pruned*/;
let r7 = E.a ** b;
>r7 : number
>   : ^^^^^^
>E.a ** b : number
>         : ^^^^^^
>E.a : E.a
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>a : E.a
>  : ^^^
>b : number
>  : ^^^^^^

let r8 = E.a ** E.b;
>r8 : number
>   : ^^^^^^
>E.a ** E.b : number
>           : ^^^^^^
>E.a : E.a
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>a : E.a
>  : ^^^
>E.b : E.b
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>b : E.b
>  : ^^^

let r9 = E.a ** 1;
>r9 : number
>   : ^^^^^^
>E.a ** 1 : number
>         : ^^^^^^
>E.a : E.a
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>a : E.a
>  : ^^^
>1 : 1
>  : ^

/*pruned*/;
let r11 = b ** E.b;
>r11 : number
>    : ^^^^^^
>b ** E.b : number
>         : ^^^^^^
>b : number
>  : ^^^^^^
>E.b : E.b
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>b : E.b
>  : ^^^

let r12 = 1 ** E.b;
>r12 : number
>    : ^^^^^^
>1 ** E.b : number
>         : ^^^^^^
>1 : 1
>  : ^
>E.b : E.b
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>b : E.b
>  : ^^^


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


