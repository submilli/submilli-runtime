=== emitExponentiationOperatorInTempalteString4.ts ===

let t1 = 10;
>t1 : number
>   : ^^^^^^
>10 : 10
>   : ^^

let t2 = 10;
>t2 : number
>   : ^^^^^^
>10 : 10
>   : ^^

/**/; 

// With TemplateTail
`${t1 ** -t2} world`;
>`${t1 ** -t2} world` : string
>                     : ^^^^^^
>t1 ** -t2 : number
>          : ^^^^^^
>t1 : number
>   : ^^^^^^
>-t2 : number
>    : ^^^^^^
>t2 : number
>   : ^^^^^^

`${(-t1) ** t2 - t1} world`;
>`${(-t1) ** t2 - t1} world` : string
>                            : ^^^^^^
>(-t1) ** t2 - t1 : number
>                 : ^^^^^^
>(-t1) ** t2 : number
>            : ^^^^^^
>(-t1) : number
>      : ^^^^^^
>-t1 : number
>    : ^^^^^^
>t1 : number
>   : ^^^^^^
>t2 : number
>   : ^^^^^^
>t1 : number
>   : ^^^^^^

/*pruned*/;                   
`${(-t1++) ** t2 - t1} world`;
>`${(-t1++) ** t2 - t1} world` : string
>                              : ^^^^^^
>(-t1++) ** t2 - t1 : number
>                   : ^^^^^^
>(-t1++) ** t2 : number
>              : ^^^^^^
>(-t1++) : number
>        : ^^^^^^
>-t1++ : number
>      : ^^^^^^
>t1++ : number
>     : ^^^^^^
>t1 : number
>   : ^^^^^^
>t2 : number
>   : ^^^^^^
>t1 : number
>   : ^^^^^^

/*pruned*/;                     
/*pruned*/;                         

// TempateHead & TemplateTail are empt
