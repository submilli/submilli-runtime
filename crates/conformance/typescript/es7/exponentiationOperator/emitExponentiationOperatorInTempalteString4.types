>-t1 : number
>    : ^^^^^^
>t1 : number
>   : ^^^^^^
>t2 : number
>   : ^^^^^^
>t1 : number
>   : ^^^^^^

/*pruned*/;                                                 
`${(-t1++) ** t2 - t1} hello world ${t2 ** (-t1++) **  - t1}`;
