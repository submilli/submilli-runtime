=== exponentiationOperatorWithUndefinedValueAndValidOperands.ts ===
// If one operand is the undefined or undefined value, it is treated as having the type of the
// other operand.

enum E {
>E : E
>  : ^

    a,
>a : E.a
>  : ^^^

    b
>b : E.b
>  : ^^^

}

/*pruned*/;                           
let b: number = null as unknown as (number);
>b : number
>  : ^^^^^^
>null as unknown as (number) : number
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


// operator *
/*pruned*/;         
let rk2 = null ** b;
>rk2 : number
>    : ^^^^^^
>null ** b : number
>          : ^^^^^^
>b : number
>  : ^^^^^^

let rk3 = null ** 1;
>rk3 : number
>    : ^^^^^^
>null ** 1 : number
>          : ^^^^^^
>1 : 1
>  : ^

let rk4 = null ** E.a;
>rk4 : number
>    : ^^^^^^
>null ** E.a : number
>            : ^^^^^^
>E.a : E.a
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>a : E.a
>  : ^^^

/*pruned*/;         
let rk6 = b ** null;
>rk6 : number
>    : ^^^^^^
>b ** null : number
>          : ^^^^^^
>b : number
>  : ^^^^^^

let rk7 = 0 ** null;
>rk7 : number
>    : ^^^^^^
>0 ** null : number
>          : ^^^^^^
>0 : 0
>  : ^

let rk8 = E.b ** null;
>rk8 : number
>    : ^^^^^^
>E.b ** null : number
>            : ^^^^^^
>E.b : E.b
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>b : E.b
>  : ^^^


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


