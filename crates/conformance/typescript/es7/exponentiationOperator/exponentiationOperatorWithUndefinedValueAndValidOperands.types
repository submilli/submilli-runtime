>0 ** undefined : number
>               : ^^^^^^
>0 : 0
>  : ^
>undefined : undefined
>          : ^^^^^^^^^

let rk8 = E.b ** undefined;
>rk8 : number
>    : ^^^^^^
>E.b ** undefined : number
>                 : ^^^^^^
>E.b : E.b
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>b : E.b
>  : ^^^
>undefined : undefined
>          : ^^^^^^^^^


