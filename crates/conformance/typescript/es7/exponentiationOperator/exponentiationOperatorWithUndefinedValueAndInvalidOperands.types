=== exponentiationOperatorWithUndefinedValueAndInvalidOperands.ts ===
// If one operand is the undefined or undefined value, it is treated as having the type of the
// other operand.

let a: boolean = null as unknown as (boolean);
>a : boolean
>  : ^^^^^^^
>null as unknown as (boolean) : boolean
>                             : ^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let b: string = null as unknown as (string);
>b : string
>  : ^^^^^^
>null as unknown as (string) : string
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

/*pruned*/;

// operator **
let r1a1 = undefined ** a;
>r1a1 : number
>     : ^^^^^^
>undefined ** a : number
>               : ^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>a : boolean
>  : ^^^^^^^

let r1a2 = undefined ** b;
>r1a2 : number
>     : ^^^^^^
>undefined ** b : number
>               : ^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>b : string
>  : ^^^^^^

/*pruned*/;

let r1b1 = a ** undefined;
>r1b1 : number
>     : ^^^^^^
>a ** undefined : number
>               : ^^^^^^
>a : boolean
>  : ^^^^^^^
>undefined : undefined
>          : ^^^^^^^^^

let r1b2 = b ** undefined;
>r1b2 : number
>     : ^^^^^^
>b ** undefined : number
>               : ^^^^^^
>b : string
>  : ^^^^^^
>undefined : undefined
>          : ^^^^^^^^^

/*pruned*/;

let r1c1 = undefined ** true;
>r1c1 : number
>     : ^^^^^^
>undefined ** true : number
>                  : ^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>true : true
>     : ^^^^

let r1c2 = undefined ** '';
>r1c2 : number
>     : ^^^^^^
>undefined ** '' : number
>                : ^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>'' : ""
>   : ^^

let r1c3 = undefined ** {};
>r1c3 : number
>     : ^^^^^^
>undefined ** {} : number
>                : ^^^^^^
>undefined : undefined
>          : ^^^^^^^^^
>{} : {}
>   : ^^


let r1d1 = true ** undefined;
>r1d1 : number
>     : ^^^^^^
>true ** undefined : number
>                  : ^^^^^^
>true : true
>     : ^^^^
>undefined : undefined
>          : ^^^^^^^^^

let r1d2 = '' ** undefined;
>r1d2 : number
>     : ^^^^^^
>'' ** undefined : number
>                : ^^^^^^
>'' : ""
>   : ^^
>undefined : undefined
>          : ^^^^^^^^^

let r1d3 = {} ** undefined;
>r1d3 : number
>     : ^^^^^^
>{} ** undefined : number
>                : ^^^^^^
>{} : {}
>   : ^^
>undefined : undefined
>          : ^^^^^^^^^


