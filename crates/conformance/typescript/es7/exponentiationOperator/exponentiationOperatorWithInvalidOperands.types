>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let e: { a: number } = null as unknown as ({ a: number });
>e : { a: number; }
>  : ^^^^^^^^^^^^^^
>a : number
>  : ^^^^^^
>null as unknown as ({ a: number }) : { a: number; }
>                                   : ^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>a : number
>  : ^^^^^^

