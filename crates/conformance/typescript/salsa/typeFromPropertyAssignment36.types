>d.q : boolean
>    : ^^^^^^^
>d : typeof d
>  : ^^^^^^^^
>q : boolean
>  : ^^^^^^^
>false : false
>      : ^^^^^

}
d.q
>d.q : boolean
>    : ^^^^^^^
>d : typeof d
>  : ^^^^^^^^
>q : boolean
>  : ^^^^^^^

if (!!false) {
