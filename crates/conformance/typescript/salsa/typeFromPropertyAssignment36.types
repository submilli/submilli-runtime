// OK to access possibly-unassigned properties outside the initialising scope
/*pruned*/;         

function d(): void {
>d : typeof d
>  : ^^^^^^^^

}
d.e = 12
>d.e = 12 : 12
>         : ^^
>d.e : number
>    : ^^^^^^
>d : typeof d
>  : ^^^^^^^^
>e : number
>  : ^^^^^^
>12 : 12
>   : ^^

d.e
>d.e : number
>    : ^^^^^^
>d : typeof d
>  : ^^^^^^^^
>e : number
>  : ^^^^^^


if (!!false) {
