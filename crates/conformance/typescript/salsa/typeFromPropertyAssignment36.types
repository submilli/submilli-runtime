// test function expressions too
const g = function() {
>g : { (): void; expando: number; both: string | number; }
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>function() { } : { (): void; expando: number; both: string | number; }
>               : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

}
if (!!false) {
>!!false : false
