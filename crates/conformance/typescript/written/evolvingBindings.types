// Written for SUB-2101: flow types of uninitialized variables and evolving arrays.
function arrays(flag: boolean): void {
>arrays : (flag: boolean) => void
>       : ^^^^^^^^^^^^^^^^^^^^^^^
>flag : boolean
>     : ^^^^^^^

  const loop = [];
>loop : any[]
>     : ^^^^^
>[] : never[]
>   : ^^^^^^^

  for (const name of ["a", "b"]) loop.push(name);
>name : string
>     : ^^^^^^
>["a", "b"] : string[]
>           : ^^^^^^^^
>"a" : "a"
>    : ^^^
>"b" : "b"
>    : ^^^
>loop.push(name) : number
>                : ^^^^^^
>loop.push : (...items: any[]) => number
>          : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>loop : any[]
>     : ^^^^^
>push : (...items: any[]) => number
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>name : string
>     : ^^^^^^

  const strings: string[] = loop;
>strings : string[]
>        : ^^^^^^^^
>loop : string[]
>     : ^^^^^^^^

  const mixed = [];
>mixed : any[]
>      : ^^^^^
>[] : never[]
>   : ^^^^^^^

  mixed.push(1);
>mixed.push(1) : number
>              : ^^^^^^
>mixed.push : (...items: any[]) => number
>           : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>mixed : any[]
>      : ^^^^^
>push : (...items: any[]) => number
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^

  const first: number = mixed[0];
>first : number
>      : ^^^^^^
>mixed[0] : number
>         : ^^^^^^
>mixed : number[]
>      : ^^^^^^^^
>0 : 0
>  : ^

  mixed.unshift("x");
>mixed.unshift("x") : number
>                   : ^^^^^^
>mixed.unshift : (...items: any[]) => number
>              : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>mixed : any[]
>      : ^^^^^
>unshift : (...items: any[]) => number
>        : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>"x" : "x"
>    : ^^^

  const both: (number | string)[] = mixed;
>both : (string | number)[]
>     : ^^^^^^^^^^^^^^^^^^^
>mixed : (string | number)[]
>      : ^^^^^^^^^^^^^^^^^^^

  const branch = [];
>branch : any[]
>       : ^^^^^
>[] : never[]
>   : ^^^^^^^

  if (flag) branch.push("yes");
>flag : boolean
>     : ^^^^^^^
>branch.push("yes") : number
>                   : ^^^^^^
>branch.push : (...items: any[]) => number
>            : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>branch : any[]
>       : ^^^^^
>push : (...items: any[]) => number
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>"yes" : "yes"
>      : ^^^^^

  const maybeEmpty: string[] = branch;
>maybeEmpty : string[]
>           : ^^^^^^^^
>branch : string[]
>       : ^^^^^^^^

  let reassigned = [];
>reassigned : any[]
>           : ^^^^^
>[] : never[]
>   : ^^^^^^^

  reassigned = [2];
>reassigned = [2] : number[]
>                 : ^^^^^^^^
>reassigned : any[]
>           : ^^^^^
>[2] : number[]
>    : ^^^^^^^^
>2 : 2
>  : ^

  const numbers: number[] = reassigned;
>numbers : number[]
>        : ^^^^^^^^
>reassigned : number[]
>           : ^^^^^^^^

  const indexed = [];
>indexed : any[]
>        : ^^^^^
>[] : never[]
>   : ^^^^^^^

  indexed[0] = 3;
>indexed[0] = 3 : 3
>               : ^
>indexed[0] : any
>           : ^^^
>indexed : any[]
>        : ^^^^^
>0 : 0
>  : ^
>3 : 3
>  : ^

  const indexValue: number = indexed[0];
>indexValue : number
>           : ^^^^^^
>indexed[0] : number
>           : ^^^^^^
>indexed : number[]
>        : ^^^^^^^^
>0 : 0
>  : ^

  const empty = [];
>empty : any[]
>      : ^^^^^
>[] : never[]
>   : ^^^^^^^

  const length: number = empty.length;
>length : number
>       : ^^^^^^
>empty.length : number
>             : ^^^^^^
>empty : any[]
>      : ^^^^^
>length : number
>       : ^^^^^^

}
function variables(flag: boolean): void {
>variables : (flag: boolean) => void
>          : ^^^^^^^^^^^^^^^^^^^^^^^
>flag : boolean
>     : ^^^^^^^

  let result;
>result : any
>       : ^^^

  try { result = "ok"; } catch (error) { return; }
>result = "ok" : "ok"
>              : ^^^^
>result : any
>       : ^^^
>"ok" : "ok"
>     : ^^^^
>error : unknown
>      : ^^^^^^^

  const text: string = result;
>text : string
>     : ^^^^^^
>result : string
>       : ^^^^^^

  let mixed;
>mixed : any
>      : ^^^

  if (flag) mixed = "yes"; else mixed = 7;
>flag : boolean
>     : ^^^^^^^
>mixed = "yes" : "yes"
>              : ^^^^^
>mixed : any
>      : ^^^
>"yes" : "yes"
>      : ^^^^^
>mixed = 7 : 7
>          : ^
>mixed : any
>      : ^^^
>7 : 7
>  : ^

  const union: string | number = mixed;
>union : string | number
>      : ^^^^^^^^^^^^^^^
>mixed : string | number
>      : ^^^^^^^^^^^^^^^

  let maybe;
>maybe : any
>      : ^^^

  if (flag) maybe = 1;
>flag : boolean
>     : ^^^^^^^
>maybe = 1 : 1
>          : ^
>maybe : any
>      : ^^^
>1 : 1
>  : ^

  const optional: number | undefined = maybe;
>optional : number | undefined
>         : ^^^^^^^^^^^^^^^^^^
>maybe : number | undefined
>      : ^^^^^^^^^^^^^^^^^^

}
