=== typeofBigint.ts ===
// Written for Submilli: no upstream case compares `typeof x` with "bigint".

function describe(x: bigint | number): string {
>describe : (x: bigint | number) => string
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number | bigint
>  : ^^^^^^^^^^^^^^^

    if (typeof x === "bigint") {
>typeof x === "bigint" : boolean
>                      : ^^^^^^^
>typeof x : "string" | "number" | "bigint" | "boolean" | "symbol" | "undefined" | "object" | "function"
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number | bigint
>  : ^^^^^^^^^^^^^^^
>"bigint" : "bigint"
>         : ^^^^^^^^

        let big = x;
>big : bigint
>    : ^^^^^^
>x : bigint
>  : ^^^^^^

        return (big * 2n).toString();
>(big * 2n).toString() : string
>                      : ^^^^^^
>(big * 2n).toString : (radix?: number) => string
>                    : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>(big * 2n) : bigint
>           : ^^^^^^
>big * 2n : bigint
>         : ^^^^^^
>big : bigint
>    : ^^^^^^
>2n : 2n
>   : ^^
>toString : (radix?: number) => string
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^^

    }
    let rest = x;
>rest : number
>     : ^^^^^^
>x : number
>  : ^^^^^^

    return rest.toFixed(1);
>rest.toFixed(1) : string
>                : ^^^^^^
>rest.toFixed : (fractionDigits?: number) => string
>             : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>rest : number
>     : ^^^^^^
>toFixed : (fractionDigits?: number) => string
>        : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>1 : 1
>  : ^

}

function wider(x: bigint | string | null): number {
>wider : (x: bigint | string | null) => number
