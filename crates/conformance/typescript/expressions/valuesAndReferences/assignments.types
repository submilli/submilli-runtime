=== assignments.ts ===
// In this file:
//  Assign to a module
//  Assign to a class
//  Assign to an enum
//  Assign to a function
//  Assign to a variable
//  Assign to a parameter
//  Assign to an interface

/*pruned*/;
/**/;     // Error

class C { }
>C : C
>  : ^

C = null; // Error
>C = null : null
>         : ^^^^
>C : any
>  : ^^^


enum E { A }
>E : E
>  : ^
>A : E.A
>  : ^^^

E = null; // Error
>E = null : null
>         : ^^^^
>E : any
>  : ^^^

E.A = null; // OK per spec, Error per implementation (509581)
>E.A = null : null
>           : ^^^^
>E.A : any
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>A : any
>  : ^^^


function fn(): void { }
>fn : () => void
>   : ^^^^^^^^^^

fn = null; // Should be error
>fn = null : null
>          : ^^^^
>fn : any
>   : ^^^


