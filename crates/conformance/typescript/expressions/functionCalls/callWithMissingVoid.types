// Multiple parameters

function a(x: number, y: string, z: void): void  {
>a : (x: number, y: string, z: void) => void
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>y : string
>  : ^^^^^^
>z : void
>  : ^^^^


}

a(4, "hello"); // ok
>a(4, "hello") : void
>              : ^^^^
>a : (x: number, y: string, z: void) => void
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>4 : 4
>  : ^
>"hello" : "hello"
>        : ^^^^^^^

a(4, "hello", void 0); // ok
>a(4, "hello", void 0) : void
>                      : ^^^^
>a : (x: number, y: string, z: void) => void
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>4 : 4
>  : ^
>"hello" : "hello"
>        : ^^^^^^^
>void 0 : undefined
>       : ^^^^^^^^^
>0 : 0
>  : ^

a(4); // not ok
>a(4) : void
>     : ^^^^
>a : (x: number, y: string, z: void) => void
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>4 : 4
>  : ^


