=== callWithSpread2.ts ===
function all(a?: number, b?: number): void { }
>all : (a?: number, b?: number) => void
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>a : number | undefined
>  : ^^^^^^^^^^^^^^^^^^
>b : number | undefined
>  : ^^^^^^^^^^^^^^^^^^

function weird(a?: number | string, b?: number | string): void { }
>weird : (a?: number | string, b?: number | string) => void
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>a : string | number | undefined
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>b : string | number | undefined
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^

function prefix(s: string, a?: number, b?: number): void { }
>prefix : (s: string, a?: number, b?: number) => void
>       : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>s : string
>  : ^^^^^^
>a : number | undefined
>  : ^^^^^^^^^^^^^^^^^^
>b : number | undefined
>  : ^^^^^^^^^^^^^^^^^^

function rest(s: string, a?: number, b?: number,  ...rest: number[]): void { }
>rest : (s: string, a?: number, b?: number, ...rest: number[]) => void
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>s : string
>  : ^^^^^^
>a : number | undefined
>  : ^^^^^^^^^^^^^^^^^^
>b : number | undefined
>  : ^^^^^^^^^^^^^^^^^^
>rest : number[]
>     : ^^^^^^^^

function normal(s: string): void { }
>normal : (s: string) => void
>       : ^^^^^^^^^^^^^^^^^^^
>s : string
>  : ^^^^^^

function thunk(): string { return null as unknown as (string); }
>thunk : () => string
>      : ^^^^^^^^^^^^
>null as unknown as (string) : string
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

function prefix2(s: string, n: number, a?: number, b?: number): void { }
>prefix2 : (s: string, n: number, a?: number, b?: number) => void
>        : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>s : string
>  : ^^^^^^
>n : number
>  : ^^^^^^
>a : number | undefined
>  : ^^^^^^^^^^^^^^^^^^
>b : number | undefined
>  : ^^^^^^^^^^^^^^^^^^


let ns: number[] = null as unknown as (number[]);
>ns : number[]
>   : ^^^^^^^^
>null as unknown as (number[]) : number[]
>                              : ^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let mixed: (number | string)[] = null as unknown as ((number | string)[]);
>mixed : (string | number)[]
>      : ^^^^^^^^^^^^^^^^^^^
>null as unknown as ((number | string)[]) : (string | number)[]
>                                         : ^^^^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let tuple: [number, string] = null as unknown as ([number, string]);
>tuple : [number, string]
>      : ^^^^^^^^^^^^^^^^
>null as unknown as ([number, string]) : [number, string]
>                                      : ^^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


