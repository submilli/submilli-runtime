// use typeof in type query
let z: number = null as unknown as (number);
>z : number
>  : ^^^^^^
>null as unknown as (number) : number
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let x: number[] = null as unknown as (number[]);
>x : number[]
>  : ^^^^^^^^
>null as unknown as (number[]) : number[]
>                              : ^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let r: () => number = null as unknown as (() => number);
>r : () => number
>  : ^^^^^^^^^^^^
>null as unknown as (() => number) : () => number
>                                  : ^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

