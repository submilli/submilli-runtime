// use typeof in type query
let z: string = null as unknown as (string);
>z : string
>  : ^^^^^^
>null as unknown as (string) : string
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let x: string[] = null as unknown as (string[]);
>x : string[]
>  : ^^^^^^^^
>null as unknown as (string[]) : string[]
>                              : ^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let r: () => string = null as unknown as (() => string);
>r : () => string
>  : ^^^^^^^^^^^^
>null as unknown as (() => string) : () => string
>                                  : ^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

