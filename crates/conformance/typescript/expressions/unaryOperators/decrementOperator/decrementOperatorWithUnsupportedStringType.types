=== decrementOperatorWithUnsupportedStringType.ts ===
// -- operator on string type
let STRING: string = null as unknown as (string);
>STRING : string
>       : ^^^^^^
>null as unknown as (string) : string
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let STRING1: string[] = ["", ""];
>STRING1 : string[]
>        : ^^^^^^^^
>["", ""] : string[]
>         : ^^^^^^^^
>"" : ""
>   : ^^
>"" : ""
>   : ^^


function foo(): string { return ""; }
>foo : () => string
>    : ^^^^^^^^^^^^
>"" : ""
>   : ^^


class A {
>A : A
>  : ^

    public a: string;
>a : string
>  : ^^^^^^

    static foo(): string { return ""; }
>foo : () => string
>    : ^^^^^^^^^^^^
>"" : ""
>   : ^^

}
/*pruned*/;



let objA = new A();
>objA : A
>     : ^
>new A() : A
>        : ^
>A : typeof A
>  : ^^^^^^^^


