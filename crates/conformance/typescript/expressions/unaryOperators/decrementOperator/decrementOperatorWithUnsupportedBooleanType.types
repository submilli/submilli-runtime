=== decrementOperatorWithUnsupportedBooleanType.ts ===
// -- operator on boolean type
let BOOLEAN: boolean = null as unknown as (boolean);
>BOOLEAN : boolean
>        : ^^^^^^^
>null as unknown as (boolean) : boolean
>                             : ^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


function foo(): boolean { return true; }
>foo : () => boolean
>    : ^^^^^^^^^^^^^
>true : true
>     : ^^^^


class A {
>A : A
>  : ^

    public a: boolean;
>a : boolean
>  : ^^^^^^^

    static foo(): boolean { return true; }
>foo : () => boolean
>    : ^^^^^^^^^^^^^
>true : true
>     : ^^^^

}
/*pruned*/;



let objA = new A();
>objA : A
>     : ^
>new A() : A
>        : ^
>A : typeof A
>  : ^^^^^^^^


