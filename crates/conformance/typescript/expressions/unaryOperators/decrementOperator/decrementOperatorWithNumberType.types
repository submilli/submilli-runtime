=== decrementOperatorWithNumberType.ts ===
// -- operator on number type
let NUMBER: number = null as unknown as (number);
>NUMBER : number
>       : ^^^^^^
>null as unknown as (number) : number
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let NUMBER1: number[] = [1, 2];
>NUMBER1 : number[]
>        : ^^^^^^^^
>[1, 2] : number[]
>       : ^^^^^^^^
>1 : 1
>  : ^
>2 : 2
>  : ^


class A {
>A : A
>  : ^

    public a: number;
>a : number
>  : ^^^^^^

}
/*pruned*/;



let objA = new A();
>objA : A
>     : ^
>new A() : A
>        : ^
>A : typeof A
>  : ^^^^^^^^


// number type var
/*pruned*/;

let ResultIsNumber2 = NUMBER--;
>ResultIsNumber2 : number
>                : ^^^^^^
>NUMBER-- : number
>         : ^^^^^^
>NUMBER : number
>       : ^^^^^^


// expressions
