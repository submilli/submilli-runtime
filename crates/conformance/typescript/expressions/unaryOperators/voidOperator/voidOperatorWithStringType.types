=== voidOperatorWithStringType.ts ===
// void  operator on string type
let STRING: string = null as unknown as (string);
>STRING : string
>       : ^^^^^^
>null as unknown as (string) : string
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let STRING1: string[] = ["", "abc"];
>STRING1 : string[]
>        : ^^^^^^^^
>["", "abc"] : string[]
>            : ^^^^^^^^
>"" : ""
>   : ^^
>"abc" : "abc"
>      : ^^^^^


function foo(): string { return "abc"; }
>foo : () => string
>    : ^^^^^^^^^^^^
>"abc" : "abc"
>      : ^^^^^


class A {
>A : A
>  : ^

    public a: string;
>a : string
>  : ^^^^^^

    static foo(): string { return ""; }
>foo : () => string
>    : ^^^^^^^^^^^^
>"" : ""
>   : ^^

}
/*pruned*/;



let objA = new A();
>objA : A
>     : ^
>new A() : A
>        : ^
>A : typeof A
>  : ^^^^^^^^


// string type var
let ResultIsAny1 = void STRING;
>ResultIsAny1 : undefined
>             : ^^^^^^^^^
>void STRING : undefined
>            : ^^^^^^^^^
>STRING : string
>       : ^^^^^^

let ResultIsAny2 = void STRING1;
>ResultIsAny2 : undefined
>             : ^^^^^^^^^
>void STRING1 : undefined
>             : ^^^^^^^^^
>STRING1 : string[]
>        : ^^^^^^^^


// string type literal
let ResultIsAny3 = void "";
>ResultIsAny3 : undefined
>             : ^^^^^^^^^
>void "" : undefined
>        : ^^^^^^^^^
>"" : ""
>   : ^^

let ResultIsAny4 = void { x: "", y: "" };
>ResultIsAny4 : undefined
>             : ^^^^^^^^^
>void { x: "", y: "" } : undefined
>                      : ^^^^^^^^^
>{ x: "", y: "" } : { x: string; y: string; }
>                 : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string
>  : ^^^^^^
>"" : ""
>   : ^^
>y : string
>  : ^^^^^^
>"" : ""
>   : ^^

let ResultIsAny5 = void { x: "", y: (s: string) => { return s; } };
>ResultIsAny5 : undefined
>             : ^^^^^^^^^
>void { x: "", y: (s: string) => { return s; } } : undefined
>                                                : ^^^^^^^^^
>{ x: "", y: (s: string) => { return s; } } : { x: string; y: (s: string) => string; }
>                                           : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string
>  : ^^^^^^
>"" : ""
>   : ^^
>y : (s: string) => string
>  : ^^^^^^^^^^^^^^^^^^^^^
>(s: string) => { return s; } : (s: string) => string
>                             : ^^^^^^^^^^^^^^^^^^^^^
>s : string
>  : ^^^^^^
>s : string
>  : ^^^^^^


