/*pruned*/;

// string type var
let ResultIsBoolean1 = !STRING;
>ResultIsBoolean1 : boolean
>                 : ^^^^^^^
>!STRING : boolean
>        : ^^^^^^^
>STRING : string
>       : ^^^^^^

let ResultIsBoolean2 = !STRING1;
>ResultIsBoolean2 : boolean
>                 : ^^^^^^^
>!STRING1 : false
>         : ^^^^^
>STRING1 : string[]
>        : ^^^^^^^^


// string type literal
let ResultIsBoolean3 = !"";
>ResultIsBoolean3 : boolean
>                 : ^^^^^^^
>!"" : true
>    : ^^^^
>"" : ""
>   : ^^

let ResultIsBoolean4 = !{ x: "", y: "" };
>ResultIsBoolean4 : boolean
>                 : ^^^^^^^
>!{ x: "", y: "" } : false
>                  : ^^^^^
>{ x: "", y: "" } : { x: string; y: string; }
>                 : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string
>  : ^^^^^^
>"" : ""
>   : ^^
>y : string
>  : ^^^^^^
>"" : ""
>   : ^^

let ResultIsBoolean5 = !{ x: "", y: (s: string) => { return s; } };
>ResultIsBoolean5 : boolean
>                 : ^^^^^^^
>!{ x: "", y: (s: string) => { return s; } } : false
>                                            : ^^^^^
>{ x: "", y: (s: string) => { return s; } } : { x: string; y: (s: string) => string; }
>                                           : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string
>  : ^^^^^^
>"" : ""
>   : ^^
>y : (s: string) => string
>  : ^^^^^^^^^^^^^^^^^^^^^
>(s: string) => { return s; } : (s: string) => string
>                             : ^^^^^^^^^^^^^^^^^^^^^
>s : string
>  : ^^^^^^
>s : string
>  : ^^^^^^


