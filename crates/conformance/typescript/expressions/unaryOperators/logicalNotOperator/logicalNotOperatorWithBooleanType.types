// boolean type var
let ResultIsBoolean1 = !BOOLEAN;
>ResultIsBoolean1 : boolean
>                 : ^^^^^^^
>!BOOLEAN : boolean
>         : ^^^^^^^
>BOOLEAN : boolean
>        : ^^^^^^^


// boolean type literal
let ResultIsBoolean2 = !true;
>ResultIsBoolean2 : boolean
>                 : ^^^^^^^
>!true : false
>      : ^^^^^
>true : true
>     : ^^^^

let ResultIsBoolean3 = !{ x: true, y: false };
>ResultIsBoolean3 : boolean
>                 : ^^^^^^^
>!{ x: true, y: false } : false
>                       : ^^^^^
>{ x: true, y: false } : { x: boolean; y: boolean; }
>                      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : boolean
>  : ^^^^^^^
>true : true
>     : ^^^^
>y : boolean
>  : ^^^^^^^
>false : false
>      : ^^^^^


