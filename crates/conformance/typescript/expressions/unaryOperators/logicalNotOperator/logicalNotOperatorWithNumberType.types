=== logicalNotOperatorWithNumberType.ts ===
// ! operator on number type
let NUMBER: number = null as unknown as (number);
>NUMBER : number
>       : ^^^^^^
>null as unknown as (number) : number
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let NUMBER1: number[] = [1, 2];
>NUMBER1 : number[]
>        : ^^^^^^^^
>[1, 2] : number[]
>       : ^^^^^^^^
>1 : 1
>  : ^
>2 : 2
>  : ^


function foo(): number { return 1; }
>foo : () => number
>    : ^^^^^^^^^^^^
>1 : 1
>  : ^


/**/;



/*pruned*/;



/*pruned*/;

// number type var
let ResultIsBoolean1 = !NUMBER;
>ResultIsBoolean1 : boolean
>                 : ^^^^^^^
>!NUMBER : boolean
>        : ^^^^^^^
>NUMBER : number
>       : ^^^^^^

let ResultIsBoolean2 = !NUMBER1;
>ResultIsBoolean2 : boolean
>                 : ^^^^^^^
>!NUMBER1 : false
>         : ^^^^^
>NUMBER1 : number[]
>        : ^^^^^^^^


// number type literal
let ResultIsBoolean3 = !1;
>ResultIsBoolean3 : boolean
>                 : ^^^^^^^
>!1 : false
>   : ^^^^^
>1 : 1
>  : ^

let ResultIsBoolean4 = !{ x: 1, y: 2};
>ResultIsBoolean4 : boolean
>                 : ^^^^^^^
>!{ x: 1, y: 2} : false
>               : ^^^^^
>{ x: 1, y: 2} : { x: number; y: number; }
>              : ^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
>y : number
>  : ^^^^^^
>2 : 2
>  : ^

let ResultIsBoolean5 = !{ x: 1, y: (n: number) => { return n; } };
>ResultIsBoolean5 : boolean
>                 : ^^^^^^^
>!{ x: 1, y: (n: number) => { return n; } } : false
>                                           : ^^^^^
>{ x: 1, y: (n: number) => { return n; } } : { x: number; y: (n: number) => number; }
>                                          : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
>y : (n: number) => number
>  : ^^^^^^^^^^^^^^^^^^^^^
>(n: number) => { return n; } : (n: number) => number
>                             : ^^^^^^^^^^^^^^^^^^^^^
>n : number
>  : ^^^^^^
>n : number
>  : ^^^^^^


// number type expressions
/*pruned*/;
/*pruned*/;
let ResultIsBoolean8 = !NUMBER1[0];
>ResultIsBoolean8 : boolean
>                 : ^^^^^^^
>!NUMBER1[0] : boolean
>            : ^^^^^^^
>NUMBER1[0] : number
>           : ^^^^^^
>NUMBER1 : number[]
>        : ^^^^^^^^
>0 : 0
>  : ^

let ResultIsBoolean9 = !foo();
>ResultIsBoolean9 : boolean
>                 : ^^^^^^^
>!foo() : boolean
>       : ^^^^^^^
>foo() : number
>      : ^^^^^^
>foo : () => number
>    : ^^^^^^^^^^^^

/*pruned*/;
let ResultIsBoolean11 = !(NUMBER + NUMBER);
>ResultIsBoolean11 : boolean
>                  : ^^^^^^^
>!(NUMBER + NUMBER) : boolean
>                   : ^^^^^^^
>(NUMBER + NUMBER) : number
>                  : ^^^^^^
>NUMBER + NUMBER : number
>                : ^^^^^^
>NUMBER : number
>       : ^^^^^^
>NUMBER : number
>       : ^^^^^^


// multiple ! operator
let ResultIsBoolean12 = !!NUMBER;
>ResultIsBoolean12 : boolean
>                  : ^^^^^^^
>!!NUMBER : boolean
>         : ^^^^^^^
>!NUMBER : boolean
>        : ^^^^^^^
>NUMBER : number
>       : ^^^^^^

let ResultIsBoolean13 = !!!(NUMBER + NUMBER);
>ResultIsBoolean13 : boolean
>                  : ^^^^^^^
>!!!(NUMBER + NUMBER) : boolean
>                     : ^^^^^^^
>!!(NUMBER + NUMBER) : boolean
>                    : ^^^^^^^
>!(NUMBER + NUMBER) : boolean
>                   : ^^^^^^^
>(NUMBER + NUMBER) : number
>                  : ^^^^^^
>NUMBER + NUMBER : number
>                : ^^^^^^
>NUMBER : number
>       : ^^^^^^
>NUMBER : number
>       : ^^^^^^


// miss assignment operators
!1;
>!1 : false
>   : ^^^^^
>1 : 1
>  : ^

!NUMBER;
>!NUMBER : boolean
>        : ^^^^^^^
>NUMBER : number
>       : ^^^^^^

!NUMBER1;
>!NUMBER1 : false
>         : ^^^^^
>NUMBER1 : number[]
>        : ^^^^^^^^

!foo();
>!foo() : boolean
>       : ^^^^^^^
>foo() : number
>      : ^^^^^^
>foo : () => number
>    : ^^^^^^^^^^^^

