=== incrementOperatorWithUnsupportedStringType.ts ===
// ++ operator on string type
let STRING: string = null as unknown as (string);
>STRING : string
>       : ^^^^^^
>null as unknown as (string) : string
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let STRING1: string[] = ["", ""];
>STRING1 : string[]
>        : ^^^^^^^^
>["", ""] : string[]
>         : ^^^^^^^^
>"" : ""
>   : ^^
>"" : ""
>   : ^^


function foo(): string { return ""; }
>foo : () => string
>    : ^^^^^^^^^^^^
>"" : ""
>   : ^^


