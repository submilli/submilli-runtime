>[1, 2] : number[]
>       : ^^^^^^^^
>1 : 1
>  : ^
>2 : 2
>  : ^


function foo(): number { return 1; }
>foo : () => number
>    : ^^^^^^^^^^^^
>1 : 1
>  : ^


