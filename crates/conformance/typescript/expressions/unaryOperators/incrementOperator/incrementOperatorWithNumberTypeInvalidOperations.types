let ResultIsNumber7 = { x: 1, y: 2 }++;
>ResultIsNumber7 : number
>                : ^^^^^^
>{ x: 1, y: 2 }++ : number
>                 : ^^^^^^
>{ x: 1, y: 2 } : { x: number; y: number; }
>               : ^^^^^^^^^^^^^^^^^^^^^^^^^
