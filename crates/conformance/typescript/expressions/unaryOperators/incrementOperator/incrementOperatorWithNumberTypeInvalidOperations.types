>  : ^
>y : number
>  : ^^^^^^
>2 : 2
>  : ^

let ResultIsNumber8 = { x: 1, y: (n: number) => { return n; } }++;
>ResultIsNumber8 : number
>                : ^^^^^^
>{ x: 1, y: (n: number) => { return n; } }++ : number
>                                            : ^^^^^^
>{ x: 1, y: (n: number) => { return n; } } : { x: number; y: (n: number) => number; }
>                                          : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
>y : (n: number) => number
>  : ^^^^^^^^^^^^^^^^^^^^^
>(n: number) => { return n; } : (n: number) => number
>                             : ^^^^^^^^^^^^^^^^^^^^^
>n : number
>  : ^^^^^^
>n : number
>  : ^^^^^^


