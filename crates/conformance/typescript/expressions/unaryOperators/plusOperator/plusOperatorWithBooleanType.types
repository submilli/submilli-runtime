=== plusOperatorWithBooleanType.ts ===
// + operator on boolean type
let BOOLEAN: boolean = null as unknown as (boolean);
>BOOLEAN : boolean
>        : ^^^^^^^
>null as unknown as (boolean) : boolean
>                             : ^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


function foo(): boolean { return true; }
>foo : () => boolean
>    : ^^^^^^^^^^^^^
>true : true
>     : ^^^^


/**/;



