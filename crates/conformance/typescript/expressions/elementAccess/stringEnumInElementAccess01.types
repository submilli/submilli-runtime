>"c" : "c"
>    : ^^^

}

interface Item {
>Item : Item
>     : ^^^^

    a: string;
>a : string
>  : ^^^^^^

    b: number;
>b : number
>  : ^^^^^^

    c: boolean;
>c : boolean
>  : ^^^^^^^

}

const item: Item = null as unknown as (Item);
>item : Item
>     : ^^^^
