=== superCalls.ts ===
class Base {
>Base : Base
>     : ^^^^

    x: number = 43;
>x : number
>  : ^^^^^^
>43 : 43
>   : ^^

    constructor(n: string) {
>n : string
>  : ^^^^^^


    }
}

function v(): void { }
>v : () => void
>  : ^^^^^^^^^^


class Derived extends Base {
>Derived : Derived
>        : ^^^^^^^
>Base : Base
>     : ^^^^

    //super call in class constructor of derived type
    constructor(public q: number) {
>q : number
>  : ^^^^^^

        super('');
>super('') : void
>          : ^^^^
>super : typeof Base
>      : ^^^^^^^^^^^
>'' : ""
>   : ^^

        //type of super call expression is void
        let p = super('');
>p : void
>  : ^^^^
>super('') : void
>          : ^^^^
>super : typeof Base
>      : ^^^^^^^^^^^
>'' : ""
>   : ^^

        let p_2 = v();
>p_2 : void
>    : ^^^^
>v() : void
>    : ^^^^
>v : () => void
>  : ^^^^^^^^^^

    }
}

class OtherBase {
>OtherBase : OtherBase
>          : ^^^^^^^^^


}

class OtherDerived extends OtherBase {
>OtherDerived : OtherDerived
>             : ^^^^^^^^^^^^
>OtherBase : OtherBase
>          : ^^^^^^^^^

    constructor() {
        let p = '';
>p : string
>  : ^^^^^^
>'' : ""
>   : ^^

        super();
>super() : void
>        : ^^^^
>super : typeof OtherBase
>      : ^^^^^^^^^^^^^^^^

    }
}


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


