>                                  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo : number
>    : ^^^^^^
>bar : string
>    : ^^^^^^
>"hello" : "hello"
>        : ^^^^^^^

