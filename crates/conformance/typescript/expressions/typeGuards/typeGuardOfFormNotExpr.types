>strOrNum : string | number
>         : ^^^^^^^^^^^^^^^
>"string" : "string"
>         : ^^^^^^^^

    num === strOrNum; // number
>num === strOrNum : boolean
>                 : ^^^^^^^
>num : number
>    : ^^^^^^
>strOrNum : number
>         : ^^^^^^

}
else {
    str = strOrNum; // string
>str = strOrNum : string
