// A type guard of the form !expr
// - when true, narrows the type of x by expr when false, or
// - when false, narrows the type of x by expr when true.

// !typeguard1
if (!(typeof strOrNum === "string")) {
>!(typeof strOrNum === "string") : boolean
>                                : ^^^^^^^
>(typeof strOrNum === "string") : boolean
>                               : ^^^^^^^
>typeof strOrNum === "string" : boolean
>                             : ^^^^^^^
