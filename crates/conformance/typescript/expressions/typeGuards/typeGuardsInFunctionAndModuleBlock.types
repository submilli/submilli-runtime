// typeguards are scoped in function/module block

function foo(x: number | string | boolean): string {
>foo : (x: number | string | boolean) => string
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string | number | boolean
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^

    return typeof x === "string"
>typeof x === "string"         ? x         : function f() {             let b = x; // number | boolean             return typeof x === "boolean"                 ? x.toString() // boolean                 : x.toString(); // number         } () : string
>                                                                                                                                                                                                                                                 : ^^^^^^
>typeof x === "string" : boolean
>                      : ^^^^^^^
>typeof x : "string" | "number" | "bigint" | "boolean" | "symbol" | "undefined" | "object" | "function"
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string | number | boolean
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^
>"string" : "string"
>         : ^^^^^^^^

        ? x
>x : string
>  : ^^^^^^

        : function f() {
>function f() {             let b = x; // number | boolean             return typeof x === "boolean"                 ? x.toString() // boolean                 : x.toString(); // number         } () : string
>                                                                                                                                                                                                     : ^^^^^^
>function f() {             let b = x; // number | boolean             return typeof x === "boolean"                 ? x.toString() // boolean                 : x.toString(); // number         } : () => string
>                                                                                                                                                                                                  : ^^^^^^^^^^^^
>f : () => string
>  : ^^^^^^^^^^^^

            let b = x; // number | boolean
>b : number | boolean
>  : ^^^^^^^^^^^^^^^^
>x : number | boolean
>  : ^^^^^^^^^^^^^^^^

            return typeof x === "boolean"
>typeof x === "boolean"                 ? x.toString() // boolean                 : x.toString() : string
>                                                                                                : ^^^^^^
>typeof x === "boolean" : boolean
>                       : ^^^^^^^
>typeof x : "string" | "number" | "bigint" | "boolean" | "symbol" | "undefined" | "object" | "function"
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number | boolean
>  : ^^^^^^^^^^^^^^^^
>"boolean" : "boolean"
>          : ^^^^^^^^^

                ? x.toString() // boolean
>x.toString() : string
>             : ^^^^^^
>x.toString : () => string
>           : ^^^^^^^^^^^^
>x : boolean
>  : ^^^^^^^
>toString : () => string
>         : ^^^^^^^^^^^^

                : x.toString(); // number
>x.toString() : string
>             : ^^^^^^
>x.toString : (radix?: number) => string
>           : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>toString : (radix?: number) => string
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^^

        } ();
}
