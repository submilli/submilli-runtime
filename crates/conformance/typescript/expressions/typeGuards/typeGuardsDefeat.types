>foo2 : (x: number | string) => number | undefined
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string | number
>  : ^^^^^^^^^^^^^^^

    if (typeof x === "string") {
>typeof x === "string" : boolean
>                      : ^^^^^^^
>typeof x : "string" | "number" | "bigint" | "boolean" | "symbol" | "undefined" | "object" | "function"
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string | number
>  : ^^^^^^^^^^^^^^^
>"string" : "string"
>         : ^^^^^^^^

        return x.length; // string
>x.length : number
>         : ^^^^^^
>x : string
>  : ^^^^^^
>length : number
>       : ^^^^^^

    }
    else {
        let f = function () {
>f : () => number
>  : ^^^^^^^^^^^^
>function () {             return x * x;         } : () => number
>                                                  : ^^^^^^^^^^^^

            return x * x;
>x * x : number
>      : ^^^^^^
>x : string | number
>  : ^^^^^^^^^^^^^^^
>x : string | number
>  : ^^^^^^^^^^^^^^^

        };
    }
    x = "hello";
>x = "hello" : "hello"
>            : ^^^^^^^
>x : string | number
>  : ^^^^^^^^^^^^^^^
>"hello" : "hello"
>        : ^^^^^^^

    ;
}
