// Arrow expression
function f3(param: string | number): void {
>f3 : (param: string | number) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>param : string | number
>      : ^^^^^^^^^^^^^^^

    // variables in function declaration
