// Return type of function
// Inside function declaration
let strOrNum: string | number = null as unknown as (string | number);
>strOrNum : string | number
>         : ^^^^^^^^^^^^^^^
>null as unknown as (string | number) : string | number
>                                     : ^^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

function f4(): string | number {
>f4 : () => string | number
>   : ^^^^^^^^^^^^^^^^^^^^^

    let var2: string | number = strOrNum;
>var2 : string | number
>     : ^^^^^^^^^^^^^^^
>strOrNum : string | number
>         : ^^^^^^^^^^^^^^^

    return var2;
>var2 : string | number
>     : ^^^^^^^^^^^^^^^

}
strOrNum = typeof f4() === "string" && f4(); // string | number
>strOrNum = typeof f4() === "string" && f4() : string | number | false
>                                            : ^^^^^^^^^^^^^^^^^^^^^^^
>strOrNum : string | number
>         : ^^^^^^^^^^^^^^^
>typeof f4() === "string" && f4() : string | number | false
>                                 : ^^^^^^^^^^^^^^^^^^^^^^^
>typeof f4() === "string" : boolean
>                         : ^^^^^^^
>typeof f4() : "string" | "number" | "bigint" | "boolean" | "symbol" | "undefined" | "object" | "function"
>            : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>f4() : string | number
>     : ^^^^^^^^^^^^^^^
>f4 : () => string | number
>   : ^^^^^^^^^^^^^^^^^^^^^
>"string" : "string"
>         : ^^^^^^^^
>f4() : string | number
>     : ^^^^^^^^^^^^^^^
>f4 : () => string | number
