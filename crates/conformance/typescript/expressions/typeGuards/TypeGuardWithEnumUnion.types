>  : ^^^^^^^
>G : Color.G
>  : ^^^^^^^
>B : Color.B
>  : ^^^^^^^


function f1(x: Color | string): void {
>f1 : (x: Color | string) => void
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string | Color
>  : ^^^^^^^^^^^^^^

    if (typeof x === "number") {
>typeof x === "number" : boolean
>                      : ^^^^^^^
>typeof x : "string" | "number" | "bigint" | "boolean" | "symbol" | "undefined" | "object" | "function"
>         : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : string | Color
>  : ^^^^^^^^^^^^^^
>"number" : "number"
>         : ^^^^^^^^

        let y = x;
>y : Color
>  : ^^^^^
>x : Color
>  : ^^^^^

        /*pruned*/;                                 
    }
    else {
        let z = x;
>z : string
>  : ^^^^^^
>x : string
>  : ^^^^^^

        let z_2: string = null as unknown as (string);
>z_2 : string
>    : ^^^^^^
>null as unknown as (string) : string
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

    }
}

