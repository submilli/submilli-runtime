=== arithmeticOperatorWithInvalidOperands.ts ===
// these operators require their operands to be of type Any, the Number primitive type, or
// an enum type
enum E { a, b, c }
>E : E
>  : ^
>a : E.a
>  : ^^^
>b : E.b
>  : ^^^
>c : E.c
>  : ^^^


/*pruned*/;
let b: boolean = null as unknown as (boolean);
>b : boolean
>  : ^^^^^^^
>null as unknown as (boolean) : boolean
>                             : ^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let c: number = null as unknown as (number);
>c : number
>  : ^^^^^^
>null as unknown as (number) : number
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let d: string = null as unknown as (string);
>d : string
>  : ^^^^^^
>null as unknown as (string) : string
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

let e: { a: number } = null as unknown as ({ a: number });
>e : { a: number; }
>  : ^^^^^^^^^^^^^^
>a : number
>  : ^^^^^^
>null as unknown as ({ a: number }) : { a: number; }
>                                   : ^^^^^^^^^^^^^^
>null as unknown : unknown
>                : ^^^^^^^
>a : number
>  : ^^^^^^

