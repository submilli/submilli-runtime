=== arithmeticOperatorWithNullValueAndValidOperands.ts ===
// If one operand is the null or undefined value, it is treated as having the type of the
// other operand.

enum E {
>E : E
>  : ^

    a,
>a : E.a
>  : ^^^

    b
>b : E.b
>  : ^^^

}

/*pruned*/;
let b: number = null as unknown as (number);
>b : number
>  : ^^^^^^
>null as unknown as (number) : number
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^


// operator *
/*pruned*/;
let ra2 = null * b;
>ra2 : number
>    : ^^^^^^
>null * b : number
>         : ^^^^^^
>b : number
>  : ^^^^^^

let ra3 = null * 1;
>ra3 : number
>    : ^^^^^^
>null * 1 : number
>         : ^^^^^^
>1 : 1
>  : ^

let ra4 = null * E.a;
>ra4 : number
>    : ^^^^^^
>null * E.a : number
>           : ^^^^^^
>E.a : E.a
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>a : E.a
>  : ^^^

/*pruned*/;
let ra6 = b * null;
>ra6 : number
>    : ^^^^^^
>b * null : number
>         : ^^^^^^
>b : number
>  : ^^^^^^

let ra7 = 0 * null;
>ra7 : number
>    : ^^^^^^
>0 * null : number
>         : ^^^^^^
>0 : 0
>  : ^

let ra8 = E.b * null;
>ra8 : number
>    : ^^^^^^
>E.b * null : number
>           : ^^^^^^
>E.b : E.b
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>b : E.b
>  : ^^^


