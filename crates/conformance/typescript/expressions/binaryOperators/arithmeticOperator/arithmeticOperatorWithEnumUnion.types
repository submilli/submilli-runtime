=== arithmeticOperatorWithEnumUnion.ts ===
// operands of an enum type are treated as having the primitive type Number.

enum E {
>E : E
>  : ^

    a,
>a : E.a
>  : ^^^

    b
>b : E.b
>  : ^^^

}
enum F {
>F : F
>  : ^

    c,
>c : F.c
>  : ^^^

    d
>d : F.d
>  : ^^^

}

/*pruned*/;
let b: number = null as unknown as (number);
>b : number
>  : ^^^^^^
>null as unknown as (number) : number
>                            : ^^^^^^
>null as unknown : unknown
>                : ^^^^^^^

/*pruned*/;

// operator *
/*pruned*/;
/*pruned*/;
/*pruned*/;
/*pruned*/;
/*pruned*/;
/*pruned*/;
let ra7 = E.a * b;
>ra7 : number
>    : ^^^^^^
>E.a * b : number
>        : ^^^^^^
>E.a : E.a
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>a : E.a
>  : ^^^
>b : number
>  : ^^^^^^

let ra8 = E.a * E.b;
>ra8 : number
>    : ^^^^^^
>E.a * E.b : number
>          : ^^^^^^
>E.a : E.a
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>a : E.a
>  : ^^^
>E.b : E.b
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>b : E.b
>  : ^^^

let ra9 = E.a * 1;
>ra9 : number
>    : ^^^^^^
>E.a * 1 : number
>        : ^^^^^^
>E.a : E.a
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>a : E.a
>  : ^^^
>1 : 1
>  : ^

/*pruned*/;
let ra11 = b * E.b;
>ra11 : number
>     : ^^^^^^
>b * E.b : number
>        : ^^^^^^
>b : number
>  : ^^^^^^
>E.b : E.b
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>b : E.b
>  : ^^^

let ra12 = 1 * E.b;
>ra12 : number
>     : ^^^^^^
>1 * E.b : number
>        : ^^^^^^
>1 : 1
>  : ^
>E.b : E.b
>    : ^^^
>E : typeof E
>  : ^^^^^^^^
>b : E.b
>  : ^^^


