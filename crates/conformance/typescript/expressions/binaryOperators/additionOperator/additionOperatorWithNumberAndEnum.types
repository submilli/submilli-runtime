=== additionOperatorWithNumberAndEnum.ts ===
enum E { a, b }
>E : E
>  : ^
>a : E.a
>  : ^^^
>b : E.b
>  : ^^^

enum F { c, d }
>F : F
>  : ^
>c : F.c
>  : ^^^
>d : F.d
>  : ^^^


let a: number = null as unknown as (number);
