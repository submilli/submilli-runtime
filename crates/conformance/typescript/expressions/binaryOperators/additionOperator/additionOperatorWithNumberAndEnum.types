>                       : ^
>null as unknown : unknown
>                : ^^^^^^^

let c: E | F = null as unknown as (E | F);
>c : E | F
>  : ^^^^^
>null as unknown as (E | F) : E | F
>                           : ^^^^^
>null as unknown : unknown
>                : ^^^^^^^


