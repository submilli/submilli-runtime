/*pruned*/;

// Should parse as a union type, not a bitwise 'or' of (32 as number) and 'string'
let j = 32 as number|string;
>j : string | number
>  : ^^^^^^^^^^^^^^^
>32 as number|string : string | number
>                    : ^^^^^^^^^^^^^^^
>32 : 32
>   : ^^

j = '';
>j = '' : ""
>       : ^^
