>123 + 456 as number : number
>                    : ^^^^^^
>123 + 456 : number
>          : ^^^^^^
>123 : 123
>    : ^^^
>456 : 456
>    : ^^^

let c = `${123 + 456 as number} trailing`;
>c : string
