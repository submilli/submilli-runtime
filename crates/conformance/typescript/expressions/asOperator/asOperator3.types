let a = `${123 + 456 as number}`;
>a : string
>  : ^^^^^^
>`${123 + 456 as number}` : string
>                         : ^^^^^^
>123 + 456 as number : number
>                    : ^^^^^^
>123 + 456 : number
>          : ^^^^^^
>123 : 123
>    : ^^^
>456 : 456
>    : ^^^

let b = `leading ${123 + 456 as number}`;
>b : string
>  : ^^^^^^
