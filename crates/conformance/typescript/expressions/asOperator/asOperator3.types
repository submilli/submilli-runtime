let d = `Hello ${123} World` as string;
>d : string
>  : ^^^^^^
>`Hello ${123} World` as string : string
>                               : ^^^^^^
>`Hello ${123} World` : "Hello 123 World"
>                     : ^^^^^^^^^^^^^^^^^
>123 : 123
>    : ^^^

let e = `Hello` as string;
>e : string
>  : ^^^^^^
>`Hello` as string : string
>                  : ^^^^^^
>`Hello` : "Hello"
>        : ^^^^^^^

