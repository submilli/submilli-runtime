=== typeOfThisInStaticMembers3.ts ===
class C {
>C : C
>  : ^

    static a: number = 1;
>a : number
>  : ^^^^^^
>1 : 1
>  : ^

    static b: number = this.a + 1;
>b : number
>  : ^^^^^^
>this.a + 1 : number
>           : ^^^^^^
>this.a : number
>       : ^^^^^^
>this : typeof C
>     : ^^^^^^^^
>a : number
>  : ^^^^^^
>1 : 1
>  : ^

}

class D extends C {
>D : D
>  : ^
>C : C
>  : ^

    static c: number = 2;
>c : number
>  : ^^^^^^
>2 : 2
>  : ^

    static d: number = this.c + 1;
>d : number
>  : ^^^^^^
>this.c + 1 : number
>           : ^^^^^^
>this.c : number
>       : ^^^^^^
>this : typeof D
>     : ^^^^^^^^
>c : number
>  : ^^^^^^
>1 : 1
>  : ^

    static e: number = super.a + this.c + 1;
>e : number
>  : ^^^^^^
>super.a + this.c + 1 : number
>                     : ^^^^^^
>super.a + this.c : number
>                 : ^^^^^^
>super.a : number
>        : ^^^^^^
>super : typeof C
>      : ^^^^^^^^
>a : number
>  : ^^^^^^
>this.c : number
>       : ^^^^^^
>this : typeof D
>     : ^^^^^^^^
>c : number
>  : ^^^^^^
>1 : 1
>  : ^

}


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


