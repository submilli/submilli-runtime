class C2<T> {
>C2 : C2<T>
>   : ^^^^^
>T : T
>  : ^

    foo: T;
>foo : T
>    : ^

    thing(x: T): void { }
>thing : (x: T) => void
>      : ^^^^^^^^^^^^^^
>x : T
>  : ^

    static other<T>(x: T): void { }
>other : <T>(x: T) => void
>      : ^^^^^^^^^^^^^^^^^
>T : T
>  : ^
>x : T
>  : ^

}

class D2<T> extends C2<T> {
>D2 : D2<T>
>   : ^^^^^
>T : T
>  : ^
>C2 : C2<T>
