=== staticFactory1.ts ===
class Base {
>Base : Base
>     : ^^^^

    foo(): number { return 1; }
>foo : () => number
>    : ^^^^^^^^^^^^
>1 : 1
>  : ^

    static create(): Base {
>create : () => Base
>       : ^^^^^^^^^^

        return new this();
>new this() : Base
>           : ^^^^
>this : typeof Base
>     : ^^^^^^^^^^^

    }
}

class Derived extends Base {
>Derived : Derived
>        : ^^^^^^^
>Base : Base
>     : ^^^^

    foo(): number { return 2; }
>foo : () => number
>    : ^^^^^^^^^^^^
>2 : 2
>  : ^

}
let d = Derived.create();
>d : Base
>  : ^^^^
>Derived.create() : Base
>                 : ^^^^
>Derived.create : () => Base
>               : ^^^^^^^^^^
>Derived : typeof Derived
>        : ^^^^^^^^^^^^^^
>create : () => Base
>       : ^^^^^^^^^^


d.foo();
>d.foo() : number
>        : ^^^^^^
>d.foo : () => number
>      : ^^^^^^^^^^^^
>d : Base
>  : ^^^^
>foo : () => number
>    : ^^^^^^^^^^^^


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


