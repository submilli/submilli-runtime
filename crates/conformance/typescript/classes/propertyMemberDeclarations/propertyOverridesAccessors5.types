=== propertyOverridesAccessors5.ts ===
class A {
>A : A
>  : ^

    get p(): string { return 'oh no' }
>p : string
>  : ^^^^^^
>'oh no' : "oh no"
>        : ^^^^^^^

}
class B extends A {
>B : B
>  : ^
>A : A
>  : ^

    constructor(public p: string) {
>p : string
>  : ^^^^^^

        super()
>super() : void
>        : ^^^^
>super : typeof A
>      : ^^^^^^^^

    }
}


function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


