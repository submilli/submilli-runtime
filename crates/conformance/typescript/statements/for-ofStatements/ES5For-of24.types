=== ES5For-of24.ts ===
let a = [1, 2, 3];
>a : number[]
>  : ^^^^^^^^
>[1, 2, 3] : number[]
>          : ^^^^^^^^
>1 : 1
>  : ^
>2 : 2
>  : ^
>3 : 3
>  : ^

for (let v of a) {
>v : number
>  : ^^^^^^
>a : number[]
>  : ^^^^^^^^

    let a = 0;
>a : number
>  : ^^^^^^
>0 : 0
>  : ^

}

function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


