=== ES5For-of25.ts ===
let a = [1, 2, 3];
>a : number[]
>  : ^^^^^^^^
>[1, 2, 3] : number[]
>          : ^^^^^^^^
>1 : 1
>  : ^
>2 : 2
>  : ^
>3 : 3
>  : ^

for (let v of a) {
>v : number
>  : ^^^^^^
>a : number[]
>  : ^^^^^^^^

    v;
>v : number
>  : ^^^^^^

    a;
>a : number[]
>  : ^^^^^^^^

}

function main(): void {}
>main : () => void
>     : ^^^^^^^^^^


