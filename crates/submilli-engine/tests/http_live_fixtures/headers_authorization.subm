// 200 from /requires-auth proves the Authorization header reached the server.

import { get, Response, Headers } from "submilli:http";

function main(): void {
  const h: Headers = new Map<string, string>();
  h.set("Authorization", "Bearer test-token");
  const r: Response = get("{{BASE}}/requires-auth", h);
  assert(r.status === 200, "header reached the server");
  assert(r.body === "authorized", "matched");
}
