function main(): void {
  const xs = Array.of(1, 2, 3);
  assert(xs.length === 3 && xs[0] === 1 && xs[2] === 3, "Array.of packs its arguments");

  const one = Array.of("only");
  assert(one.length === 1 && one[0] === "only", "single element");

  const none: number[] = Array.of();
  assert(none.length === 0, "no arguments gives an empty array");

  xs.push(4);
  assert(xs.length === 4, "the result is an ordinary mutable array");
}
