// ZonedDateTime#toInstant drops the tz, returns an Instant.

function main(): void {
  const z: Temporal.ZonedDateTime = Temporal.ZonedDateTime.from("2024-03-09T12:00:00+00:00[UTC]");
  const ts: Temporal.Instant = z.toInstant();
  assert(ts.epochMilliseconds === z.epochMilliseconds, "same epoch ms");
}
