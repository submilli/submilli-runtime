function main(): void {
  let bytes: Uint8Array = Uint8Array.new([256, 257, 511, 0]);
  assert(bytes.length === 4, "length preserved");
  assert(bytes[0] === 0, "256 → 0 (low 8 bits)");
  assert(bytes[1] === 1, "257 → 1");
  assert(bytes[2] === 255, "511 → 255");
  assert(bytes[3] === 0, "0 stays 0");
}
