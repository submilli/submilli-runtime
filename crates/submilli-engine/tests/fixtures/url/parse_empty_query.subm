import { parse, URL } from "submilli:url";

function main(): void {
  const u: URL = parse("https://example.com/v1/widgets");
  assert(u.query.size === 0, "absent query → empty Map");
  const v: string | undefined = u.query.get("foo");
  assert(v === undefined, "absent key returns undefined on empty Map");

  // verifies isolation — parse returns a fresh Map, not shared internal state
  u.query.set("added", "later");
  assert(u.query.size === 1, "Map is mutable after parse");
}
