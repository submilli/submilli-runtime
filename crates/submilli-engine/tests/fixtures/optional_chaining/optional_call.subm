type NumberFn = (x: number) => number;

function apply(f: NumberFn | null, v: number): number | undefined {
  return f?.(v);
}

function main(): void {
  const dbl = (x: number): number => x * 2;
  assert(apply(dbl, 5) === 10, "non-null closure call");
  assert(apply(null, 5) === undefined, "null closure short-circuits");
}
