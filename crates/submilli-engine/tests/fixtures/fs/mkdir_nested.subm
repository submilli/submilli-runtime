import { mkdir, writeText, exists } from "submilli:fs";

function main(): void {
  mkdir("/a/b/c", true);
  assert(exists("/a"), "intermediate /a created");
  assert(exists("/a/b"), "intermediate /a/b created");
  assert(exists("/a/b/c"), "leaf /a/b/c created");
  writeText("/a/b/c/note.txt", "hi");
  assert(exists("/a/b/c/note.txt"), "write into nested dir succeeds");
}
