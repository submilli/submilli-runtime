function classify(n: number): string {
  switch (n) {
    case 1: return "one";
    case 2: return "two";
    case 3: return "three";
    default: return "other";
  }
}

function main(): void {
  assert(classify(1) === "one", "case 1");
  assert(classify(2) === "two", "case 2");
  assert(classify(3) === "three", "case 3");
  assert(classify(99) === "other", "default");
}
