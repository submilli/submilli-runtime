// sha512 — string + Uint8Array inputs, RFC 6234 vectors.

import { sha512 } from "submilli:crypto";

function main(): void {
  assert(
    sha512("").toHex() === "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",
    "sha512 of empty string"
  );

  assert(
    sha512("abc").toHex() === "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
    "sha512 of \"abc\""
  );

  const abc_bytes: Uint8Array = Uint8Array.new([97, 98, 99]);
  assert(
    sha512(abc_bytes).equals(sha512("abc")),
    "sha512 of abc bytes === sha512 of \"abc\""
  );

  assert(sha512("abc").length === 64, "sha512 output is 64 bytes");
}
