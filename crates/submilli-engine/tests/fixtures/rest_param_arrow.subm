function main(): void {
  const sum = (...n: number[]): number => {
    let total = 0;
    let i = 0;
    while (i < n.length) {
      total = total + n[i];
      i = i + 1;
    }
    return total;
  };
  assert(sum() === 0, "arrow rest accepts zero args");
  assert(sum(1, 2, 3, 4) === 10, "arrow rest accumulates");
}
