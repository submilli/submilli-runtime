function main(): void {
  let a: Uint8Array = Uint8Array.new([1, 2, 3, 4, 5]);
  a.copyWithin(0, 3);
  assert(a[0] === 4 && a[1] === 5, "[0..]<-[3..] copies bytes 3,4 to positions 0,1");
  assert(a[2] === 3 && a[3] === 4 && a[4] === 5, "trailing bytes unchanged");

  let b: Uint8Array = Uint8Array.new([1, 2, 3, 4, 5]);
  b.copyWithin(1, 0, 3);
  assert(b[0] === 1 && b[1] === 1 && b[2] === 2 && b[3] === 3, "forward shift handles overlap");
  assert(b[4] === 5, "tail unchanged");

  let c: Uint8Array = Uint8Array.new([1, 2, 3, 4, 5]);
  c.copyWithin(0, 1, 4);
  assert(c[0] === 2 && c[1] === 3 && c[2] === 4, "backward shift handles overlap");
  assert(c[3] === 4 && c[4] === 5, "remainder unchanged");

  let d: Uint8Array = Uint8Array.new([1, 2, 3, 4, 5]);
  d.copyWithin(-2, 0, 2);
  assert(d[3] === 1 && d[4] === 2, "negative target counts from end");

  let e: Uint8Array = Uint8Array.new([1, 2, 3]);
  e.copyWithin(5, 0, 3);
  assert(e[0] === 1 && e[1] === 2 && e[2] === 3, "target past end is clamped to no-op");

  let f: Uint8Array = Uint8Array.new([1, 2, 3]);
  assert(f.copyWithin(0, 0).equals(f), "returns this");
}
