function main(): void {
  const bytes: Uint8Array = new Uint8Array([10, 20, 30]);
  assert(bytes.length === 3, "new constructs the right length");
  assert(bytes[0] === 10, "byte 0");
  assert(bytes[1] === 20, "byte 1");
  assert(bytes[2] === 30, "byte 2");

  const zeros: Uint8Array = Uint8Array.alloc(5);
  assert(zeros.length === 5, "alloc still works alongside new");
  assert(zeros[2] === 0, "alloc zero-fills");
}
