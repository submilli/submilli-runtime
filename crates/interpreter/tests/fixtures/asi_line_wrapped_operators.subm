function main(): void {
  const x =
    5;
  assert(x === 5, "trailing =");

  const sum = 1 +
    2 +
    3;
  assert(sum === 6, "trailing + chain");

  let y = 0;
  y =
    10;
  assert(y === 10, "trailing = reassign");

  y +=
    5;
  assert(y === 15, "trailing compound assign");

  const both = true &&
    true;
  assert(both, "trailing &&");

  const cond = true;
  const ternaryLeading = cond
    ? 1
    : 2;
  assert(ternaryLeading === 1, "leading ? and :");

  const ternaryTrailing = cond ?
    3 :
    4;
  assert(ternaryTrailing === 3, "trailing ? and :");
}
