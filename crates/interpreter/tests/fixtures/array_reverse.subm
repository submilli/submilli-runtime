function main(): void {
  let odd: number[] = [1, 2, 3, 4, 5];
  let r1 = odd.reverse();
  assert(r1.length === 5, "reverse preserves length");
  assert(odd[0] === 5 && odd[1] === 4 && odd[2] === 3 && odd[3] === 2 && odd[4] === 1,
         "reverse mutates receiver");
  assert(r1[0] === 5, "reverse returns receiver (same content)");

  let even: number[] = [1, 2, 3, 4];
  even.reverse();
  assert(even[0] === 4 && even[1] === 3 && even[2] === 2 && even[3] === 1,
         "even length reversed");

  let one: number[] = [42];
  one.reverse();
  assert(one[0] === 42, "single element");

  let empty: number[] = [];
  empty.reverse();
  assert(empty.length === 0, "empty");
}
