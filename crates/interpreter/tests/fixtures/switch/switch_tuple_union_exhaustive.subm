
function evaluate(t: ["add", number, number] | ["mul", number, number] | ["sub", number, number]): number {
  switch (t[0]) {
    case "add": return t[1] + t[2];
    case "mul": return t[1] * t[2];
    case "sub": return t[1] - t[2];
  }
}

function main(): void {
  const add: ["add", number, number] = ["add", 5, 3];
  const mul: ["mul", number, number] = ["mul", 5, 3];
  const sub: ["sub", number, number] = ["sub", 5, 3];
  assert(evaluate(add) === 8, "add");
  assert(evaluate(mul) === 15, "mul");
  assert(evaluate(sub) === 2, "sub");
}
