
function main(): void {
  let bytes: Uint8Array = Uint8Array.fromArray([1, 2, 3, 256]);
  assert(bytes.length === 4, "fromArray preserves length");
  assert(bytes[0] === 1 && bytes[1] === 2 && bytes[2] === 3, "values copied");
  assert(bytes[3] === 0, "256 truncates to 0");

  let empty: Uint8Array = Uint8Array.fromArray([]);
  assert(empty.length === 0, "fromArray on []");
}
