function main(): void {
  let a: number[] = [1, 2, 3, 4, 5];
  let r = a.copyWithin(0, 3);
  assert(a[0] === 4 && a[1] === 5 && a[2] === 3 && a[3] === 4 && a[4] === 5, "copies tail to front");
  assert(r.length === 5, "returns the mutated array");

  let b: number[] = [1, 2, 3, 4, 5];
  b.copyWithin(1, 3, 4);
  assert(b[0] === 1 && b[1] === 4 && b[2] === 3 && b[3] === 4 && b[4] === 5, "end bounds the copy");

  let c: number[] = [1, 2, 3, 4, 5];
  c.copyWithin(-2, 0, 2);
  assert(c[0] === 1 && c[1] === 2 && c[2] === 3 && c[3] === 1 && c[4] === 2, "negative target counts from end");

  let d: number[] = [1, 2, 3, 4, 5];
  d.copyWithin(1, 0, 4);
  assert(d[0] === 1 && d[1] === 1 && d[2] === 2 && d[3] === 3 && d[4] === 4, "overlapping copy preserves source order");
}
