// `l?.log()` where `log` returns `void` is a `void` expression (no value), and
// binding it is rejected at the typechecker rather than reaching codegen.
//
// Two spellings, two diagnostics, both naming the same fix. With the
// nonsensical `void | null` annotation the *annotation* is refused first,
// because `void` cannot be a union member. Without one, the binding itself is.
// expect-error: `void` cannot be a union member — it has no values
// expect-error: cannot bind a `void` value
interface Logger {
  log(msg: string): void;
}

function main(): void {
  const l: Logger | null = null as Logger | null;
  const annotated: void | null = l?.log("hello");
  const inferred = l?.log("hello");
}
