function street(addr: { home: { street: string } } | null): string | null {
  return addr?.home.street;
}

function main(): void {
  const present: { home: { street: string } } = { home: { street: "Main" } };
  assert(street(present) === "Main", "non-null reads through whole chain");
  assert(street(null) === null, "null receiver short-circuits everything");
}
