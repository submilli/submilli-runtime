// expect-error: expected `Logger`
// A structural object *value* is not assignable to a method-bearing interface:
// the object has no vtable, so a later method call would trap. Only data-only
// (method-free) interfaces participate in structural assignability.
interface Logger { log(msg: string): void; }

function main(): void {
  const t: { log: (msg: string) => void } = { log: (m: string): void => { } };
  const l: Logger = t;
  const _ = l;
}
