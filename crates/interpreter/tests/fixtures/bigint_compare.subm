function main(): void {
  assert(1n < 2n, "1 < 2");
  assert(2n > 1n, "2 > 1");
  assert(1n <= 1n, "1 <= 1");
  assert(1n >= 1n, "1 >= 1");
  assert(1n === 1n, "1 === 1");
  assert(1n !== 2n, "1 !== 2");

  let big1: bigint = 12345678901234567890n;
  let big2: bigint = 12345678901234567891n;
  assert(big1 < big2, "big1 < big2");
  assert(big2 > big1, "big2 > big1");
  assert(big1 === big1, "big1 self-eq");
  assert(big1 !== big2, "big1 !== big2");

  assert(-1n < 1n, "-1 < 1");
  assert(-1n < 0n, "-1 < 0");
  assert(0n < 1n, "0 < 1");
  assert(-100n < -50n, "-100 < -50");
}
