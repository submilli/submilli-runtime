function main(): void {
  let bytes: Uint8Array = Uint8Array.new([0, 1, 2, 255]);
  assert(bytes.length === 4, "new preserves the source length");
  assert(bytes[0] === 0, "byte 0");
  assert(bytes[1] === 1, "byte 1");
  assert(bytes[2] === 2, "byte 2");
  assert(bytes[3] === 255, "byte 3 (boundary value)");
}
