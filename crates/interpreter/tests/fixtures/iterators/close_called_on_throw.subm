let closed: boolean = false;

function tick(i: number, n: number): IteratorResult<number> {
  if (i >= n) { const r: IteratorResult<number> = { done: true }; return r; }
  const y: IteratorResult<number> = { done: false, value: i }; return y;
}

function range(n: number): Iterator<number> {
  let i = 0;
  const it: Iterator<number> = { next: (): IteratorResult<number> => { const r = tick(i, n); i = i + 1; return r; }, close: (): void => { closed = true; } };
  return it;
}

function main(): void {
  let caught: string = "<none>";
  try {
    for (const x of range(10)) {
      if (x === 1) { throw new Error("boom"); }
    }
  } catch (e: Error) {
    caught = e.message;
  }
  assert(caught === "boom", "outer catch caught the throw");
  assert(closed === true, "finally ran close before the throw propagated");
}
