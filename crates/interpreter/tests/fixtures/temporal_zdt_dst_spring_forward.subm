function main(): void {
  const before: Temporal.ZonedDateTime = Temporal.ZonedDateTime.from("2024-03-10T01:30:00-05:00[America/New_York]");
  const oneHour: Temporal.Duration = Temporal.Duration.from("PT1H");
  const after: Temporal.ZonedDateTime = before.add(oneHour);
  assert(after.hour === 3, "skipped 2am DST gap, lands at 3am");
  assert(after.day === 10, "same calendar day");
}
