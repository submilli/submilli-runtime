enum Status { Active = "active", Inactive = "inactive" }

function main(): void {
  assert(Status.Active === Status.Active, "string-enum self-equality");
  assert(Status.Active.toString() === "active", "Active stringifies to 'active'");
  assert(Status.Inactive.toString() === "inactive", "Inactive stringifies to 'inactive'");
  console.log(Status.Active.toString());
}
