function main(): void {
  const cap: RegExp = new RegExp("(?<user>\\w+)@(?<host>\\w+)", "");
  const m: RegExpExecArray | null = cap.exec("alice@example.com");
  assert(m !== null, "match found");
  if (m !== null) {
    assert(m[0] === "alice@example", "full match (no trailing .com — \\w doesn't span `.`)");
    // Snapshot before assert() calls (which invalidate narrowing).
    const groups = m.groups;
    if (groups === undefined) { throw new Error("missing named groups"); }
    assert(groups["user"] === "alice", "user named capture");
    assert(groups["host"] === "example", "host named capture");
  }

  const numbered: RegExp = new RegExp("(\\w+)", "");
  const m2: RegExpExecArray | null = numbered.exec("hello");
  assert(m2 !== null, "match found");
  if (m2 !== null) {
    const ng = m2.groups;
    assert(ng === undefined, "no named captures → empty map");
  }
}
