// sha256 — string and Uint8Array inputs match; hex output

import { sha256 } from "submilli:crypto";

function main(): void {
  assert(
    sha256("").toHex() === "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "sha256 of empty string"
  );

  assert(
    sha256("abc").toHex() === "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    "sha256 of \"abc\""
  );

  assert(
    sha256("hello").toHex() === "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
    "sha256 of \"hello\""
  );

  const abc_bytes: Uint8Array = Uint8Array.new([97, 98, 99]);
  assert(
    sha256(abc_bytes).toHex() === "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    "sha256 of abc bytes matches string form"
  );

  const empty_bytes: Uint8Array = Uint8Array.alloc(0);
  assert(
    sha256(empty_bytes).equals(sha256("")),
    "sha256 of empty bytes === sha256 of empty string"
  );

  assert(sha256("abc").length === 32, "sha256 output is 32 bytes");
}
