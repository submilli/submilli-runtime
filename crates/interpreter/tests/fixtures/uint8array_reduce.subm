function main(): void {
  let bytes: Uint8Array = Uint8Array.new([1, 2, 3, 4]);

  let sum: number = bytes.reduce<number>((acc: number, v: number) => acc + v, 0);
  assert(sum === 10, "reduce sums");

  let with_seed: number = bytes.reduce<number>((acc: number, v: number) => acc + v, 100);
  assert(with_seed === 110, "reduce uses initial");

  let left: string = bytes.reduce<string>((acc: string, v: number) => acc + v.toString(), "");
  let right: string = bytes.reduceRight<string>((acc: string, v: number) => acc + v.toString(), "");
  assert(left === "1234", "reduce left-to-right order");
  assert(right === "4321", "reduceRight right-to-left order");

  let empty: Uint8Array = Uint8Array.alloc(0);
  let unchanged: number = empty.reduce<number>((acc: number, v: number) => acc + v, 42);
  assert(unchanged === 42, "reduce on empty returns initial");
}
