function main(): void {
  const m = new Map<number, number>();
  let i: number = 0;
  while (i < 100) {
    m.set(i, i * 10);
    i = i + 1;
  }
  assert(m.size === 100, "100 inserts brings size to 100");

  i = 0;
  while (i < 100) {
    const v: number | undefined = m.get(i);
    assert(v !== undefined && v === i * 10, "get round-trips after resize");
    i = i + 1;
  }

  assert(m.get(100) === undefined, "absent key still returns undefined");
  assert(m.get(-1) === undefined, "neg absent key still undefined");
}
