function main(): void {
  const s = new Set<string>();
  s.add("a");
  s.add("b");
  s.add("c");
  s.add("d");
  s.add("e");

  assert(s.delete("b"), "delete b");
  assert(s.delete("d"), "delete d");
  assert(s.size === 3, "size drops to 3");

  let vs: string[] = [];

  for (const __vs of s.values()) {

    vs.push(__vs);

  }
  assert(vs.length === 3, "3 values after deletes");
  assert(vs[0] === "a", "vs[0] = a");
  assert(vs[1] === "c", "vs[1] = c");
  assert(vs[2] === "e", "vs[2] = e");

  s.add("b");
  let vs2: string[] = [];
  for (const __vs2 of s.values()) {
    vs2.push(__vs2);
  }
  assert(vs2.length === 4, "4 values after re-add");
  assert(vs2[0] === "a", "a still first");
  assert(vs2[1] === "c", "c still second");
  assert(vs2[2] === "e", "e still third");
  assert(vs2[3] === "b", "b appended at the end");

  let seen: string = "";
  for (const v of s) {
    seen = seen + v;
  }
  assert(seen === "aceb", "for-of yields a, c, e, b");
}
