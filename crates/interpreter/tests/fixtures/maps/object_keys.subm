// Map<object, T>: two object literals with identical field values must hash equal and compare equal.

function main(): void {
  const m = new Map<{ x: number, y: number }, string>();
  m.set({ x: 1, y: 2 }, "first");
  m.set({ x: 3, y: 4 }, "second");
  m.set({ x: 5, y: 6 }, "third");
  assert(m.size === 3, "three distinct keys");

  const a: string | undefined = m.get({ x: 1, y: 2 });
  assert(a !== undefined && a === "first", "structurally-equal key hits");
  const b: string | undefined = m.get({ x: 3, y: 4 });
  assert(b !== undefined && b === "second", "second key hits");
  const c: string | undefined = m.get({ x: 5, y: 6 });
  assert(c !== undefined && c === "third", "third key hits");

  const miss: string | undefined = m.get({ x: 1, y: 99 });
  assert(miss === undefined, "different field values miss");

  m.set({ x: 1, y: 2 }, "updated");
  assert(m.size === 3, "overwrite leaves size at 3");
  const updated: string | undefined = m.get({ x: 1, y: 2 });
  assert(updated !== undefined && updated === "updated", "overwrite via equal-shape key");
}
