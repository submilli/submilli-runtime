// Map<string, number>: set / get / has / delete / size / clear.

function main(): void {
  const m = new Map<string, number>();
  assert(m.size === 0, "fresh map is empty");

  m.set("a", 1);
  m.set("b", 2);
  m.set("c", 3);
  assert(m.size === 3, "three sets bring size to 3");

  const a: number | null = m.get("a");
  const b: number | null = m.get("b");
  const c: number | null = m.get("c");
  assert(a !== null && a === 1, "get(a) returns 1");
  assert(b !== null && b === 2, "get(b) returns 2");
  assert(c !== null && c === 3, "get(c) returns 3");

  const missing: number | null = m.get("z");
  assert(missing === null, "get(missing) returns null");

  assert(m.has("a"), "has(a) reports true");
  assert(!m.has("z"), "has(missing) reports false");

  m.set("a", 10);
  const a2: number | null = m.get("a");
  assert(a2 !== null && a2 === 10, "overwrite updates value");
  assert(m.size === 3, "overwrite leaves size unchanged");

  const removed: boolean = m.delete("b");
  assert(removed, "delete returns true for present key");
  assert(m.size === 2, "size drops to 2 after delete");
  assert(!m.has("b"), "deleted key no longer present");
  assert(m.get("b") === null, "deleted key gets null");

  const removedAgain: boolean = m.delete("b");
  assert(!removedAgain, "delete returns false for absent key");
  assert(m.size === 2, "absent-delete leaves size unchanged");

  m.clear();
  assert(m.size === 0, "clear resets size");
  assert(!m.has("a"), "clear removes all entries");
  assert(m.get("a") === null, "clear returns null for all keys");
}
