function main(): void {
  const a: { id: number, nickname?: string } = { id: 1 };
  assert(a.id === 1, "required field populated");
  assert(a.nickname === undefined, "omitted optional reads as undefined");

  const b: { id: number, nickname?: string } = { id: 2, nickname: "alice" };
  assert(b.id === 2, "required field populated");
  assert(b.nickname !== undefined, "present optional is defined");

  const c: { x?: number, y?: number } = {};
  assert(c.x === undefined, "inline optional x omitted");
  assert(c.y === undefined, "inline optional y omitted");

  // exercises the leading-comma path in JSON.stringify's first_local logic
  const d: { x?: number, y?: number } = { y: 7 };
  assert(d.x === undefined, "inline optional x omitted");
  assert(d.y !== undefined, "inline optional y present");
}
