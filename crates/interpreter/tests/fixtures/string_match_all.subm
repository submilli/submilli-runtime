function main(): void {
  const re: RegExp = new RegExp("[0-9]+", "g");
  const matches: RegExpExecArray[] = Array.from("a1b22c333".matchAll(re));
  assert(matches.length === 3, "three matches");
  assert(matches[0][0] === "1", "first match");
  assert(matches[0].index === 1, "first match index");
  assert(matches[1][0] === "22", "second match");
  assert(matches[1].index === 3, "second match index");
  assert(matches[2][0] === "333", "third match");
  assert(matches[2].index === 6, "third match index");

  const none: RegExpExecArray[] = Array.from("no digits".matchAll(re));
  assert(none.length === 0, "empty array on no-match");

  const a: RegExp = new RegExp("a", "g");
  const aMatches: RegExpExecArray[] = Array.from("aaa".matchAll(a));
  assert(aMatches.length === 3, "three a matches");
}
