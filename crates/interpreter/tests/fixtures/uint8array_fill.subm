function main(): void {
  let bytes: Uint8Array = Uint8Array.alloc(5);

  bytes.fill(7);
  assert(bytes[0] === 7 && bytes[4] === 7, "default fills entire array");

  bytes.fill(0);
  bytes.fill(9, 1, 3);
  assert(bytes[0] === 0, "before range untouched");
  assert(bytes[1] === 9 && bytes[2] === 9, "in range");
  assert(bytes[3] === 0 && bytes[4] === 0, "after range untouched");

  bytes.fill(0);
  bytes.fill(3, 0, -1);
  assert(bytes[0] === 3 && bytes[3] === 3 && bytes[4] === 0, "negative end stops before last");

  let returned: Uint8Array = bytes.fill(0);
  assert(returned.equals(bytes), "fill returns this");

  bytes.fill(256);
  assert(bytes[0] === 0, "256 truncates to 0");

  bytes.fill(0);
  bytes.fill(5, 3, 1);
  assert(bytes[2] === 0 && bytes[3] === 0, "inverted range no-op");
}
