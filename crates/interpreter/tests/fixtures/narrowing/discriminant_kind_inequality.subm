function describe(
  s: { kind: "circle"; radius: number }
   | { kind: "rect"; height: number; width: number }
): number {
  if (s.kind !== "circle") {
    return s.height * s.width;
  }
  return s.radius;
}

function main(): void {
  const c: { kind: "circle"; radius: number } = { kind: "circle", radius: 3 };
  assert(describe(c) === 3, "circle: !== false branch reads .radius");

  const r: { kind: "rect"; height: number; width: number } = { kind: "rect", height: 4, width: 5 };
  assert(describe(r) === 20, "rect: !== true branch reads .height * .width");
}
