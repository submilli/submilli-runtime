// expect-error: cannot read field `len` on non-object type `null`
// expect-error: was dropped by the write

function f(obj: { foo: { len: number } | null }): number {
  if (obj.foo !== null) {
    obj.foo = null;
    return obj.foo.len;
  }
  return 0;
}

function main(): void {
  assert(f({ foo: { len: 5 } }) === 5);
}
