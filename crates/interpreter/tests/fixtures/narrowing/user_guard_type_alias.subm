// Type guard where asserted type and parameter type both resolve through type aliases.

type Circle = { kind: "circle"; radius: number };
type Rectangle = { kind: "rect"; height: number; width: number };
type Shape = Circle | Rectangle;

function isCircle(s: Shape): s is Circle {
  return s.kind === "circle";
}

function area(s: Shape): number {
  if (isCircle(s)) {
    return s.radius;
  }
  return s.height * s.width;
}

function main(): void {
  const c: Circle = { kind: "circle", radius: 7 };
  assert(area(c) === 7, "circle: alias narrowing in then-branch");

  const r: Rectangle = { kind: "rect", height: 4, width: 5 };
  assert(area(r) === 20, "rect: residual narrowing in else-branch");
}
