function classify(x: number | string | null): number {
  if (typeof x === "number") {
    return x;
  } else {
    if (x === null) {
      return -1;
    } else {
      return x.length;
    }
  }
}

function main(): void {
  assert(classify(5) === 5, "number passes through");
  assert(classify(0) === 0, "zero");
  assert(classify(null) === -1, "null sentinel");
  assert(classify("hello") === 5, "string narrows to use .length");
  assert(classify("") === 0, "empty string");
}
