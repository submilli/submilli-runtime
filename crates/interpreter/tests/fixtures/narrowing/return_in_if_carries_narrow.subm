
function len_after_return_guard(x: string | null): number {
  if (x === null) {
    return -1;
  }
  return x.length;
}

function main(): void {
  assert(len_after_return_guard("hello") === 5, "non-null narrows via return-guard");
  assert(len_after_return_guard("") === 0, "empty string");
  assert(len_after_return_guard(null) === -1, "null sentinel");
}
