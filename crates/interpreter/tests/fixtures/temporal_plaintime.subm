function main(): void {
  const t = Temporal.PlainTime.from("10:30:45");
  assert(t.hour === 10, "hour");
  assert(t.minute === 30, "minute");
  assert(t.second === 45, "second");
  assert(t.nanosecond === 0, "nanosecond");
  assert(t.toString() === "10:30:45", "toString");

  assert(t.equals(Temporal.PlainTime.from("10:30:45")), "equal times");
  assert(!t.equals(Temporal.PlainTime.from("10:30:46")), "unequal times");
}
