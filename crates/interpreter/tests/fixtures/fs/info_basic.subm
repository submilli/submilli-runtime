import { info, Info } from "submilli:fs";

function main(): void {
  const fs = info();
  // The fixture harness backs the VFS with a temp directory (ephemeral mode)
  // and sets no limit, so it reports the -1 "not applicable" sentinel.
  assert(fs.mode === "ephemeral", "fixture VFS runs in ephemeral mode");
  assert(fs.sizeLimit === -1, "no size limit configured");
  assert(fs.access === "read_write", "the root is writable");
  assert(fs.volume === "", "no named volume backs the root");
  assert(fs.mounts.length === 0, "no volumes are mounted");
}
