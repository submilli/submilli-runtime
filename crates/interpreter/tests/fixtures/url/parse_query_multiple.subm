import { parse, URL } from "submilli:url";

function main(): void {
  const u: URL = parse("https://api.example.com/v1/search?q=widget&category=tools&limit=50&page=2&sort=relevance");
  assert(u.query.size === 5, "five query params");

  const q: string | null = u.query.get("q");
  assert(q !== null && q === "widget", "q");
  const cat: string | null = u.query.get("category");
  assert(cat !== null && cat === "tools", "category");
  const limit: string | null = u.query.get("limit");
  assert(limit !== null && limit === "50", "limit");
  const page: string | null = u.query.get("page");
  assert(page !== null && page === "2", "page");
  const sort: string | null = u.query.get("sort");
  assert(sort !== null && sort === "relevance", "sort");

  const v: URL = parse("https://example.com/?tag=a&tag=b&tag=c");
  assert(v.query.size === 1, "repeated key collapses to one entry");
  const tag: string | null = v.query.get("tag");
  assert(tag !== null && tag === "c", "last value wins");
}
