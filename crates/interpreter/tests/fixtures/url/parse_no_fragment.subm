import { parse, URL } from "submilli:url";

function main(): void {
  const a: URL = parse("https://example.com/path?status=ok");
  assert(a.fragment === null, "fragment is null when no `#`");
  assert(a.query.size === 1, "query still parsed");

  const b: URL = parse("https://example.com/path#section");
  assert(b.fragment !== null, "fragment present");
  if (b.fragment !== null) {
    assert(b.fragment === "section", "fragment value");
  }
}
