import { parse, URL } from "submilli:url";

function main(): void {
  const url: URL = parse("https://api.acme.com:8443/v1/orders?status=paid&limit=10#section");

  assert(url.protocol === "https", "protocol");
  assert(url.host === "api.acme.com", "host");
  assert(url.path === "/v1/orders", "path");

  const port: number | undefined = url.port;
  assert(port !== undefined, "port present");
  if (port !== undefined) {
    assert(port === 8443, "port value");
  }

  const fragment: string | undefined = url.fragment;
  assert(fragment !== undefined, "fragment present");
  if (fragment !== undefined) {
    assert(fragment === "section", "fragment value");
  }

  const query: Map<string, string> = url.query;
  assert(query.size === 2, "two query params");
  const status: string | undefined = query.get("status");
  assert(status !== undefined && status === "paid", "status=paid");
  const limit: string | undefined = query.get("limit");
  assert(limit !== undefined && limit === "10", "limit=10");
}
