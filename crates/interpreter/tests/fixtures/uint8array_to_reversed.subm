function main(): void {
  let bytes: Uint8Array = Uint8Array.new([1, 2, 3, 4]);
  let rev: Uint8Array = bytes.toReversed();

  assert(rev.length === 4, "length preserved");
  assert(rev[0] === 4 && rev[1] === 3 && rev[2] === 2 && rev[3] === 1, "reversed");
  assert(bytes[0] === 1 && bytes[3] === 4, "source unchanged");

  let empty: Uint8Array = Uint8Array.alloc(0);
  let empty_rev: Uint8Array = empty.toReversed();
  assert(empty_rev.length === 0, "empty toReversed");
}
