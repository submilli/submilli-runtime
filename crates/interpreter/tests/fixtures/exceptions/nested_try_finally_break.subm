let counter: number = 0;

function main(): void {
  let i: number = 0;
  while (i < 5) {
    try {
      try {
        break;
      } finally {
        counter = counter + 1;
      }
    } finally {
      counter = counter * 10;
    }
    i = i + 1; // never reached
  }
  assert(counter === 10, "both finallys ran on break, innermost first");
}
