function main(): void {
  const s = new Set<string>();
  s.add("x");
  s.add("y");
  s.add("z");

  let keys: string[] = [];

  for (const __keys of s.keys()) {

    keys.push(__keys);

  }
  let values: string[] = [];
  for (const __values of s.values()) {
    values.push(__values);
  }
  assert(keys.length === 3, "keys has every element");
  assert(keys[0] === values[0] && keys[1] === values[1] && keys[2] === values[2], "keys aliases values");

  let entries: [string, string][] = [];

  for (const __entries of s.entries()) {

    entries.push(__entries);

  }
  assert(entries.length === 3, "entries has every element");
  assert(entries[0][0] === "x" && entries[0][1] === "x", "entry pairs repeat the element");
  assert(entries[2][0] === "z", "entries follow insertion order");

  let seen: string = "";
  s.forEach((value: string): void => {
    seen = seen + value;
  });
  assert(seen === "xyz", "forEach visits in insertion order");

  s.delete("y");
  let after: string = "";
  s.forEach((value: string): void => {
    after = after + value;
  });
  assert(after === "xz", "deleted elements are skipped");
}
