function main(): void {
  let xs: number[] = [1, 2, 3];

  xs[0] = 9;
  assert(xs[0] === 9, "index assignment writes element");
  assert(xs[1] === 2, "index assignment preserves other elements");

  xs[1]++;
  assert(xs[1] === 3, "xs[1] incremented");
  xs[2]--;
  assert(xs[2] === 2, "xs[2] decremented");

  let orig: number = xs[0]++;
  assert(orig === 9, "expr-position yields original");
  assert(xs[0] === 10, "xs[0] still increments");
}
