function main(): void {
  let a: number[] = [1, 2, 3, 4];
  let removed = a.splice(1, 2);
  assert(removed.length === 2 && removed[0] === 2 && removed[1] === 3, "returns the removed span");
  assert(a.length === 2 && a[0] === 1 && a[1] === 4, "receiver shrinks in place");

  let b: number[] = [1, 4];
  let none = b.splice(1, 0, 9);
  assert(none.length === 0, "pure insertion removes nothing");
  assert(b.length === 3 && b[0] === 1 && b[1] === 9 && b[2] === 4, "item inserted at start index");

  let c: number[] = [1, 9, 4];
  c.splice(0, 1, 5, 6);
  assert(c.length === 4 && c[0] === 5 && c[1] === 6 && c[2] === 9 && c[3] === 4, "replacement can grow the array");

  let d: number[] = [1, 2, 3];
  let tail = d.splice(1);
  assert(tail.length === 2 && tail[0] === 2 && tail[1] === 3, "omitted deleteCount removes to the end");
  assert(d.length === 1 && d[0] === 1, "receiver keeps only the prefix");

  let e: number[] = [1, 2, 3];
  e.splice(-2, 1);
  assert(e.length === 2 && e[0] === 1 && e[1] === 3, "negative start counts from end");
}
