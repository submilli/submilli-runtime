interface LinearIssue {
  id: string;
  title: string;
  state: string;
}

interface LinearIssueWithIdentifier {
  completedAt: string | null;
  createdAt: string;
  id: string;
  identifier: string;
  state: string;
  title: string;
}

interface ListIssuesResponse {
  hasNextPage: boolean;
  issues: LinearIssue[];
}

interface Assigned {
  owner: { id: string; name: string; email: string; role: string };
}

interface OptionalTitle {
  id: string;
  title?: string;
}

interface ListNodesResponse {
  hasNextPage: boolean;
  nodes: LinearIssue[];
}

function expectMessage(thunk: () => void): string {
  try {
    thunk();
  } catch (e: Error) {
    return e.message;
  }
  assert(false, "expected JSON.parse(... ) as T to throw");
  return "";
}

function main(): void {
  const objectAsArray = expectMessage((): void => {
    const issues = JSON.parse("{\"hasNextPage\":false,\"issues\":[]}") as LinearIssue[];
  });
  assert(objectAsArray === "type mismatch: expected LinearIssue[], got object", objectAsArray);

  const nestedMissing = expectMessage((): void => {
    const response = JSON.parse(
      "{\"hasNextPage\":false,\"issues\":[{\"id\":\"SUB-1\",\"title\":\"x\",\"status\":\"Done\",\"statusType\":\"completed\"}]}"
    ) as ListIssuesResponse;
  });
  assert(nestedMissing === "type mismatch: expected ListIssuesResponse, got object at $[\"issues\"][0][\"state\"] (expected string, got undefined)", nestedMissing);

  const multiMissingRoot = expectMessage((): void => {
    const issue = JSON.parse(
      "{\"completedAt\":null,\"createdAt\":\"2026-06-09\",\"id\":\"SUB-1\",\"status\":\"Done\",\"statusType\":\"completed\",\"title\":\"x\"}"
    ) as LinearIssueWithIdentifier;
  });
  assert(
    multiMissingRoot === "type mismatch: expected LinearIssueWithIdentifier, got object at $[\"identifier\"] (expected string, got undefined)",
    multiMissingRoot
  );

  const shapeRename = expectMessage((): void => {
    const response = JSON.parse(
      "{\"hasNextPage\":false,\"issues\":[]}"
    ) as ListNodesResponse;
  });
  assert(shapeRename === "type mismatch: expected ListNodesResponse, got object at $[\"nodes\"] (expected LinearIssue[], got undefined)", shapeRename);

  const indexed = expectMessage((): void => {
    const nums = JSON.parse("[1,\"two\",3]") as number[];
  });
  assert(indexed === "type mismatch: expected number[], got array at $[1] (expected number, got string)", indexed);

  // An optional field accepts a missing key but not JSON null, so the message
  // says how to accept it. A missing key (above) gets no such advice.
  const nullField = expectMessage((): void => {
    const issue = JSON.parse("{\"id\":\"SUB-1\",\"title\":null}") as OptionalTitle;
  });
  assert(
    nullField === "type mismatch: expected OptionalTitle, got object at $[\"title\"] (expected string, got null) — if null is valid there, add `| null` to the expected type",
    nullField
  );

  // The advice points at the element's expected type, which the message names.
  const nullElement = expectMessage((): void => {
    const nums = JSON.parse("[1,null]") as number[];
  });
  assert(
    nullElement === "type mismatch: expected number[], got array at $[1] (expected number, got null) — if null is valid there, add `| null` to the expected type",
    nullElement
  );

  // A long type is named only by its kind, which the advice doesn't repeat.
  const nullObject = expectMessage((): void => {
    const assigned = JSON.parse("{\"owner\":null}") as Assigned;
  });
  assert(
    nullObject === "type mismatch: expected Assigned, got object at $[\"owner\"] (expected an object, got null) — if null is valid there, add `| null` to the expected type",
    nullObject
  );
}
