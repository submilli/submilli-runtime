function main(): void {
  const a = JSON.parse("{\"id\":1}") as { id: number; deletedAt?: string };
  assert(a.id === 1, "id parsed");
  assert(a.deletedAt === null, "omitted optional reads as null");

  const b = JSON.parse(
    "{\"id\":2,\"deletedAt\":\"2025-01-01\"}"
  ) as { id: number; deletedAt?: string };
  assert(b.id === 2, "id parsed");
  assert(b.deletedAt !== null, "present optional is non-null");

  const c = JSON.parse(
    "{\"c\":5,\"b\":7}"
  ) as { a?: number; b?: number; c: number };
  assert(c.c === 5, "required c parsed");
  assert(c.a === null, "omitted a stays null");
  assert(c.b !== null, "present b is non-null");
}
