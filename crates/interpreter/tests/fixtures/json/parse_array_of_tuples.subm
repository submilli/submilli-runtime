function main(): void {
  const xs = JSON.parse("[[\"a\",1],[\"b\",2],[\"c\",3]]") as [string, number][];
  assert(xs.length === 3, "length");
  assert(xs[0][0] === "a", "xs[0][0]");
  assert(xs[0][1] === 1, "xs[0][1]");
  assert(xs[2][0] === "c", "xs[2][0]");
  assert(xs[2][1] === 3, "xs[2][1]");
}
