// Inline annotations rather than a type alias — `intersect_with` doesn't peel through
// `Type::Alias` for `typeof`-based folding, so the bare-union form keeps narrowing live.

function main(): void {
  const a = JSON.parse("42") as number | { kind: "circle", r: number } | { kind: "rect", w: number, h: number } | null;
  if (typeof a === "number") {
    assert(a === 42, "number bucket");
  } else {
    assert(false, "expected number");
  }

  const b = JSON.parse("null") as number | { kind: "circle", r: number } | { kind: "rect", w: number, h: number } | null;
  assert(b === null, "null bucket");

  const c = JSON.parse("{\"kind\":\"circle\",\"r\":3}") as number | { kind: "circle", r: number } | { kind: "rect", w: number, h: number } | null;
  assert(c !== null, "object branch produced a non-null value");
  if (typeof c === "number") {
    assert(false, "object should not be number");
  }
}
