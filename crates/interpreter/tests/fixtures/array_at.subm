function main(): void {
  let arr: number[] = [10, 20, 30, 40, 50];

  let mid = arr.at(2);
  if (mid !== undefined) {
    assert(mid === 30, "at(2) returns the third element");
  } else {
    assert(false, "at(2) should not be undefined");
  }

  let last = arr.at(-1);
  if (last !== undefined) {
    assert(last === 50, "at(-1) returns the last element");
  } else {
    assert(false, "at(-1) should not be undefined");
  }

  let first = arr.at(-5);
  if (first !== undefined) {
    assert(first === 10, "at(-len) returns the first element");
  }

  let beyond = arr.at(100);
  assert(beyond === undefined, "at(100) on len=5 array returns undefined");

  let below = arr.at(-100);
  assert(below === undefined, "at(-100) on len=5 array returns undefined");

  let edgeHigh = arr.at(5);
  assert(edgeHigh === undefined, "at(len) is OOB and returns undefined");
}
