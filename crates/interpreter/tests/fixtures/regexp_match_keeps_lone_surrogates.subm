// A RegExpMatch holds the input's code units, so a lone surrogate in the match
// or a capture survives.
function hex(s: string): string {
  const out: string[] = [];
  for (let i = 0; i < s.length; i++) {
    out.push(s.charCodeAt(i).toString(16));
  }
  return out.join(" ");
}

function main(): void {
  const lone = "a" + String.fromCharCode(0xd800) + "b";
  const found = /a(.)b/.exec(lone);
  assert(found !== null, "matches");
  if (found === null) {
    return;
  }
  assert(hex(found.match) === "61 d800 62", "the match keeps it");
  const capture = found.groups[0];
  assert(capture !== undefined && hex(capture) === "d800", "the capture keeps it");
}
