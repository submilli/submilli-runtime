// `Response#json<T>()` parses the body and checks it against `T`.
// End-to-end sibling of json_body.subm.

import { get, Response } from "submilli:http";

function main(): void {
  const r: Response = get("{{BASE}}/json");
  assert(r.status === 200, "json route ok");

  const cast = r.json<{ hello: string }>();
  assert(cast.hello === "world", "the type argument checks the body");
}
