help: /**
 * Returns the index of the first element equal to `elem` at or after `fromIndex`, or `-1` if not present. Equality dispatches through each element's `equals`.
 * @param elem The value to search for.
 * @param fromIndex Index to begin searching from. Negative counts from the end. Defaults to `0`.
 */
number[].indexOf(elem: number, fromIndex: number = 0): number
