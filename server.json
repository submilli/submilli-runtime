{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.submilli/submilli-runtime",
  "title": "Submilli Runtime",
  "description": "Run agent-written TypeScript under Blueprint-defined permissions through a local MCP server.",
  "version": "0.6.2",
  "repository": {
    "source": "github",
    "url": "https://github.com/submilli/submilli-runtime"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/submilli/submilli-runtime:0.6.2",
      "version": "0.6.2",
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--rm"
        },
        {
          "type": "named",
          "name": "--publish",
          "value": "127.0.0.1:8128:8128",
          "description": "Expose the local MCP server only on loopback."
        }
      ],
      "environmentVariables": [
        {
          "name": "SUBMILLI_SERVER_TOKEN",
          "description": "Token used to start and administer the local server.",
          "isRequired": true,
          "isSecret": true
        }
      ],
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:8128/mcp/default",
        "headers": [
          {
            "name": "Authorization",
            "description": "Bearer SUBMILLI_SERVER_TOKEN, including the `Bearer ` prefix.",
            "isRequired": true,
            "isSecret": true
          }
        ]
      }
    }
  ]
}
