{
  "module": "WriterRecovery",
  "constants": {
    "MaxCrashes": 1,
    "MaxCancels": 1,
    "Fault": "none",
    "Witness": "tail"
  },
  "invariants": [
    "TypeOK",
    "Retained",
    "DurableChunks",
    "ChunkHistoryBacked",
    "CloseHistoryBacked",
    "ClosedAfterOutcome",
    "SameBytes",
    "NoDuplicateTail",
    "NoRepublish",
    "ClosePublishesOutput",
    "NoImplicitPublication"
  ],
  "properties": [],
