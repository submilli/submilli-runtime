      }
    },
    {
      "name": "negative-early-return",
      "kind": "negative",
      "invariant": "CommitBeforeReturn",
      "constants": {
        "Fault": "early-return"
      }
    },
    {
      "name": "witness-read-own-writes",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "read-own-writes"
      }
    },
    {
      "name": "witness-rollback",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "rollback"
      }
    },
    {
      "name": "witness-lost-ack",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "lost-ack"
      }
    }
  ]
