{
  "module": "DurableUnitOfWork",
  "constants": {
    "Fault": "none",
    "Witness": "none"
  },
  "invariants": [
    "TypeOK",
    "AtomicAdmissionAndPins",
    "DropDiscards",
    "ReadOwnWrites",
    "CommitBeforeReturn"
  ],
  "properties": [],
  "cases": [
