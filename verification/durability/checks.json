{
  "module": "DurableExecution",
  "constants": {
    "MaxRuns": 1,
    "MaxSteps": 3,
    "MaxCrashes": 1,
    "FuelLimit": 3,
    "Lifecycle": false,
    "Compatible": true,
    "LegacyKey": false,
    "Fault": "none",
    "Witness": "",
    "NoWrite": {
      "model_value": "NoWrite"
    },
    "Idempotent": true
  },
  "invariants": [
    "TypeOK",
    "RequestSetsDisjoint",
    "AdmissionUnique",
    "KeyReserved",
    "ClientResponseMatches",
    "HistoryConsistent",
    "EffectHistoryWellFormed",
    "ReplayMatches",
    "NoDuplicateMutation",
    "ProviderArgumentsMatch",
    "CommitBarriers",
    "StableEffectIdentity",
    "NoStaleWrites",
    "SessionOrder",
    "ResourcesProtected",
    "TerminalConsistent",
    "LegacyNotRecovered"
  ],
  "properties": [
    "AppendOnly"
  ],
  "cases": [
    {
      "name": "safety",
      "kind": "safety"
    },
    {
      "name": "lifecycle",
      "kind": "safety",
      "constants": {
        "Lifecycle": true,
        "MaxSteps": 2,
        "FuelLimit": 2
      }
    },
    {
