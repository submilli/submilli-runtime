{
  "module": "RunRecovery",
  "constants": {
    "Capacity": 2,
    "MaxBoot": 2,
    "MaxAttempt": 3,
    "Legacy": false,
    "Fault": "none",
    "Witness": "none"
  },
  "invariants": [
    "TypeOK",
    "OneLiveAttemptPerRun",
    "NoSupersededLiveAttempt",
    "LiveAttemptsBelongToThisBoot",
    "WithinCapacity",
    "StuckIsInert",
    "ResumeIsExplicit",
    "OrderedExecution",
    "ResourcesProtected",
    "HistoryFenced",
    "ProgressBounded",
    "TerminalCommitted",
    "LegacyPreserved"
  ],
  "cases": [
    {
      "name": "safety",
      "kind": "safety",
      "timeout_seconds": 900
    },
    {
      "name": "safety-legacy-predecessor",
      "kind": "safety",
      "constants": {
        "Legacy": true
      }
    },
    {
      "name": "safety-capacity-one",
      "kind": "safety",
      "constants": {
        "Capacity": 1
      },
      "timeout_seconds": 900
    },
    {
      "name": "safety-two-crashes",
      "kind": "safety",
      "suite": "extended",
      "constants": {
        "MaxBoot": 3,
        "MaxAttempt": 4
      },
      "timeout_seconds": 3600
    },
    {
      "name": "negative-duplicate-claim",
      "kind": "negative",
      "constants": {
        "Fault": "duplicate-claim"
      },
      "invariant": "NoSupersededLiveAttempt"
    },
    {
      "name": "negative-redispatch",
      "kind": "negative",
      "constants": {
        "Fault": "redispatch"
      },
      "invariant": "OneLiveAttemptPerRun"
    },
    {
      "name": "negative-stale-launch",
      "kind": "negative",
      "constants": {
        "Fault": "stale-launch"
      },
      "invariant": "LiveAttemptsBelongToThisBoot"
    },
    {
      "name": "negative-stuck-while-live",
      "kind": "negative",
      "constants": {
        "Fault": "stuck-while-live"
      },
      "invariant": "StuckIsInert"
    },
    {
      "name": "negative-auto-resume",
      "kind": "negative",
      "constants": {
        "Fault": "auto-resume"
      },
      "invariant": "ResumeIsExplicit"
    },
    {
      "name": "negative-overtake",
      "kind": "negative",
      "constants": {
        "Fault": "overtake"
      },
      "invariant": "OrderedExecution"
    },
    {
      "name": "negative-early-retire",
      "kind": "negative",
      "constants": {
        "Fault": "early-retire"
      },
      "invariant": "ResourcesProtected"
    },
    {
      "name": "negative-stale-commit",
      "kind": "negative",
      "constants": {
        "Fault": "stale-commit"
      },
      "invariant": "HistoryFenced"
    },
    {
      "name": "witness-reclaim-after-crash",
      "kind": "witness",
      "constants": {
        "Witness": "reclaim-after-crash"
      },
      "invariant": "NoWitness"
    },
    {
      "name": "witness-retry-commits-prior-progress",
      "kind": "witness",
      "constants": {
        "Witness": "retry-commits-prior-progress"
      },
      "invariant": "NoWitness"
    },
    {
      "name": "witness-fenced-task-drains",
      "kind": "witness",
      "constants": {
        "Witness": "fenced-task-drains"
      },
      "invariant": "NoWitness"
    },
    {
      "name": "witness-unrelated-session-progress",
      "kind": "witness",
      "constants": {
        "Witness": "unrelated-session-progress"
      },
      "invariant": "NoWitness"
    },
    {
      "name": "witness-legacy-successor-completed",
      "kind": "witness",
      "constants": {
        "Legacy": true,
        "Witness": "legacy-successor-completed"
      },
      "invariant": "NoWitness"
    }
  ]
}
