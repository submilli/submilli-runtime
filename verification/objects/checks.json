{
  "module": "ObjectPublication",
  "constants": {
    "MaxObjects": 1,
    "MaxReaders": 1,
    "ChunkCount": 2,
    "MaxCrashes": 1,
    "CrashMode": "power",
    "Lifecycle": true,
    "AllowAbandon": true,
    "Fault": "none",
    "Witness": ""
  },
  "invariants": [
    "TypeOK",
    "ReferencedObjectsDurable",
    "PublishedBytesImmutable",
    "PendingPublicationProtected",
    "RequiredReferenceRetained",
    "ReadersProtected",
    "CollectionComplete",
    "NoLateReference",
    "ReferenceCommittedOnce",
    "PendingCanAdvance"
  ],
  "properties": [],
  "cases": [
    {
      "name": "safety-power-loss",
      "kind": "safety"
    },
    {
      "name": "safety-process-crash",
      "kind": "safety",
      "constants": {
        "CrashMode": "process"
      }
    },
    {
      "name": "safety-two-readers",
      "kind": "safety",
      "constants": {
        "MaxReaders": 2
      }
    },
    {
      "name": "safety-two-objects",
      "kind": "safety",
      "constants": {
        "MaxObjects": 2,
        "MaxCrashes": 0
      },
      "timeout_seconds": 180
    },
    {
      "name": "progress-publication",
      "kind": "liveness",
      "specification": "LiveSpec",
      "constants": {
        "Lifecycle": false,
        "AllowAbandon": false
      },
      "properties": [
        "PublicationProgress"
      ]
    },
    {
      "name": "progress-cleanup",
      "kind": "liveness",
      "specification": "LiveSpec",
      "properties": [
        "PublicationProgress",
        "CollectionProgress",
        "RetentionProgress"
      ],
      "timeout_seconds": 180
    },
    {
      "name": "negative-early-reference",
      "kind": "negative",
      "invariant": "ReferencedObjectsDurable",
      "constants": {
        "Fault": "early-reference"
      }
    },
    {
      "name": "negative-skip-file-sync",
      "kind": "negative",
      "invariant": "ReferencedObjectsDurable",
      "constants": {
        "Fault": "skip-file-sync"
      }
    },
    {
      "name": "negative-skip-directory-sync",
      "kind": "negative",
      "invariant": "ReferencedObjectsDurable",
      "constants": {
        "Fault": "skip-directory-sync"
      }
    },
    {
      "name": "negative-collect-pending",
      "kind": "negative",
      "invariant": "PendingPublicationProtected",
      "constants": {
        "Fault": "collect-pending"
      }
    },
    {
      "name": "negative-ignore-reader",
      "kind": "negative",
      "invariant": "ReadersProtected",
      "constants": {
        "Fault": "ignore-reader"
      }
    },
    {
      "name": "negative-early-retirement",
      "kind": "negative",
      "invariant": "RequiredReferenceRetained",
      "constants": {
        "Fault": "early-retirement"
      }
    },
    {
      "name": "negative-writable-alias",
      "kind": "negative",
      "invariant": "PublishedBytesImmutable",
      "constants": {
        "Fault": "writable-alias"
      }
    },
    {
      "name": "negative-late-reference",
      "kind": "negative",
      "invariant": "NoLateReference",
      "constants": {
        "Fault": "late-reference"
      }
    },
    {
      "name": "negative-unsynced-deletion",
      "kind": "negative",
      "invariant": "CollectionComplete",
      "constants": {
        "Fault": "unsynced-deletion"
      }
    },
    {
      "name": "negative-skip-staging-repair",
      "kind": "negative",
      "invariant": "PendingCanAdvance",
      "constants": {
        "Fault": "skip-staging-repair"
      }
    },
    {
      "name": "witness-lost-reservation-ack",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "lost-reservation-ack"
      }
    },
    {
      "name": "witness-partial-staging-crash",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "partial-staging-crash"
      }
    },
    {
      "name": "witness-unsynced-rename-crash",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "unsynced-rename-crash"
      }
    },
    {
      "name": "witness-recover-published",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "recover-published"
      }
    },
    {
      "name": "witness-recover-committed",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "recover-committed"
      }
    },
    {
      "name": "witness-lost-reference-ack",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "lost-reference-ack"
      }
    },
    {
      "name": "witness-rollback-retry",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "rollback-retry"
      }
    },
    {
      "name": "witness-reader-retirement",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "reader-retirement"
      }
    },
    {
      "name": "witness-response-expired-run-retained",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "response-expired-run-retained"
      }
    },
    {
      "name": "witness-orphan-collected",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "orphan-collected"
      }
    },
    {
      "name": "witness-recover-unlink",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "recover-unlink"
      }
    },
    {
      "name": "witness-remaining-reader",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "remaining-reader",
        "MaxReaders": 2
      }
    },
    {
      "name": "witness-recover-damaged-staging",
      "kind": "witness",
      "invariant": "NeverWitness",
      "constants": {
        "Witness": "recover-damaged-staging"
      }
    },
    {
      "name": "repeated-power-loss",
      "kind": "safety",
      "suite": "extended",
      "constants": {
        "MaxCrashes": 2
      },
      "timeout_seconds": 180
    },
    {
      "name": "two-objects-power-loss",
      "kind": "safety",
      "suite": "extended",
      "constants": {
        "MaxObjects": 2
      },
      "timeout_seconds": 300
    }
  ]
}
