{
  "name": "submilli-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node ./scripts/ensure-root-tsconfig.mjs && node ./scripts/check-video-preview.mjs",
    "build": "astro build && node --experimental-strip-types ./scripts/check-built-agent-docs.ts",
    "preview": "astro preview",
    "reference": "node --experimental-strip-types ./scripts/generate-reference.ts",
    "check": "astro check && node --experimental-strip-types --test ./scripts/agent-docs.test.ts ./scripts/theme.test.mjs ./scripts/videos.test.ts",
    "precheck": "node ./scripts/ensure-root-tsconfig.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.2.2",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-decode-string": "^2.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
