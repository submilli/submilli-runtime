---

<span class="sub-logo" style={`gap:${gap}px`}>
	<svg
		class="sub-logo__mark"
		viewBox="0 0 41.323 41.323"
		width={markSize}
		height={markSize}
		fill="none"
		aria-hidden="true"
	>
		<path d={MARK_PATH} fill="currentColor" fill-rule="evenodd"></path>
	</svg>
	<svg
		class="sub-logo__word"
		viewBox="0 0 167.368 34.058"
		width={wordWidth}
		height={size}
		fill="none"
		role="img"
		aria-label="submilli"
	>
		<path d={WORDMARK_PATH} fill="currentColor" fill-rule="nonzero"></path>
	</svg>
</span>

<style>
	.sub-logo {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
	}
	.sub-logo__mark {
		display: block;
		color: var(--sub-logo-mark);
	}
	.sub-logo__word {
		display: block;
		color: var(--sub-logo-word);
	}
</style>
