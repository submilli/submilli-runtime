---
import Search from '@astrojs/starlight/components/Search.astro';
import DiscordLink from './DiscordLink.astro';
import GitHubLink from './GitHubLink.astro';
import SiteTitle from './SiteTitle.astro';
import ThemeSelect from './ThemeSelect.astro';

const WEBSITE_URL = 'https://submilli.ai';
---

<div class="header">
	<div class="title-wrapper">
		<SiteTitle />
	</div>
	<div class="search-wrapper print:hidden">
		<Search />
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<a href={WEBSITE_URL} class="website-link">
			submilli.ai
			<svg
				width="12"
				height="12"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M7 17 17 7M8 7h9v9"></path>
			</svg>
		</a>
		<DiscordLink variant="label" />
		<GitHubLink variant="label" />
		<ThemeSelect />
	</div>
	<div class="sl-flex md:sl-hidden print:hidden mobile-group">
		<DiscordLink variant="icon" />
		<GitHubLink variant="icon" />
	</div>
</div>

<style>
	.header {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		height: 100%;
	}
	.title-wrapper {
		display: flex;
		align-items: center;
		flex: 1;
		min-width: 0;
		/* Avoid clipping the focus ring around the logo link. */
		padding: 0.25rem;
		margin: -0.25rem;
	}
	.search-wrapper {
		display: flex;
		align-items: center;
	}
	.right-group {
		gap: 0.5rem;
		align-items: center;
	}
	/* `display` comes from Starlight's `sl-flex` / `md:sl-hidden` utilities so
	   the layered breakpoint rule is not overridden by this unlayered style. */
	.mobile-group {
		align-items: center;
	}
	.website-link {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		height: 2.25rem;
		padding: 0 0.75rem;
		border-radius: var(--radius-md);
		font: 600 0.875rem/1 var(--sl-font);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition:
			color var(--sub-dur-base) var(--sub-ease-out),
			background-color var(--sub-dur-base) var(--sub-ease-out);
	}
	.website-link:hover {
		color: var(--sl-color-white);
		background: var(--sub-hover);
	}

	@media (min-width: 50rem) {
		.header {
			gap: 1.25rem;
		}
		.title-wrapper {
			flex: none;
		}
		.search-wrapper {
			flex: 1;
			margin-inline-start: 0.25rem;
		}
		.search-wrapper > :global(*) {
			width: 100%;
			max-width: 22.5rem;
		}
	}
</style>
