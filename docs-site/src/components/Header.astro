---
import Search from '@astrojs/starlight/components/Search.astro';
import DiscordLink from './DiscordLink.astro';
import GitHubLink from './GitHubLink.astro';
import MeetingLink from './MeetingLink.astro';
import SiteTitle from './SiteTitle.astro';
import ThemeSelect from './ThemeSelect.astro';

const WEBSITE_URL = 'https://submilli.ai';
---

<div class="docs-header">
	<div class="title-wrapper">
		<SiteTitle />
	</div>
	<div class="search-wrapper print:hidden">
		<Search />
	</div>
	<nav class="header-actions print:hidden" aria-label="Documentation resources">
		<a href={WEBSITE_URL} class="website-link">
			submilli.ai
			<svg
				width="12"
				height="12"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M7 17 17 7M8 7h9v9"></path>
			</svg>
		</a>
		<a href="/docs/quickstart/#agent-setup" class="setup-link">Agent setup</a>
		<div class="utilities">
			<GitHubLink variant="icon" />
			<DiscordLink variant="icon" />
			<ThemeSelect />
		</div>
		<MeetingLink />
	</nav>
</div>

<style>
	.docs-header {
		display: flex;
		gap: 1.25rem;
		align-items: center;
		height: 100%;
	}
	.title-wrapper {
		flex: none;
		min-width: 0;
		/* Keep the logo's focus ring visible. */
		padding: 0.25rem;
		margin: -0.25rem;
	}
	.search-wrapper {
		display: flex;
		align-items: center;
		flex: 1;
		min-width: 0;
	}
	.search-wrapper > :global(*) {
		width: 100%;
		max-width: 25rem;
	}
	.header-actions, .utilities {
		display: flex;
		align-items: center;
	}
	.header-actions { gap: 1rem; flex: none; }
	.utilities { gap: 0.125rem; }
	.utilities :global(.theme-toggle) {
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
	}
	.website-link, .setup-link {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		min-height: 44px;
		font: 500 0.875rem/1 var(--sl-font);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
	}
	.website-link:hover, .setup-link:hover { color: var(--sl-color-white); }
	@media (max-width: 71.99rem) {
		.website-link { display: none; }
		.docs-header { gap: 0.75rem; }
		.header-actions { gap: 0.5rem; }
	}
	@media (max-width: 49.99rem) {
		/* Booking, setup, and resource links remain available in the mobile menu. */
		.header-actions { display: none; }
		.title-wrapper { flex: 1; }
		.search-wrapper { flex: none; }
	}
	@media (min-width: 50rem) and (max-width: 63.99rem) {
		/* Keep the search target usable when the full action row leaves little room. */
		.search-wrapper { justify-content: flex-end; }
		.search-wrapper > :global(*) { width: auto; }
		.search-wrapper :global(button[data-open-modal]) {
			width: 2.75rem;
			height: 2.75rem;
			padding: 0;
			justify-content: center;
			border: 0;
			background: transparent;
		}
		.search-wrapper :global(button[data-open-modal] > :is(span, kbd)) { display: none; }
		.search-wrapper :global(button[data-open-modal] > svg) { flex: none; }
	}
</style>
