---
/** Two-state picker using the same pre-paint provider as theme handoff links. */
---

<starlight-theme-select>
	<button type="button" class="theme-toggle" aria-label="Switch to light theme">
		<svg
			class="icon-sun"
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			aria-hidden="true"
		>
			<circle cx="12" cy="12" r="4"></circle>
			<path
				d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
			></path>
		</svg>
		<svg
			class="icon-moon"
			width="16"
			height="16"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
		</svg>
	</button>
</starlight-theme-select>

<script>
	type Theme = 'dark' | 'light';
	declare global {
		interface Window {
			StarlightThemeProvider: { setTheme: (theme: Theme) => void; updatePickers: () => void };
		}
	}


	const currentTheme = (): Theme =>
		document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';

	class SubmilliThemeSelect extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector('button');
			if (!button) return;
			const sync = () => {
				const next: Theme = currentTheme() === 'light' ? 'dark' : 'light';
				button.setAttribute('aria-label', `Switch to ${next} theme`);
			};
			button.addEventListener('click', () => {
				const next: Theme = currentTheme() === 'light' ? 'dark' : 'light';
				window.StarlightThemeProvider.setTheme(next);
			});
			sync();
		}
	}

	if (!customElements.get('starlight-theme-select')) {
		customElements.define('starlight-theme-select', SubmilliThemeSelect);
	}
</script>

<style>
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--sub-line);
		border-radius: var(--radius-md);
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			color var(--sub-dur-base) var(--sub-ease-out),
			background-color var(--sub-dur-base) var(--sub-ease-out);
	}
	.theme-toggle:hover {
		color: var(--sl-color-white);
		background: var(--sub-hover);
	}
	.theme-toggle:active {
		transform: scale(0.98);
	}
	/* Show the icon for the theme the click will switch to. */
	.icon-moon {
		display: none;
	}
	:global([data-theme='light']) .icon-sun {
		display: none;
	}
	:global([data-theme='light']) .icon-moon {
		display: block;
	}
	@media (max-width: 49.99rem) {
		.theme-toggle {
			width: 2.75rem;
			height: 2.75rem;
		}
	}
</style>
