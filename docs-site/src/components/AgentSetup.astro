---
import { toHtml } from '@expressive-code/core/hast';
import { agentPromptAst } from '../lib/agent-prompts.mjs';
const setupPrompt = `Help me set up Submilli in my project. Read and follow the Submilli skill at https://github.com/submilli/submilli-runtime/blob/main/skills/submilli/SKILL.md, the official setup instructions at https://github.com/submilli/submilli-runtime/blob/main/skills/submilli/references/setup.md and the quickstart at https://submilli.ai/docs/quickstart/ first. Confirm the project directory, check whether submilli and submilli-server are already installed, and use the documented installer for my OS only if needed. Preserve existing pinned versions and local edits. Install the skill for this assistant in the project: use submilli skill install --agent claude --project . for Claude Code, or submilli skill install --agent codex --project . for Codex. For Cursor, follow its documented project skills setup. Read the installed skill and use it to guide setup. Verify the installation and run a small local example without paid model calls or external side effects. Tell me if I need to restart the assistant to discover the skill, and report what you actually verified.`;
---
<aside id="agent-setup" class="agent-setup" aria-labelledby="agent-setup-title">
  <p id="agent-setup-title" class="setup-label">Set up with your coding agent</p>
  <Fragment set:html={toHtml(agentPromptAst(setupPrompt, { collapsed: true }))} />
</aside>
<style>
  .agent-setup{scroll-margin-top:calc(var(--sl-nav-height) + 1rem);margin:0 0 1rem}
  .setup-label{margin:0 0 8px;font-size:15px;font-weight:600;color:var(--sl-color-white)}
</style>
