---
const bookingUrl = 'https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ3eHw3aT9EpwajiuI59uqDNnff84TqdNXaatxeUNguqQX2ZoXmR0PiJG5dgIEFhfn9av2S41czv';
---

<a class="meeting-link" data-analytics-cta="meeting" href={bookingUrl} target="_blank" rel="noopener">
	Book a meeting<span aria-hidden="true">→</span>
</a>

<style>
	.meeting-link:any-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.625rem;
		min-height: 2.75rem;
		padding: 0 0.875rem;
		border: 1px solid transparent;
		border-radius: var(--radius-md);
		background: var(--sl-color-text-accent);
		color: var(--sl-color-bg);
		font: 600 0.875rem/1.4 var(--sl-font);
		text-decoration: none;
		white-space: nowrap;
	}
	.meeting-link:any-link:is(:hover, :focus) {
		background: var(--sl-color-text-accent);
		color: var(--sl-color-bg);
		filter: brightness(1.08);
	}
	.meeting-link:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 3px;
	}
</style>
