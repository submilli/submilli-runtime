---
import DefaultContent from '@astrojs/starlight/components/MarkdownContent.astro';
import { introduction, challenges } from '../lib/videos';
import VideoFigure from './VideoFigure.astro';
import VideoLibrary from './VideoLibrary.astro';
const path = Astro.url.pathname.replace(/\/$/, '');
const isLibraryPage = path === '/docs/videos';
const isVideoPage = [introduction.canonicalPath, ...(introduction.contextualPaths ?? [])].some(videoPath => videoPath?.replace(/\/$/, '') === path);
const rendered = isVideoPage ? await Astro.slots.render('default') : '';
const [beforeChallenges, ...afterChallenges] = rendered.split('<!-- video:challenges -->');
---
<DefaultContent>
  {isLibraryPage ? <><slot /><VideoLibrary /></> : isVideoPage ? <>
    <VideoFigure film={introduction} />
    <Fragment set:html={beforeChallenges} />
    {afterChallenges.length > 0 && <><VideoFigure film={challenges} /><Fragment set:html={afterChallenges.join('<!-- video:challenges -->')} /></>}
  </> : <slot />}
</DefaultContent>
