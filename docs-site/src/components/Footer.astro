---
import EditLink from './EditLink.astro';
import LastUpdated from './LastUpdated.astro';
import Pagination from './Pagination.astro';
---

<footer class="page-footer">
	<div class="meta">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />
</footer>

<style>
	.page-footer {
		display: flex;
		flex-direction: column;
		gap: 0;
		margin-top: 2.5rem;
	}
	.meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		padding: 1.25rem 0;
		border-top: 1px solid var(--sub-line);
	}
	.meta > :global(:only-child) {
		margin-inline-start: auto;
	}
</style>
