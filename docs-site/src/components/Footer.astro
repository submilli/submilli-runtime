---
import DiscordLink from './DiscordLink.astro';
import EditLink from './EditLink.astro';
import LastUpdated from './LastUpdated.astro';
import Pagination from './Pagination.astro';
import { DOCS_INDEX, markdownPath } from '../lib/agent-docs';

const { entry } = Astro.locals.starlightRoute;
const slug = entry.id === 'index' ? '' : entry.id;
---

<footer class="page-footer">
	<div class="meta">
		<EditLink />
		<LastUpdated />
	</div>
	{entry.id !== '404' && !entry.data.sidebar.hidden && (
		<div class="agent-links print:hidden">
			<a href={markdownPath(slug)}>View Markdown</a>
			<a href={DOCS_INDEX}>Documentation for agents</a>
			<DiscordLink variant="label" />
		</div>
	)}
	<Pagination />
</footer>

<style>
	.agent-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		padding-bottom: 1.25rem;
		font-size: 0.875rem;
	}
	.agent-links a { color: var(--sl-color-gray-2); }
	.agent-links a:hover { color: var(--sl-color-white); }
	.page-footer {
		display: flex;
		flex-direction: column;
		gap: 0;
		margin-top: 2.5rem;
	}
	.meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		padding: 1.25rem 0;
		border-top: 1px solid var(--sub-line);
	}
	.meta > :global(:only-child) {
		margin-inline-start: auto;
	}
</style>
