---
import DiscordLink from './DiscordLink.astro';
import EditLink from './EditLink.astro';
import LastUpdated from './LastUpdated.astro';
import Pagination from './Pagination.astro';
import { DOCS_INDEX, markdownPath } from '../lib/agent-docs';

const { entry } = Astro.locals.starlightRoute;
const slug = entry.id === 'index' ? '' : entry.id;
---

<footer class="page-footer">
	<Pagination />
	<div class="footer-details">
		{entry.id !== '404' && !entry.data.sidebar.hidden && (
			<nav class="resource-links print:hidden" aria-label="Page resources">
				<a href={markdownPath(slug)} data-analytics-cta="view_markdown">View Markdown</a>
				<a href={DOCS_INDEX} data-analytics-cta="agent_docs">Documentation for agents</a>
				<DiscordLink variant="text" />
			</nav>
		)}
		<div class="meta">
			<EditLink />
			<LastUpdated />
		</div>
	</div>
</footer>

<style>
	.page-footer {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-top: 2.5rem;
	}
	.footer-details {
		border-top: 1px solid var(--sub-line);
		padding-top: 0.75rem;
	}
	.resource-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0 1.5rem;
	}
	.resource-links > a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font: 500 0.875rem/1.5 var(--sl-font);
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.resource-links > a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.resource-links :global(a:focus-visible), .meta :global(a:focus-visible) {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}
	.meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
	}
	.meta :global(.edit-link) {
		min-height: 2.75rem;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}
	.meta :global(.edit-link:hover) { color: var(--sl-color-white); }
	.meta :global(.last-updated) {
		font-family: var(--sl-font);
		line-height: 1.5;
	}
	@media (max-width: 30rem) {
		.resource-links { gap: 0 1rem; }
		.meta { flex-direction: column; align-items: flex-start; }
	}
</style>
