---
import { formatStars, getGitHubStars, GITHUB_URL } from '../lib/github-stars';

interface Props {
	/** `icon` renders the glyph only (mobile header); `label` adds the text and star count. */
	variant?: 'icon' | 'label';
}

const { variant = 'label' } = Astro.props;
const stars = variant === 'label' ? await getGitHubStars() : null;
---

<a
	href={GITHUB_URL}
	rel="me"
	class:list={['github-link', `github-link--${variant}`]}
	aria-label="Submilli on GitHub"
>
	<span class="github-link__main">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path
				d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.34.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
			></path>
		</svg>
		{variant === 'label' && <span>GitHub</span>}
	</span>
	{
		stars !== null && (
			<span class="github-link__stars">
				<svg
					width="13"
					height="13"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="m12 3 2.8 5.9 6.2.8-4.5 4.4 1.1 6.4L12 17.5 6.4 20.5l1.1-6.4L3 9.7l6.2-.8Z" />
				</svg>
				{formatStars(stars)}
				<span class="sr-only">stars</span>
			</span>
		)
	}
</a>

<style>
	.github-link {
		display: flex;
		align-items: center;
		height: 2.25rem;
		border-radius: var(--radius-md);
		font: 600 0.875rem/1 var(--sl-font);
		color: var(--sl-color-white);
		text-decoration: none;
		overflow: hidden;
		transition:
			border-color var(--sub-dur-base) var(--sub-ease-out),
			background-color var(--sub-dur-base) var(--sub-ease-out);
	}
	.github-link--label {
		border: 1px solid var(--sub-line);
	}
	.github-link--label:hover {
		border-color: var(--sub-line-strong);
		background: var(--sub-hover);
	}
	.github-link--icon {
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		color: var(--sl-color-gray-2);
	}
	.github-link--icon:hover {
		color: var(--sl-color-white);
	}
	.github-link--icon svg {
		width: 20px;
		height: 20px;
	}
	.github-link__main {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: 100%;
		padding: 0 0.75rem;
	}
	.github-link--icon .github-link__main {
		padding: 0;
	}
	.github-link__stars {
		display: flex;
		align-items: center;
		gap: 0.3125rem;
		height: 100%;
		padding: 0 0.75rem 0 0.625rem;
		border-left: 1px solid var(--sub-line);
		font: 500 0.8125rem/1 var(--sl-font-mono);
		color: var(--sl-color-gray-2);
	}
</style>
