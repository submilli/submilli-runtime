---
import { films } from '../lib/videos';
import VideoPlayer from './VideoPlayer.astro';
---
<section class="video-library not-content" aria-label="Video series">
  {films.length ? films.map(film => <article data-video-id={film.id}>
    <div class="player"><VideoPlayer film={film} /></div>
    <h2><span class="number">{String(films.indexOf(film) + 1).padStart(2,'0')}</span> {film.title}</h2>
    <p>{film.description}</p>
  </article>) : <p>No videos available.</p>}
</section>
<style>
  article { margin-top: 1.5rem; }
  .player { overflow: hidden; border-radius: 10px; }
  h2 { margin: 1rem 0 0; font-size: 1.35rem; color: var(--sl-color-white); font-weight: 600; line-height: 1.35; }
  .number { color: var(--sl-color-gray-2); font: .75em monospace; margin-right: .3em; }
  article > p { margin: .6rem 0 1rem; }
</style>
