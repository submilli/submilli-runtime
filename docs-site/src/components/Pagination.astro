---
const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

{
	(prev || next) && (
		<nav class="pagination print:hidden" dir={dir} aria-label="Previous and next chapter">
			{prev ? (
				<a href={prev.href} rel="prev" class="pagination__link">
					<span class="pagination__eyebrow">
						<svg
							width="12"
							height="12"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.4"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M19 12H5M11 18l-6-6 6-6" />
						</svg>
						{Astro.locals.t('page.previousLink')}
					</span>
					<span class="pagination__title">{prev.label}</span>
				</a>
			) : (
				<span />
			)}
			{next && (
				<a href={next.href} rel="next" class="pagination__link pagination__link--next">
					<span class="pagination__eyebrow">
						{Astro.locals.t('page.nextLink')}
						<svg
							width="12"
							height="12"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.4"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</span>
					<span class="pagination__title">{next.label}</span>
				</a>
			)}
		</nav>
	)
}

<style>
	.pagination {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.pagination__link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1rem 1.125rem;
		border: 1px solid var(--sub-line);
		border-radius: var(--radius-md);
		text-decoration: none;
		color: inherit;
		overflow-wrap: anywhere;
		transition:
			border-color var(--sub-dur-base) var(--sub-ease-out),
			background-color var(--sub-dur-base) var(--sub-ease-out);
	}
	.pagination__link:hover {
		border-color: var(--sub-line-strong);
		background: var(--sub-hover);
	}
	.pagination__link--next {
		align-items: flex-end;
		text-align: end;
	}
	.pagination__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font: 500 0.6875rem/1 var(--sl-font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.pagination__title {
		font: 700 1rem/1.3 var(--sl-font);
		color: var(--sl-color-white);
		text-wrap: pretty;
	}
	@media (max-width: 30rem) {
		.pagination {
			grid-template-columns: 1fr;
		}
		.pagination > span:empty {
			display: none;
		}
	}
</style>
