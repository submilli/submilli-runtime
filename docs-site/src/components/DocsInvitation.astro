---
import { DOCS_MEETING_URL } from '../lib/contact-links';

const { entry } = Astro.locals.starlightRoute;
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT;
const eligible = Boolean(endpoint) && entry.id !== '404' && !entry.data.sidebar.hidden
	&& !Astro.url.pathname.startsWith('/docs/videos/embed/');
---

{eligible && <aside class="docs-invitation" data-docs-invitation data-endpoint={endpoint} hidden aria-label="Stay in touch">
	<button class="docs-invitation__dismiss" type="button" data-invitation-dismiss aria-label="Dismiss invitation">×</button>
	<div class="docs-invitation__copy">
		<strong>Finding this interesting?</strong>
		<span>We’d love to hear what you’re building.</span>
	</div>
	<form>
		<label class="sr-only" for="docs-invitation-email">Email address</label>
		<input id="docs-invitation-email" type="email" autocomplete="email" placeholder="you@example.com" required />
		<button type="submit" data-invitation-submit>Let’s chat</button>
	</form>
	<a class="docs-invitation__meeting" data-analytics-cta="meeting" data-analytics-location="docs-invitation" href={DOCS_MEETING_URL} target="_blank" rel="noopener">Let’s meet <span aria-hidden="true">→</span></a>
	<p class="docs-invitation__message" data-invitation-message role="status" aria-live="polite"></p>
</aside>}

{eligible && <script>
	import { startDocsInvitation } from '../lib/docs-invitation-client';
	startDocsInvitation();
</script>}

<style>
	.docs-invitation { position: fixed; right: 1rem; bottom: 3.25rem; z-index: 900; display: grid; grid-template-columns: 1fr; gap: .625rem; width: min(22rem, calc(100vw - 2rem)); padding: 1rem 1.125rem; border: 1px solid var(--sl-color-hairline); border-radius: 10px; background: var(--sl-color-bg-nav); color: var(--sl-color-text); box-shadow: 0 12px 36px #0005; font: .875rem/1.4 var(--sl-font); }
	.docs-invitation[hidden] { display: none; }
	.docs-invitation__dismiss { position: absolute; top: .15rem; right: .15rem; min-width: 44px; min-height: 44px; border: 0; padding: .25rem .5rem; background: transparent; color: var(--sl-color-gray-3); font-size: 1.25rem; line-height: 1; cursor: pointer; }
	.docs-invitation__copy { display: grid; gap: .125rem; padding-right: 2.5rem; }
	.docs-invitation__copy span { color: var(--sl-color-gray-2); }
	.docs-invitation form { display: flex; grid-column: 1; gap: .5rem; min-width: 0; }
	.docs-invitation input { min-width: 0; width: 100%; border: 1px solid var(--sl-color-hairline-light); border-radius: 8px; padding: .55rem .65rem; background: var(--sl-color-bg); color: inherit; font: inherit; }
	.docs-invitation form button, .docs-invitation__meeting { border: 0; border-radius: 8px; padding: .55rem .75rem; background: var(--sl-color-text-accent); color: var(--sl-color-bg); font: 600 .8125rem/1.2 var(--sl-font); white-space: nowrap; cursor: pointer; text-decoration: none; }
	.docs-invitation form button:disabled { opacity: .65; cursor: wait; }
	.docs-invitation__meeting { justify-self: start; background: transparent; color: var(--sl-color-text-accent); padding-inline: 0; }
	.docs-invitation__message { grid-column: 1 / -1; min-height: 1.2em; margin: 0; color: var(--sl-color-gray-2); }
	.docs-invitation :is(input, button, a):focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	@media (max-width: 40rem) { .docs-invitation { left: 1rem; right: 1rem; bottom: 3.25rem; width: auto; } }
	@media print { .docs-invitation { display: none; } }
</style>
