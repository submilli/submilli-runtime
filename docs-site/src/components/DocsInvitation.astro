---
import { DOCS_MEETING_URL } from '../lib/contact-links';

const { entry } = Astro.locals.starlightRoute;
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT;
const eligible = Boolean(endpoint) && entry.id !== '404' && !entry.data.sidebar.hidden
	&& !Astro.url.pathname.startsWith('/docs/videos/embed/');
---

{eligible && <aside class="docs-invitation" data-docs-invitation data-endpoint={endpoint} hidden aria-label="Stay in touch">
	<button class="docs-invitation__dismiss" type="button" data-invitation-dismiss aria-label="Dismiss invitation">×</button>
	<div class="docs-invitation__copy">
		<strong>Building with Submilli?</strong>
		<span>Tell us what you’re working on.</span>
	</div>
	<form>
		<label class="sr-only" for="docs-invitation-email">Email address</label>
		<input id="docs-invitation-email" type="email" autocomplete="email" placeholder="you@example.com" required />
		<button type="submit" data-invitation-submit>Let’s chat</button>
	</form>
	<a class="docs-invitation__meeting" data-analytics-cta="meeting" data-analytics-location="docs-invitation" href={DOCS_MEETING_URL} target="_blank" rel="noopener">Prefer a quick call? <span>Book a time <span aria-hidden="true">→</span></span></a>
	<p class="docs-invitation__message" data-invitation-message role="status" aria-live="polite"></p>
</aside>}

{eligible && <script>
	import { startDocsInvitation } from '../lib/docs-invitation-client';
	startDocsInvitation();
</script>}

<style>
	.docs-invitation { position: fixed; right: 1rem; bottom: 3.25rem; z-index: 900; display: grid; gap: .7rem; width: min(20rem, calc(100vw - 2rem)); padding: .9rem 1rem 1rem; border: 1px solid var(--sl-color-hairline); border-radius: 12px; background: var(--sl-color-bg-nav); color: var(--sl-color-text); box-shadow: 0 10px 30px #0004; font: .8125rem/1.4 var(--sl-font); }
	.docs-invitation[hidden] { display: none; }
	.docs-invitation__dismiss { position: absolute; top: .15rem; right: .15rem; min-width: 44px; min-height: 44px; border: 0; padding: .25rem .5rem; background: transparent; color: var(--sl-color-gray-3); font-size: 1.15rem; line-height: 1; cursor: pointer; }
	.docs-invitation__copy { display: grid; gap: .15rem; margin: 0; padding-right: 2.25rem; }
	.docs-invitation__copy strong { font-size: .9375rem; line-height: 1.25; }
	.docs-invitation__copy span { color: var(--sl-color-gray-2); }
	.docs-invitation form { display: flex; gap: .45rem; min-width: 0; margin: 0; }
	.docs-invitation input { min-width: 0; width: 100%; border: 1px solid var(--sl-color-hairline-light); border-radius: 7px; padding: .52rem .6rem; background: var(--sl-color-bg); color: inherit; font: inherit; }
	.docs-invitation form button { border: 0; border-radius: 7px; padding: .52rem .7rem; background: var(--sl-color-text-accent); color: var(--sl-color-bg); font: 600 .8rem/1.2 var(--sl-font); white-space: nowrap; cursor: pointer; }
	.docs-invitation form button:disabled { opacity: .65; cursor: wait; }
	.docs-invitation__meeting { display: inline-flex; gap: .25rem; align-items: baseline; justify-self: start; color: var(--sl-color-gray-2); font-size: .75rem; text-decoration: none; }
	.docs-invitation__meeting > span { color: var(--sl-color-text-accent); font-weight: 600; }
	.docs-invitation__meeting:hover > span { text-decoration: underline; text-underline-offset: .15em; }
	.docs-invitation__message { margin: -.15rem 0 0; color: var(--sl-color-gray-2); }
	.docs-invitation__message:empty, .docs-invitation form[hidden] { display: none; }
	.docs-invitation :is(input, button, a):focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	@media (max-width: 30rem) {
		.docs-invitation { left: 1rem; right: 1rem; bottom: 3.25rem; width: auto; }
		.docs-invitation form { align-items: stretch; }
		.docs-invitation form button { padding-inline: .65rem; }
	}
	@media print { .docs-invitation { display: none; } }
</style>
