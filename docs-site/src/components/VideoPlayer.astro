---
import { embedUrl, type Film } from '../lib/videos';
interface Props { film: Film; }
const { film } = Astro.props;
---
<div class="video-player" aria-label={film.title}>
  <iframe
    src={embedUrl(film)}
    title={film.title}
    loading="lazy"
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>
<style>
  .video-player { width: 100%; aspect-ratio: 16 / 9; background: #131313; overflow: hidden; }
  iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
