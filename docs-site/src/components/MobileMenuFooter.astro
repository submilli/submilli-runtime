---
import DiscordLink from './DiscordLink.astro';
import GitHubLink from './GitHubLink.astro';
import MeetingLink from './MeetingLink.astro';
import ThemeSelect from './ThemeSelect.astro';

const WEBSITE_URL = 'https://submilli.ai';
---

<div class="mobile-preferences">
	<MeetingLink />
	<a href="/docs/quickstart/#agent-setup" class="website-link">Agent setup</a>
	<DiscordLink variant="label" />
	<GitHubLink variant="label" />
	<a href={WEBSITE_URL} class="website-link">
		submilli.ai
		<svg
			width="12"
			height="12"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2.2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M7 17 17 7M8 7h9v9"></path>
		</svg>
	</a>
	<span class="spacer"></span>
	<ThemeSelect />
</div>

<style>
	.mobile-preferences {
		display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 0.5rem;
		margin: 0 calc(-1 * var(--sl-sidebar-pad-x));
		padding: 0.75rem 1rem;
		border-top: 1px solid var(--sub-line);
		background: var(--sl-color-bg-sidebar);
	}
	.mobile-preferences > :global(.github-link) {
		height: 2.75rem;
	}
	.website-link {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		height: 2.75rem;
		padding: 0 0.75rem;
		font: 600 0.875rem/1 var(--sl-font);
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.website-link:hover {
		color: var(--sl-color-white);
	}
	.spacer {
		flex: 1 1 0;
		min-width: 0;
	}
</style>
