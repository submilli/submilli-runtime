---
import VideoPlayer from '../../../components/VideoPlayer.astro';
import { challenges } from '../../../lib/videos';
---
<!doctype html>
<html lang={challenges.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{challenges.title} — Submilli</title>
    <link rel="canonical" href={`https://submilli.ai${challenges.canonicalPath}`} />
  </head>
  <body><VideoPlayer film={challenges} /></body>
</html>
<style is:global>
  html, body { margin: 0; padding: 0; background: #131313; }
  * { box-sizing: border-box; }
</style>
